+using Mac = std::array<std::uint8_t, 6>;
+using GroupName = std::array<char, 8>;
+using Product = std::array<char, 9>;
+
+inline constexpr Mac broadcast_mac{0xffU, 0xffU, 0xffU, 0xffU, 0xffU, 0xffU};
+
+const Settings& settings();
+// Whether there is a server to play through (the PSP's wireless switch on).
+bool enabled();
+
+// The relay's ports are the game's plus 10000, as PPSSPP's and aemu's are by default: the relay
+// only matches addresses and ports, so all players have to add the same.
+std::uint16_t relay_port(std::uint16_t game_port);
+std::uint16_t game_port(std::uint16_t relay_port);
+
+// The relay's address (the server's, port 27313), once the adhocctl session has found the server.
+std::optional<aemu_postoffice_sock_addr> relay_address();
+
+// sceNetAdhocctl's states and the events its handlers are called with.
+enum class State : std::int32_t { disconnected = 0, connected = 1, scanning = 2 };
+enum class Event : std::uint32_t { error = 0, connected = 1, disconnected = 2, scanned = 3 };
+
+struct Group {
+  GroupName name{};
+  Mac leader{};
+};
+
+struct Peer {
+  Mac mac{};
+  std::string nickname;
+  std::uint32_t id{};  // the server's number for it
+};
+
+// The session with the server's adhocctl service, kept on its own thread: it logs in (again after
+// losing the server), sends what the game asks for, and takes in groups, peers and replies.
+class Control {
+ public:
+  ~Control();
+
+  // Starts the session for the game with this product code (its disc ID), or does nothing if
+  // it's running.
+  void start(const Product& product);
+  void stop();
+
+  // Asks for the groups (State::scanning until they're in); false unless disconnected.
+  bool scan();
+  // Joins the group, made if no one is in it; false unless disconnected.
+  bool connect(const GroupName& group);
+  void disconnect();
+
+  State state() const;
+  // Whether the session has reached the server (and hasn't lost it since).
+  bool online() const;
+  GroupName group() const;
+  std::vector<Group> groups() const;
+  std::vector<Peer> peers() const;
+
+  // Events for the game's handlers: waits up to `timeout` for some.
+  std::vector<Event> wait_events(std::chrono::milliseconds timeout);
+
+ private:
+  enum class Request { scan, connect, disconnect };
+
+  void run(std::stop_token stop);
+  void post(Event event);
+
+  mutable std::mutex mutex_;
+  std::condition_variable events_changed_;
+  std::jthread thread_;
+  Product product_{};
+  State state_{State::disconnected};
+  bool online_{};
+  GroupName group_{};
+  std::deque<std::pair<Request, GroupName>> requests_;
+  std::vector<Group> groups_;
+  std::vector<Peer> peers_;
+  std::vector<Event> events_;
+};
+
+Control& control();
+
+}  // namespace refract::adhoc
