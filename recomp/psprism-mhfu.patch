+#pragma once
+
+// The host's side of the PSP's ad hoc network (refract/adhoc.hpp): the settings, the server's
+// address, and the session with its adhocctl service, which finds groups and the players in them.
+// The game's calls (stubs/net) use it; it knows nothing of the game's memory.
+
+#include <refract/adhoc.hpp>
+
+#include <array>
+#include <chrono>
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
