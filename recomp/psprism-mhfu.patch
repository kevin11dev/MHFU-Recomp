+{
+	SceNetAdhocctlPacketBase base;
+	char message[64];
+} SceNetAdhocctlChatPacketC2S;
+
+// S2C Connect Packet
+typedef struct
+{
+	SceNetAdhocctlPacketBase base;
+	SceNetAdhocctlNickname name;
+	SceNetEtherAddr mac;
+	uint32_t ip;
+} SceNetAdhocctlConnectPacketS2C;
+
