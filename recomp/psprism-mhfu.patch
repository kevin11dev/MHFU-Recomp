diff --git a/refract/src/host/vulkan_shaders/window.vert b/refract/src/host/vulkan_shaders/window.vert
new file mode 100644
index 0000000..4d33a96
--- /dev/null
+++ b/refract/src/host/vulkan_shaders/window.vert
@@ -0,0 +1,14 @@
+#version 450
+// A picture over a rectangle of the window: the game's, or a canvas. The rectangle's top left
+// is the image's; `rotation` turns it as the screen is turned (Android's pre-rotation).
+layout(push_constant) uniform Window {
+  vec4 uv_scale;
+  vec4 rotation;
+} u;
+layout(location = 0) out vec2 v_uv;
+void main() {
+  const vec2 positions[3] = vec2[3](vec2(-1.0, -1.0), vec2(-1.0, 3.0), vec2(3.0, -1.0));
+  vec2 p = positions[gl_VertexIndex];
+  v_uv = (p * 0.5 + 0.5) * u.uv_scale.xy;
+  gl_Position = vec4(u.rotation.x * p.x + u.rotation.y * p.y, u.rotation.z * p.x + u.rotation.w * p.y, 0.0, 1.0);
+}
diff --git a/refract/src/net/adhoc_control.cpp b/refract/src/net/adhoc_control.cpp
new file mode 100644
index 0000000..a7f1339
--- /dev/null
+++ b/refract/src/net/adhoc_control.cpp
@@ -0,0 +1,434 @@
+#include "adhoc_control.hpp"
+
+#include "../../third_party/aemu_postoffice/adhocctl/client/adhocctl.h"
+#include "../../third_party/aemu_postoffice/client/postoffice_client.h"
+
+#if defined(_WIN32)
+#include <winsock2.h>
+#include <ws2tcpip.h>
+#else
+#include <fcntl.h>
+#include <netdb.h>
+#include <netinet/in.h>
+#include <sys/select.h>
+#include <sys/socket.h>
+#include <unistd.h>
+#endif
+
+#include <algorithm>
+#include <cstdarg>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <utility>
+
+// The aemu_postoffice clients' log (log_impl.h): their messages only with REFRACT_ADHOC_LOG, as
+// a lost connection is reported once here instead.
+static int adhoc_client_log(const char* format, ...) {
+  if (std::getenv("REFRACT_ADHOC_LOG") == nullptr) return 0;
+  va_list arguments;
+  va_start(arguments, format);
+  const int written = std::vfprintf(stderr, format, arguments);
+  va_end(arguments);
+  return written;
+}
+extern "C" {
+int (*log_func)(const char* format, ...) = adhoc_client_log;
+}
+
+namespace refract::adhoc {
+namespace {
+
+constexpr std::uint16_t adhocctl_port = 27312;
+constexpr std::uint16_t relay_server_port = 27313;
+constexpr std::uint16_t port_offset = 10000;
+constexpr auto retry_interval = std::chrono::seconds(5);
+constexpr auto ping_interval = std::chrono::seconds(1);
+constexpr auto poll_interval = std::chrono::milliseconds(10);
+
+Settings configured;
+std::mutex address_mutex;
+std::optional<aemu_postoffice_sock_addr> relay;
+
+bool logging() {
+  static const bool on = std::getenv("REFRACT_ADHOC_LOG") != nullptr;
+  return on;
+}
+
+std::string mac_text(const std::uint8_t* mac) {
+  char text[18];
+  std::snprintf(text, sizeof(text), "%02x:%02x:%02x:%02x:%02x:%02x", mac[0], mac[1], mac[2], mac[3],
+                mac[4], mac[5]);
+  return text;
+}
+
+std::string group_text(const GroupName& group) {
+  return std::string(group.data(), strnlen(group.data(), group.size()));
+}
+
+// The server's IPv4 address (network order), or nothing if the name doesn't resolve.
+std::optional<std::uint32_t> resolve(const std::string& host) {
+#if defined(_WIN32)
+  static const bool winsock = [] {
+    WSADATA data;
+    return WSAStartup(MAKEWORD(2, 2), &data) == 0;
+  }();
+  if (!winsock) return std::nullopt;
+#endif
+  addrinfo hints{};
+  hints.ai_family = AF_INET;
+  hints.ai_socktype = SOCK_STREAM;
+  addrinfo* found = nullptr;
+  if (getaddrinfo(host.c_str(), nullptr, &hints, &found) != 0 || found == nullptr) return std::nullopt;
+  const auto address = reinterpret_cast<const sockaddr_in*>(found->ai_addr)->sin_addr.s_addr;
+  freeaddrinfo(found);
+  return address;
+}
+
+}  // namespace
+
+void configure(const Settings& settings) {
+  configured = settings;
+  if (configured.nickname.empty()) configured.nickname = "Hunter";
+  if (std::all_of(configured.mac.begin(), configured.mac.end(), [](auto byte) { return byte == 0U; })) {
+    // No address given: one for this run, locally administered and not a group address.
+    for (auto& byte : configured.mac) byte = static_cast<std::uint8_t>(std::rand());
+    configured.mac[0] = static_cast<std::uint8_t>((configured.mac[0] & 0xfcU) | 0x02U);
+  }
+}
+
+const Settings& settings() { return configured; }
+
+bool server_answers(const std::string& host, std::chrono::milliseconds timeout) {
+  const auto address = resolve(host);
+  if (!address) return false;
+#if defined(_WIN32)
+  const SOCKET sock = socket(AF_INET, SOCK_STREAM, IPPROTO_TCP);
+  if (sock == INVALID_SOCKET) return false;
+  u_long nonblocking = 1;
+  ioctlsocket(sock, FIONBIO, &nonblocking);
+#else
+  const int sock = socket(AF_INET, SOCK_STREAM, 0);
+  if (sock < 0) return false;
+  fcntl(sock, F_SETFL, fcntl(sock, F_GETFL, 0) | O_NONBLOCK);
+#endif
+  sockaddr_in server{};
+  server.sin_family = AF_INET;
+  server.sin_addr.s_addr = *address;
+  server.sin_port = htons(adhocctl_port);
+  bool answered = connect(sock, reinterpret_cast<const sockaddr*>(&server), sizeof(server)) == 0;
+  if (!answered) {
+    // Connecting: done when the socket is writable (Windows reports a failure as an exception).
+    fd_set writable;
+    fd_set failed;
+    FD_ZERO(&writable);
+    FD_ZERO(&failed);
+    FD_SET(sock, &writable);
+    FD_SET(sock, &failed);
+    timeval wait{static_cast<long>(timeout.count() / 1000), static_cast<long>(timeout.count() % 1000 * 1000)};
+    if (select(static_cast<int>(sock) + 1, nullptr, &writable, &failed, &wait) > 0 && FD_ISSET(sock, &writable)) {
+      int error = 0;
+      socklen_t length = sizeof(error);
+      answered = getsockopt(sock, SOL_SOCKET, SO_ERROR, reinterpret_cast<char*>(&error), &length) == 0 && error == 0;
+    }
+  }
+#if defined(_WIN32)
+  closesocket(sock);
+#else
+  close(sock);
+#endif
+  return answered;
+}
+
+bool enabled() { return !configured.server.empty(); }
+
+std::uint16_t relay_port(std::uint16_t game_port) {
+  if (game_port == 0U) return 0U;
+  const auto port = static_cast<std::uint16_t>(game_port + port_offset);
+  return port == 0U ? 65535U : port;
+}
+
+std::uint16_t game_port(std::uint16_t relay_port) {
+  return static_cast<std::uint16_t>(relay_port - port_offset);
+}
+
+std::optional<aemu_postoffice_sock_addr> relay_address() {
+  std::lock_guard lock(address_mutex);
+  return relay;
+}
+
+Control::~Control() { stop(); }
+
+void Control::start(const Product& product) {
+  std::lock_guard lock(mutex_);
+  if (thread_.joinable()) return;
+  product_ = product;
+  state_ = State::disconnected;
+  requests_.clear();
+  groups_.clear();
+  peers_.clear();
+  events_.clear();
+  thread_ = std::jthread([this](std::stop_token stop) { run(stop); });
+}
+
+void Control::stop() {
+  std::jthread thread;
+  {
+    std::lock_guard lock(mutex_);
+    thread = std::move(thread_);
+  }
+  if (thread.joinable()) {
+    thread.request_stop();
+    thread.join();
+  }
+  std::lock_guard lock(mutex_);
+  state_ = State::disconnected;
+  online_ = false;
+  peers_.clear();
+}
+
+bool Control::scan() {
+  std::lock_guard lock(mutex_);
+  if (state_ != State::disconnected) return false;
+  state_ = State::scanning;
+  groups_.clear();
+  requests_.push_back({Request::scan, {}});
+  return true;
+}
+
+bool Control::connect(const GroupName& group) {
+  std::lock_guard lock(mutex_);
+  if (state_ != State::disconnected) return false;
+  group_ = group;
+  requests_.push_back({Request::connect, group});
+  return true;
+}
+
+void Control::disconnect() {
+  std::lock_guard lock(mutex_);
+  requests_.push_back({Request::disconnect, {}});
+}
+
+State Control::state() const {
+  std::lock_guard lock(mutex_);
+  return state_;
+}
+
+bool Control::online() const {
+  std::lock_guard lock(mutex_);
+  return online_;
+}
+
+GroupName Control::group() const {
+  std::lock_guard lock(mutex_);
+  return group_;
+}
+
+std::vector<Group> Control::groups() const {
+  std::lock_guard lock(mutex_);
+  return groups_;
+}
+
+std::vector<Peer> Control::peers() const {
+  std::lock_guard lock(mutex_);
+  return peers_;
+}
+
+std::vector<Event> Control::wait_events(std::chrono::milliseconds timeout) {
+  std::unique_lock lock(mutex_);
+  events_changed_.wait_for(lock, timeout, [&] { return !events_.empty(); });
+  return std::exchange(events_, {});
+}
+
+void Control::post(Event event) {
+  events_.push_back(event);
+  events_changed_.notify_all();
+}
+
+void Control::run(std::stop_token stop) {
+  const auto& own = settings();
+  char nickname[128]{};
+  std::strncpy(nickname, own.nickname.c_str(), sizeof(nickname) - 1U);
+  const auto mac = reinterpret_cast<const char*>(own.mac.data());
+  void* session = nullptr;
+  bool connecting = false;
+  bool reported = false;
+  auto next_attempt = std::chrono::steady_clock::now();
+  auto last_ping = next_attempt;
+
+  // Lost or never had the server: whatever the game was waiting for ends.
+  const auto lose = [&] {
+    if (session != nullptr) destroy_adhocctl_session(session);
+    session = nullptr;
+    connecting = false;
+    next_attempt = std::chrono::steady_clock::now() + std::chrono::seconds(1);
+    std::lock_guard lock(mutex_);
+    online_ = false;
+    requests_.clear();
+    peers_.clear();
+    if (state_ == State::scanning) post(Event::scanned);
+    if (state_ == State::connected) post(Event::disconnected);
+    state_ = State::disconnected;
+  };
+
+  while (!stop.stop_requested()) {
+    const auto now = std::chrono::steady_clock::now();
+    if (session == nullptr) {
+      if (now >= next_attempt) {
+        const auto address = resolve(own.server);
+        if (address) {
+          const adhocctl_addr_v4 server{*address, htons(adhocctl_port)};
+          session = create_adhocctl_v1_session_v4(&server, nullptr, product_.data(), nickname, mac, false);
+        }
+        if (session != nullptr) {
+          {
+            std::lock_guard lock(address_mutex);
+            relay = aemu_postoffice_sock_addr{*address, htons(relay_server_port)};
+          }
+          std::fprintf(stderr, "[adhoc] connected to %s as %s (%s)\n", own.server.c_str(), own.nickname.c_str(),
+                       mac_text(own.mac.data()).c_str());
+          reported = false;
+          last_ping = now;
+          std::lock_guard lock(mutex_);
+          online_ = true;
+        } else {
+          if (!reported)
+            std::fprintf(stderr, "[adhoc] can't reach the server %s, trying again every %d s\n", own.server.c_str(),
+                         static_cast<int>(retry_interval.count()));
+          reported = true;
+          next_attempt = now + retry_interval;
+          // Nothing the game asks for can be done meanwhile.
+          std::lock_guard lock(mutex_);
+          requests_.clear();
+          if (state_ == State::scanning) {
+            state_ = State::disconnected;
+            post(Event::scanned);
+          }
+        }
+      }
+      std::this_thread::sleep_for(std::chrono::milliseconds(50));
+      continue;
+    }
+
+    // What the game asked for, in order.
+    for (;;) {
+      std::pair<Request, GroupName> request;
+      {
+        std::lock_guard lock(mutex_);
+        if (requests_.empty()) break;
+        request = requests_.front();
+      }
+      adhocctl_call_status status{};
+      switch (request.first) {
+        case Request::scan:
+          status = adhocctl_scan(session);
+          break;
+        case Request::connect:
+          status = adhocctl_connect(session, request.second.data());
+          break;
+        case Request::disconnect:
+          status = adhocctl_disconnect(session);
+          break;
+      }
+      if (status == ADHOCCTL_CALL_WOULDBLOCK) break;  // the send buffer is full: next time
+      if (status == ADHOCCTL_CALL_ERROR) {
+        lose();
+        break;
+      }
+      std::lock_guard lock(mutex_);
