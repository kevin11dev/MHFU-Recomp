diff --git a/refract/src/stubs/font/sceFontGetCharGlyphImage.cpp b/refract/src/stubs/font/sceFontGetCharGlyphImage.cpp
new file mode 100644
index 0000000..02859d7
--- /dev/null
+++ b/refract/src/stubs/font/sceFontGetCharGlyphImage.cpp
@@ -0,0 +1,62 @@
+#include "font_state.hpp"
+
+// (font handle, character code, GlyphImage* image): draws the glyph with its top-left
+// corner at (xPos64 >> 6, yPos64 >> 6), adding to what the buffer holds (saturating).
+// Like the hardware, only the 4 bpp and 8 bpp formats are drawn.
+void sceFontGetCharGlyphImage(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  (void)implementation;
+  int index{};
+  std::uint32_t alt_character{font_state::default_alt_character};
+  {
+    std::lock_guard lock(font_state::mutex);
+    const auto found = font_state::fonts.find(state.gpr[4]);
+    if (found == font_state::fonts.end()) {
+      state.gpr[2] = font_state::error_invalid_parameter;
+      return;
+    }
+    index = found->second.index;
+    if (const auto library = font_state::libraries.find(found->second.library);
+        library != font_state::libraries.end())
+      alt_character = library->second.alt_character;
+  }
+  const auto* image_pointer = guest_pointer<::refract::font::GlyphImage>(state, state.gpr[6]);
+  if (image_pointer == nullptr) {
+    state.gpr[2] = font_state::error_invalid_parameter;
+    return;
+  }
+  ::refract::font::GlyphImage image{};
+  std::memcpy(&image, image_pointer, sizeof(image));
+  state.gpr[2] = 0U;
+  if (image.pixel_format != 0U && image.pixel_format != 2U) return;
+  const auto* glyph = ::refract::font::glyph(index, state.gpr[5] & 0xffffU, alt_character);
+  if (glyph == nullptr) return;
+  const int left = image.x_pos64 >> 6;
+  const int top = image.y_pos64 >> 6;
+  for (int y = 0; y < glyph->height; ++y) {
+    const int row = top + y;
+    if (row < 0 || row >= image.buffer_height) continue;
+    for (int x = 0; x < glyph->width; ++x) {
+      const int column = left + x;
+      const auto value = glyph->pixels[static_cast<std::size_t>(y * glyph->width + x)];
+      if (column < 0 || column >= image.buffer_width || value == 0U) continue;
+      const auto offset = static_cast<std::uint32_t>(row) * image.bytes_per_line +
+                          (image.pixel_format == 0U ? static_cast<std::uint32_t>(column) / 2U
+                                                    : static_cast<std::uint32_t>(column));
+      auto* pixel = guest_pointer<std::uint8_t>(state, image.buffer_address + offset);
+      if (pixel == nullptr) continue;
+      if (image.pixel_format == 0U) {
+        const unsigned shift = (column & 1) != 0 ? 4U : 0U;
+        const unsigned old_value = (*pixel >> shift) & 0xfU;
+        const unsigned new_value = std::min(old_value + value, 15U);
+        *pixel = static_cast<std::uint8_t>((*pixel & ~(0xfU << shift)) | (new_value << shift));
+      } else {
+        *pixel = static_cast<std::uint8_t>(std::min(*pixel + value * 17U, 255U));
+      }
+    }
+  }
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
