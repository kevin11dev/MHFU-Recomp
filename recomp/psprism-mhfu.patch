+// Smooth motion: frames that come a few milliseconds early or late are still moved through
+// evenly, and the timeline starts over after a pause.
+int frame_pacer_tests() {
+  using Clock = refract::host::FramePacer::Clock;
+  const auto at = [](double milliseconds) {
+    return Clock::time_point{} + std::chrono::hours(1) +
+           std::chrono::duration_cast<Clock::duration>(
+               std::chrono::duration<double, std::milli>(milliseconds));
+  };
+  refract::host::FramePacer first;
+  CHECK(!first.frame(at(0.0)));  // nothing to move from yet
+  CHECK(first.progress(at(10.0)) == 1.0F);
+  CHECK(first.frame(at(33.4)));
+  CHECK(first.progress(at(33.4)) == 0.0F);
+  CHECK(std::fabs(first.progress(at(50.1)) - 0.5F) < 0.01F);
+  CHECK(first.progress(at(80.0)) == 1.0F);
+  CHECK(!first.frame(at(1000.0)));  // after a pause, no pair to move between
+
+  // 30 fps with +-4 ms of jitter, shown at 60 Hz: each picture moves about half a frame.
+  refract::host::FramePacer pacer;
+  constexpr double jitter[] = {3.1, -2.4, 0.7, -3.9, 2.2, -0.8, 3.8, -1.6, 1.3, -3.0};
+  double arrival[600];
+  for (int frame = 0; frame < 600; ++frame)
+    arrival[frame] = 100.0 + frame * (1000.0 / 29.97) + jitter[frame % 10];
+  int next = 0;
+  int frame = -1;
+  double previous = -1.0;
+  double worst = 0.0;
+  for (double tick = 200.0; tick < 19000.0; tick += 1000.0 / 60.0) {
+    while (next < 600 && arrival[next] <= tick) {
+      pacer.frame(at(arrival[next]));
+      frame = next++;
+    }
+    const double shown = frame - 1 + pacer.progress(at(tick));
+    if (previous >= 0.0 && tick > 1000.0)
+      worst = std::max(worst, std::fabs(shown - previous - 29.97 / 60.0));
+    previous = shown;
+  }
+  CHECK(worst < 0.15);
+  return 0;
+}
