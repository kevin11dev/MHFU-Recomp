+    "ABCDEFGHIJKLM", "NOPQRSTUVWXYZ", "abcdefghijklm", "nopqrstuvwxyz", "0123456789-.'"};
+// The bottom row has three wide keys, each covering a run of columns.
+struct OskWideKey {
+  const char* label;
+  int first_column;
+  int columns;
