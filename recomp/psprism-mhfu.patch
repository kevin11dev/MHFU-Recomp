+  void draw_settings() {
+    draw_page_title("Settings");
+    // Where each line is, from the list's top, and the scroll that keeps the chosen choice in view.
+    std::vector<float> tops;
+    float height = 0.0F;
+    for (const auto& line : lines_) {
+      tops.push_back(height);
+      height += line.heading ? heading_height : row_height;
+    }
+    const auto view = list_bottom - list_top;
+    if (keep_in_view_) {
+      for (std::size_t i = 0; i < lines_.size(); ++i) {
+        if (lines_[i].heading || lines_[i].choice != choice_) continue;
+        // With its heading, if it's the first under one.
+        const auto top = i > 0U && lines_[i - 1U].heading ? tops[i - 1U] : tops[i];
+        if (top < scroll_) scroll_ = top;
+        if (tops[i] + row_height > scroll_ + view) scroll_ = tops[i] + row_height - view;
+      }
+      keep_in_view_ = false;
+    }
+    scroll_ = std::clamp(scroll_, 0.0F, std::max(height - view, 0.0F));
+    for (std::size_t i = 0; i < lines_.size(); ++i) {
+      const auto top = list_top + tops[i] - scroll_;
+      const auto line_height = lines_[i].heading ? heading_height : row_height;
+      if (top < list_top - 0.5F || top + line_height > list_bottom + 0.5F) continue;
+      const auto& choice = choices_[lines_[i].choice];
+      if (lines_[i].heading) {
+        text(canvas, panel_left + 28.0F, top + 21.0F, 15.0F, capitals(choice.section), gold_dim, UiFace::display);
