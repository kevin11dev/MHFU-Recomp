+// Scripted input --------------------------------------------------------------
+
+struct InputStep {
+  std::uint64_t frame{};
+  std::uint32_t buttons{};
+  std::uint64_t length{};
+};
+
+// Typed text for testing the on-screen keyboard: "FRAME:'text" in the script.
+struct TextStep {
+  std::uint64_t frame{};
+  std::string text;
+  bool sent{};
+};
+std::vector<TextStep> scripted_text;
+
+std::vector<InputStep> parse_input_script(const char* variable = "REFRACT_INPUT_SCRIPT",
+                                         std::vector<TextStep>* text_steps = &scripted_text) {
+  std::vector<InputStep> steps;
+  const auto* script = std::getenv(variable);
+  if (script == nullptr) return steps;
+  const std::string text = script;
+  std::size_t start = 0;
+  while (start < text.size()) {
+    auto end = text.find(',', start);
+    if (end == std::string::npos) end = text.size();
+    const auto item = text.substr(start, end - start);
+    char* cursor = nullptr;
+    InputStep step{};
+    step.frame = std::strtoull(item.c_str(), &cursor, 10);
+    if (cursor != nullptr && cursor[0] == ':' && cursor[1] == '\'') {
+      if (text_steps != nullptr) text_steps->push_back({step.frame, std::string(cursor + 2), false});
+    } else if (cursor != nullptr && *cursor == ':') {
+      step.buttons = static_cast<std::uint32_t>(std::strtoul(cursor + 1, &cursor, 16));
+      step.length = 5U;
+      if (cursor != nullptr && *cursor == ':') step.length = std::strtoull(cursor + 1, nullptr, 10);
+      steps.push_back(step);
+    }
+    start = end + 1U;
+  }
+  return steps;
+}
+
+std::uint32_t scripted_buttons(std::uint64_t frame) {
+  static const auto steps = parse_input_script();
+  std::uint32_t buttons{};
+  for (const auto& step : steps)
+    if (frame >= step.frame && frame < step.frame + step.length) buttons |= step.buttons;
+  return buttons;
+}
+
+// Keyboard and controller -----------------------------------------------------
+
+void update_mask(std::atomic_uint32_t& state, std::uint32_t mask, bool pressed) {
+  if (pressed) state.fetch_or(mask, std::memory_order_relaxed);
+  else state.fetch_and(~mask, std::memory_order_relaxed);
+}
+
+void update_button(std::uint32_t mask, bool pressed) {
+  update_mask(keyboard_buttons, mask, pressed);
+  if (pressed) keyboard_latched_buttons.fetch_or(mask, std::memory_order_relaxed);
+}
+
+void handle_key(SDL_Keycode key, bool pressed) {
+  switch (key) {
+    case SDLK_UP: update_button(psp_up, pressed); break;
+    case SDLK_RIGHT: update_button(psp_right, pressed); break;
+    case SDLK_DOWN: update_button(psp_down, pressed); break;
+    case SDLK_LEFT: update_button(psp_left, pressed); break;
+    case SDLK_q: update_button(psp_l, pressed); break;
+    case SDLK_e: update_button(psp_r, pressed); break;
+    case SDLK_i: update_button(psp_triangle, pressed); break;
+    case SDLK_l: update_button(psp_circle, pressed); break;
+    case SDLK_k: update_button(psp_cross, pressed); break;
+    case SDLK_j: update_button(psp_square, pressed); break;
+    case SDLK_RETURN: update_button(psp_start, pressed); break;
+    case SDLK_RSHIFT: update_button(psp_select, pressed); break;
+    case SDLK_a: update_mask(keyboard_analog_directions, analog_left, pressed); break;
+    case SDLK_d: update_mask(keyboard_analog_directions, analog_right, pressed); break;
+    case SDLK_w: update_mask(keyboard_analog_directions, analog_up, pressed); break;
+    case SDLK_s: update_mask(keyboard_analog_directions, analog_down, pressed); break;
+    default: break;
+  }
+}
+
+SDL_GameController* game_controller{};
+
+void poll_controller() {
+  if (game_controller == nullptr) return;
+  struct Mapping {
+    SDL_GameControllerButton button;
+    std::uint32_t mask;
+  };
+  constexpr Mapping mappings[] = {
+      {SDL_CONTROLLER_BUTTON_DPAD_UP, psp_up},
+      {SDL_CONTROLLER_BUTTON_DPAD_RIGHT, psp_right},
+      {SDL_CONTROLLER_BUTTON_DPAD_DOWN, psp_down},
+      {SDL_CONTROLLER_BUTTON_DPAD_LEFT, psp_left},
+      {SDL_CONTROLLER_BUTTON_LEFTSHOULDER, psp_l},
+      {SDL_CONTROLLER_BUTTON_RIGHTSHOULDER, psp_r},
+      {SDL_CONTROLLER_BUTTON_Y, psp_triangle},
+      {SDL_CONTROLLER_BUTTON_B, psp_circle},
+      {SDL_CONTROLLER_BUTTON_A, psp_cross},
+      {SDL_CONTROLLER_BUTTON_X, psp_square},
+      {SDL_CONTROLLER_BUTTON_START, psp_start},
+      {SDL_CONTROLLER_BUTTON_BACK, psp_select},
+  };
+  std::uint32_t buttons{};
+  for (const auto& mapping : mappings)
+    if (SDL_GameControllerGetButton(game_controller, mapping.button) != 0U) buttons |= mapping.mask;
+  controller_buttons.store(buttons, std::memory_order_relaxed);
+  const auto axis = [](int value) {
+    constexpr int deadzone = 8000;
+    if (std::abs(value) < deadzone) return 128;
+    return std::clamp(128 + value / 256, 0, 255);
+  };
+  const auto x = axis(SDL_GameControllerGetAxis(game_controller, SDL_CONTROLLER_AXIS_LEFTX));
+  const auto y = axis(SDL_GameControllerGetAxis(game_controller, SDL_CONTROLLER_AXIS_LEFTY));
+  controller_analog.store(static_cast<std::uint32_t>(x | (y << 8)), std::memory_order_relaxed);
+  // The right stick, with a round dead zone: the rest of the range starts from zero.
+  const auto right_x = SDL_GameControllerGetAxis(game_controller, SDL_CONTROLLER_AXIS_RIGHTX) / 32767.0F;
+  const auto right_y = SDL_GameControllerGetAxis(game_controller, SDL_CONTROLLER_AXIS_RIGHTY) / 32767.0F;
+  const auto length = std::min(std::hypot(right_x, right_y), 1.0F);
+  constexpr float dead_zone = 0.2F;
+  const auto scale = length <= dead_zone ? 0.0F : (length - dead_zone) / (1.0F - dead_zone) / length;
+  const auto packed = [](float value) {
+    return static_cast<std::uint16_t>(static_cast<std::int16_t>(std::clamp(value, -1.0F, 1.0F) * 32767.0F));
+  };
+  controller_right_stick.store(packed(right_x * scale) | static_cast<std::uint32_t>(packed(right_y * scale)) << 16U,
+                               std::memory_order_relaxed);
+}
+
+// Audio: SDL pulls mixed samples from the shared engine ------------------------
+
+struct AudioOutput {
+  AudioEngine engine;
+  std::mutex configuration_mutex;
+  SDL_AudioDeviceID device{};
+  bool shut_down{};  // at exit: game threads still sending sound don't open the device again
+};
+
+AudioOutput& audio_output() {
+  static AudioOutput value;
+  return value;
+}
+
+// REFRACT_AUDIO_WAV=FILE records what the audio device plays, for testing without speakers.
+std::FILE* open_audio_recording() {
+  const auto* path = std::getenv("REFRACT_AUDIO_WAV");
+  if (path == nullptr) return nullptr;
+  auto* file = std::fopen(path, "wb");
+  if (file == nullptr) return nullptr;
+  // A canonical 44-byte header; the sizes are patched as the recording grows.
+  const std::uint8_t header[44] = {'R', 'I', 'F', 'F', 0, 0, 0, 0, 'W', 'A', 'V', 'E', 'f', 'm', 't', ' ',
+                                   16, 0, 0, 0, 1, 0, 2, 0, 0x44, 0xac, 0, 0, 0x10, 0xb1, 2, 0,
+                                   4, 0, 16, 0, 'd', 'a', 't', 'a', 0, 0, 0, 0};
+  std::fwrite(header, 1, sizeof(header), file);
+  return file;
+}
+
+void record_audio(const std::uint8_t* samples, int length) {
+  static auto* file = open_audio_recording();
+  static std::uint32_t recorded{};
+  if (file == nullptr || length <= 0) return;
+  std::fwrite(samples, 1, static_cast<std::size_t>(length), file);
+  recorded += static_cast<std::uint32_t>(length);
+  const auto patch = [&](long offset, std::uint32_t value) {
+    const std::uint8_t bytes[4] = {static_cast<std::uint8_t>(value), static_cast<std::uint8_t>(value >> 8U),
+                                   static_cast<std::uint8_t>(value >> 16U), static_cast<std::uint8_t>(value >> 24U)};
+    std::fseek(file, offset, SEEK_SET);
+    std::fwrite(bytes, 1, 4, file);
+  };
+  patch(4, recorded + 36U);
+  patch(40, recorded);
+  std::fseek(file, 0, SEEK_END);
+  std::fflush(file);
+}
+
+void audio_callback(void* user_data, Uint8* stream, int length) {
+  auto& output = *static_cast<AudioOutput*>(user_data);
+  output.engine.consume(reinterpret_cast<std::int16_t*>(stream),
+                        static_cast<std::uint32_t>(length) / 4U);
+  record_audio(stream, length);
+}
+
+bool start_audio(AudioOutput& output) {
+  std::lock_guard lock(output.configuration_mutex);
+  if (output.device != 0U) return true;
+  if (output.shut_down) return false;
+  if (SDL_WasInit(SDL_INIT_AUDIO) == 0U && SDL_InitSubSystem(SDL_INIT_AUDIO) != 0) return false;
+  SDL_AudioSpec desired{};
+  desired.freq = static_cast<int>(host_audio_sample_rate);
+  desired.format = AUDIO_S16SYS;
+  desired.channels = 2U;
+  desired.samples = 512U;
+  desired.callback = audio_callback;
+  desired.userdata = &output;
+  output.device = SDL_OpenAudioDevice(nullptr, 0, &desired, nullptr, 0);
+  if (output.device == 0U) {
+    std::fprintf(stderr, "refract: cannot open audio device: %s\n", SDL_GetError());
+    return false;
+  }
+  // Guest threads take turns on one emulated CPU, so the sound thread can be
+  // late; about 46 ms of queued audio covers that without audible gaps.
+  output.engine.set_blocking_backlog(2048U);
+  SDL_PauseAudioDevice(output.device, 0);
+  return true;
+}
+
+std::uint32_t backend_queued_audio_frames(std::uint32_t channel) {
+  return audio_output().engine.queued_frames(channel);
+}
+void backend_reset_audio_channel(std::uint32_t channel) {
+  audio_output().engine.reset_channel(channel);
+}
+AudioTelemetry backend_audio_telemetry() { return audio_output().engine.telemetry(); }
+std::uint64_t backend_audio_clock_frames() { return audio_output().engine.clock_frames(); }
+
+// Renderer --------------------------------------------------------------------
+
+// width and height are in PSP pixels; a render target drawn at a higher resolution has `scale`
+// of the backend's pixels per PSP pixel.
+struct TextureResource {
+  gpu::Image* image{};
+  std::unique_ptr<gpu::Image> owned;  // an uploaded texture's (a render target's is the target's)
+  std::uint32_t width{};
+  std::uint32_t height{};
+  std::uint64_t generation{};
+  std::uint32_t scale{1U};
+  // Widescreen: PSP pixels added at each side of a full-size framebuffer; the game's x is at
+  // x + extra.
+  std::uint32_t extra{};
+};
+
+struct RenderTarget {
+  TextureResource color;
+  std::unique_ptr<gpu::Target> target;
+  std::uint32_t stride{};
+  std::uint32_t format{};
+};
+
+class Renderer {
+public:
+  explicit Renderer(gpu::Backend& gpu) : gpu_(gpu) {}
+
+  // Draws what the game drew since last time into the render targets. With smooth motion, it
+  // also keeps what each shown frame drew, for the frames in between.
+  void draw_new_geometry() {
+    std::vector<GeometryBatch> batches;
+    std::vector<FlipMark> flips;
+    {
+      std::lock_guard lock(geometry_mutex);
+      batches.swap(presented_geometry_batches);
+      flips.swap(presented_flips);
+      undrawn_flips = 0U;
+    }
+    geometry_taken.notify_all();
+    draw_geometry(batches);
+    if (!flips.empty()) shown_address_ = flips.back().address;
+    if (smooth_motion.load(std::memory_order_relaxed)) collect_frames(batches, flips);
+  }
+
+  void draw(int window_width, int window_height) {
+    update_extra(window_width, window_height);
+    draw_new_geometry();
+    present(window_width, window_height, std::chrono::steady_clock::now());
+  }
+
+  // Shows the game's picture: its latest frame, or with smooth motion, the frame between the
+  // last two that is due at `now` (the picture runs one game frame behind to have both).
+  void present(int window_width, int window_height, std::chrono::steady_clock::time_point now) {
+    update_extra(window_width, window_height);
+    float alpha = 1.0F;
+    if (smooth_motion.load(std::memory_order_relaxed) && interpolating_ &&
+        !framebuffer_sources.cpu_is_latest(current_frame_.address))
+      alpha = pacer_.progress(now);
+    shown_alpha_ = alpha;
+    if (alpha < 0.999F) {
+      if (auto* target = smooth_target(current_frame_.address)) {
+        draw_geometry(blended_frame(alpha), target, current_frame_.address);
+        draw_display(window_width, window_height, &target->color);
+        return;
+      }
+    }
+    draw_display(window_width, window_height);
+  }
+
+  // Whether an in-between frame is still to be shown for the current pair of frames.
+  bool smoothing() const {
+    return smooth_motion.load(std::memory_order_relaxed) && interpolating_ && shown_alpha_ < 0.999F;
+  }
+
+  // Draws an RGBA canvas (top row first) over the picture: where the game is shown, or over the
+  // whole window.
+  void draw_overlay(int window_width, int window_height, const std::vector<std::uint8_t>& pixels,
+                    int width, int height, bool changed, std::size_t slot = 0U, bool whole_window = false) {
+    auto& overlay = overlay_textures_[slot];
+    const auto canvas_width = static_cast<std::uint32_t>(width);
+    const auto canvas_height = static_cast<std::uint32_t>(height);
+    if (overlay.image == nullptr || overlay.width != canvas_width || overlay.height != canvas_height)
+      overlay = create_texture(canvas_width, canvas_height, pixels.data());
+    else if (changed)
+      gpu_.update_image(*overlay.image, pixels.data());
+    gpu_.draw_overlay(whole_window ? gpu::Rect{0, 0, window_width, window_height}
+                                   : display_rect(window_width, window_height),
+                      *overlay.image);
+  }
+
+private:
+  // Widescreen: how many PSP pixels the game's full-size framebuffers get at each side to fill a
+  // window of this shape (0 when it's off, or the window isn't wider than 480:272).
+  void update_extra(int window_width, int window_height) {
+    extra_ = 0U;
+    if (!widescreen.load(std::memory_order_relaxed) || window_width <= 0 || window_height <= 0) return;
+    const auto wide = 272.0F * static_cast<float>(window_width) / static_cast<float>(window_height);
+    extra_ = static_cast<std::uint32_t>(std::lround(std::clamp((wide - 480.0F) * 0.5F, 0.0F, 240.0F)));
+  }
+
+  TextureResource create_texture(std::uint32_t width, std::uint32_t height,
+                                 const std::uint8_t* pixels, std::uint64_t generation = 0U) {
+    TextureResource result;
+    result.owned = gpu_.create_image(width, height, pixels);
+    result.image = result.owned.get();
+    result.width = width;
+    result.height = height;
+    result.generation = generation;
+    return result;
+  }
+
+  RenderTarget& ensure_render_target(std::uint32_t address, const GeometryBatch& batch) {
+    auto& target = render_targets_[address];
+    // Widescreen widens the game's full-size framebuffers (those it shows), not its smaller
+    // render targets (textures it draws).
+    const auto extra = batch.state.render_target_width >= 480U ? extra_ : 0U;
+    const auto width = std::max<std::uint32_t>(target.color.extra == extra ? target.color.width : 0U,
+                                               batch.state.render_target_width + 2U * extra);
+    const auto height = std::max<std::uint32_t>(target.color.height, batch.state.render_target_height);
+    if (target.target == nullptr || target.color.width < width || target.color.height < height ||
+        target.color.extra != extra) {
+      // Drawn at the chosen resolution, as far as the GPU's texture size allows.
+      const auto maximum_size = gpu_.max_texture_size();
+      auto scale = std::max<std::uint32_t>(1U, render_scale.load(std::memory_order_relaxed));
+      while (scale > 1U && std::max(width, height) * scale > maximum_size) --scale;
+      create_render_target(target, width, height, scale);
+      target.color.extra = extra;
+    }
+    target.stride = batch.state.render_target_stride;
+    target.format = batch.state.render_target_format;
+    return target;
+  }
+
+  void create_render_target(RenderTarget& target, std::uint32_t width, std::uint32_t height,
+                            std::uint32_t scale) {
+    target = {};  // the old one goes first
+    target.target = gpu_.create_target(width * scale, height * scale);
+    target.color.image = &target.target->color();
+    target.color.width = width;
+    target.color.height = height;
+    target.color.scale = scale;
+  }
+
+  TextureResource* uploaded_texture(const GeometryBatch& batch) {
+    if (batch.texture == nullptr || batch.texture->empty() || batch.texture_width == 0U ||
+        batch.texture_height == 0U)
+      return nullptr;
+    std::uint64_t key = batch.state.texture_address;
+    key ^= static_cast<std::uint64_t>(batch.texture_width) << 32U;
+    key ^= static_cast<std::uint64_t>(batch.texture_height) << 48U;
+    auto& texture = uploaded_textures_[key];
+    const bool hit = texture.image != nullptr && texture.generation == batch.state.texture_content_hash;
+    ge_cache_counters.record_texture(
+        hit, static_cast<std::uint64_t>(batch.texture_width) * batch.texture_height * 4U);
+    if (!hit) {
+      if (texture.image != nullptr && texture.width == batch.texture_width &&
+          texture.height == batch.texture_height) {
+        gpu_.update_image(*texture.image, batch.texture->data());
+        texture.generation = batch.state.texture_content_hash;
+      } else {
+        texture = create_texture(batch.texture_width, batch.texture_height, batch.texture->data(),
+                                 batch.state.texture_content_hash);
+      }
+    }
+    if (uploaded_textures_.size() > 2048U) {
+      uploaded_textures_.clear();
+      return nullptr;
+    }
+    return texture.image == nullptr ? nullptr : &texture;
+  }
+
+  // Draws batches into their render targets, or with `into`, only the batches drawn into
+  // into_address, into that target instead.
+  void draw_geometry(const std::vector<GeometryBatch>& batches, RenderTarget* into = nullptr,
+                     std::uint32_t into_address = 0U) {
+    std::vector<std::uint32_t> first_vertex(batches.size());
+    std::size_t vertex_count{};
+    for (std::size_t index = 0; index < batches.size(); ++index) {
+      first_vertex[index] = static_cast<std::uint32_t>(vertex_count);
+      vertex_count += batches[index].vertices.size();
+    }
+    if (vertex_count == 0U) return;
+    staging_.resize(vertex_count);
+    for (std::size_t index = 0; index < batches.size(); ++index)
+      std::copy(batches[index].vertices.begin(), batches[index].vertices.end(),
+                staging_.begin() + first_vertex[index]);
+    gpu_.set_vertices(staging_.data(), vertex_count);
+    const auto bytes = vertex_count * sizeof(GeometryVertex);
+    const bool reused = bytes <= vertex_capacity_;
+    if (!reused) vertex_capacity_ = std::max<std::size_t>(bytes, 4U << 20U);
+    ge_cache_counters.record_vertex_buffer(reused, static_cast<std::uint64_t>(bytes));
+
+    for (std::size_t batch_index = 0; batch_index < batches.size(); ++batch_index) {
+      const auto& batch = batches[batch_index];
+      if (batch.vertices.empty() || batch.type > 4U) continue;
+      const auto address = normalized_vram_address(batch.state.render_target_address);
+      if (into != nullptr && address != into_address) continue;
+      auto& target = into != nullptr ? *into : ensure_render_target(address, batch);
+      const auto scale = target.color.scale;
+
+      // A render target drawn earlier, as this draw's texture.
+      TextureResource* sampled{};
+      std::optional<RenderTargetAddressOffset> sampled_offset;
+      const auto texture_address = normalized_vram_address(batch.state.texture_address);
+      std::uint32_t closest_offset = std::numeric_limits<std::uint32_t>::max();
+      for (auto& [candidate_address, candidate] : render_targets_) {
+        // Sampling the target being drawn to is undefined.
+        if (&candidate == &target || (into != nullptr && candidate_address == into_address)) continue;
+        const auto offset = render_target_address_offset(
+            texture_address, candidate_address, candidate.stride, candidate.color.width,
+            candidate.color.height, candidate.format, batch.state.texture_format);
+        const auto byte_offset = texture_address - candidate_address;
+        if (!offset || byte_offset >= closest_offset || candidate.color.image == nullptr) continue;
+        closest_offset = byte_offset;
+        sampled = &candidate.color;
+        sampled_offset = offset;
+      }
+
+      // Widescreen. A widened framebuffer has extra pixels at each side: a draw into it is shifted
+      // by them, the game's 480 pixels in the middle and its 3D world carrying on at the sides; one
+      // that covers the game's whole width flat (a clear, a fade, a copy of the screen, a menu's
+      // background) is stretched across all of it, so nothing leaves bars at the sides. A widened
+      // screen sampled whole is sampled across all its width (squeezed into a texture that isn't
+      // widened; drawn back whole, that is stretched again).
+      bool whole_texture = false;  // the draw samples all of the game's width of a widened screen
+      if (sampled != nullptr && sampled_offset && sampled->extra > 0U) {
+        float low = std::numeric_limits<float>::max(), high = std::numeric_limits<float>::lowest();
+        for (const auto& vertex : batch.vertices) {
+          if (vertex.texture[2] == 0.0F) continue;
+          const auto u = vertex.texture[0] / vertex.texture[2] * static_cast<float>(batch.texture_width) +
+                         static_cast<float>(sampled_offset->x);
+          low = std::min(low, u);
+          high = std::max(high, u);
+        }
+        whole_texture = low <= 1.0F && high >= 479.0F;
+      }
+      bool flat_and_whole = false;  // the draw covers the game's whole width, flat
+      {
+        const auto half_width = static_cast<float>(batch.state.render_target_width) * 0.5F;
+        float low = std::numeric_limits<float>::max(), high = std::numeric_limits<float>::lowest();
+        bool flat = true;
+        for (const auto& vertex : batch.vertices) {
+          if (std::fabs(vertex.position[3] - 1.0F) > 1e-5F) {
+            flat = false;
+            break;
+          }
+          const auto x = (vertex.position[0] + 1.0F) * half_width;
+          low = std::min(low, x);
+          high = std::max(high, x);
+        }
+        flat_and_whole = flat && low <= 1.0F && high >= 479.0F;
+      }
+      const auto extra = static_cast<float>(target.color.extra);
+      const bool stretched = extra > 0.0F && flat_and_whole;
+
+      auto draw = draw_state(batch.state, batch.type);
+      if (sampled != nullptr && sampled_offset) {
+        // The game's pixel u of the texture is at u * spread + shift in the target.
+        const auto sampled_extra = static_cast<float>(sampled->extra);
+        const auto spread = whole_texture ? (480.0F + 2.0F * sampled_extra) / 480.0F : 1.0F;
+        const auto shift = whole_texture ? 0.0F : sampled_extra;
+        draw.texture_transform[0] = render_target_texture_scale(batch.texture_width, sampled->width) * spread;
+        draw.texture_transform[1] = render_target_texture_scale(batch.texture_height, sampled->height);
+        draw.texture_transform[2] = (static_cast<float>(sampled_offset->x) * spread + shift) / sampled->width;
+        draw.texture_transform[3] = static_cast<float>(sampled_offset->y) / sampled->height;
+      }
+      if (sampled == nullptr) sampled = uploaded_texture(batch);
+
+      auto left = batch.state.scissor_left, right = batch.state.scissor_right;
+      if (target.color.extra > 0U) {
+        if (stretched || (left == 0U && right >= 480U)) {
+          right = std::max(right, 480U) + 2U * target.color.extra;
+        } else {
+          left += target.color.extra;
+          right += target.color.extra;
+        }
+      }
+      left = std::min(left, target.color.width);
+      right = std::min(right, target.color.width);
+      const auto top = std::min(batch.state.scissor_top, target.color.height);
+      const auto bottom = std::min(batch.state.scissor_bottom, target.color.height);
+      if (right <= left || bottom <= top) continue;
+      draw.scissor[0] = static_cast<std::int32_t>(left * scale);
+      draw.scissor[1] = static_cast<std::int32_t>(top * scale);
+      draw.scissor[2] = static_cast<std::int32_t>((right - left) * scale);
+      draw.scissor[3] = static_cast<std::int32_t>((bottom - top) * scale);
+
+      // The draw's x from -1 to 1 spans its render_target_width (D) pixels; in the target (T
+      // pixels wide) its pixel p goes to p * spread + shift.
+      const auto scale_y = render_target_geometry_scale(batch.state.through_coordinates,
+                                                        batch.state.render_target_height, target.color.height);
+      if (extra > 0.0F) {
+        const auto drawn = static_cast<float>(batch.state.render_target_width);
+        const auto width = static_cast<float>(target.color.width);
+        const auto spread = stretched ? (480.0F + 2.0F * extra) / 480.0F : 1.0F;
+        const auto shift = stretched ? 0.0F : extra;
+        draw.target_scale[0] = drawn * spread / width;
+        draw.target_scale[2] = (drawn * spread + 2.0F * shift) / width - 1.0F;
+      } else {
+        const auto scale_x = render_target_geometry_scale(batch.state.through_coordinates,
+                                                          batch.state.render_target_width, target.color.width);
+        draw.target_scale[0] = scale_x;
+        draw.target_scale[2] = scale_x - 1.0F;
+      }
+      draw.target_scale[1] = scale_y;
+      const auto& state = batch.state;
+      draw.color_test[0] = state.color_test ? 1U : 0U;
+      draw.color_test[1] = state.color_function;
+      draw.color_test[2] = state.color_reference;
+      draw.color_test[3] = state.color_mask;
+      draw.alpha_test[0] = state.alpha_test ? 1U : 0U;
+      draw.alpha_test[1] = state.alpha_function;
+      draw.alpha_test[2] = state.alpha_reference;
+      draw.alpha_test[3] = state.alpha_mask;
+      draw.texture_state[0] = state.texture_function;
+      draw.texture_state[1] = state.texture_alpha_used ? 1U : 0U;
+      draw.texture_state[2] = state.texture_color_double ? 1U : 0U;
+      draw.texture_state[3] = state.texture_environment_color;
+      draw.misc[0] = state.render_target_format == 3U && (state.stencil_test || state.clear_stencil) &&
+                             state.stencil_write_mask == 0xffU
+                         ? (state.clear_stencil ? 2U : state.stencil_depth_pass)
+                         : 0U;
+      draw.misc[1] = state.stencil_reference & 0xffU;
+      draw.misc[2] = sampled == nullptr ? 0U : 1U;
+      if (sampled != nullptr) {
+        draw.texture = sampled->image;
+        draw.sampler = static_cast<std::uint8_t>((state.texture_min_linear ? 8U : 0U) |
+                                                 (state.texture_mag_linear ? 4U : 0U) |
+                                                 (state.texture_clamp_t ? 2U : 0U) |
+                                                 (state.texture_clamp_s ? 1U : 0U));
+      }
+      draw.first_vertex = first_vertex[batch_index];
+      draw.vertex_count = static_cast<std::uint32_t>(batch.vertices.size());
+      gpu_.draw(*target.target, draw);
+    }
+  }
+
+  TextureResource* display_texture(std::uint32_t address) {
+    if (framebuffer_sources.cpu_is_latest(address)) {
+      CpuFrame frame;
+      {
+        std::lock_guard lock(cpu_frame_mutex);
+        const auto found = cpu_frames.find(address);
+        if (found == cpu_frames.end()) return nullptr;
+        frame = found->second;
+      }
+      auto& texture = cpu_textures_[address];
+      if (texture.image == nullptr || texture.width != frame.width || texture.height != frame.height) {
+        texture = create_texture(frame.width, frame.height, frame.pixels->data(), frame.generation);
+      } else if (texture.generation != frame.generation) {
+        gpu_.update_image(*texture.image, frame.pixels->data());
+        texture.generation = frame.generation;
+      }
+      return texture.image == nullptr ? nullptr : &texture;
+    }
+    const auto found = render_targets_.find(address);
+    return found == render_targets_.end() ? nullptr : &found->second.color;
+  }
+
+  void draw_display(int window_width, int window_height, TextureResource* texture = nullptr) {
+    // The framebuffer of the last flip drawn: a flip after the drawing was taken shows a buffer
+    // whose new frame isn't drawn yet.
+    if (texture == nullptr)
+      texture = display_texture(shown_address_.value_or(
+          normalized_vram_address(display_framebuffer_address.load(std::memory_order_relaxed))));
+    if (texture == nullptr) return;  // the window is cleared all the same
+    // All of a widened framebuffer's width (a video, drawn by the CPU, stays 480:272).
+    const auto shown_width = 480.0F + 2.0F * static_cast<float>(texture->extra);
+    gpu_.draw_picture(display_rect(window_width, window_height, shown_width / 272.0F), *texture->image,
+                      std::min(1.0F, shown_width / static_cast<float>(texture->width)),
+                      std::min(1.0F, 272.0F / static_cast<float>(texture->height)));
+  }
+  // Smooth motion -------------------------------------------------------------------
+  //
+  // Each shown frame keeps what was drawn into its framebuffer. When a frame comes, its 3D draws
+  // are matched to the previous frame's: the same model (vertex and index data at the same
+  // address) drawn the same way with the same texture, and of a model drawn several times, the
+  // copy nearest on screen. In-between frames redraw the frame with matched vertices moved from
+  // where they were to where they are. Draws that jumped (a camera cut, a teleport) and 2D draws
+  // (menus, text) are drawn as they are; a frame with few matches is shown as it is.
+
+  struct ShownFrame {
+    std::vector<GeometryBatch> batches;  // what was drawn into the shown framebuffer
+    std::uint32_t address{};
+    std::chrono::steady_clock::time_point time;
+  };
+
+  void collect_frames(std::vector<GeometryBatch>& batches, const std::vector<FlipMark>& flips) {
+    std::size_t next{};
+    const auto keep_until = [&](std::size_t end) {
+      for (; next < end && next < batches.size(); ++next) {
+        const auto address = normalized_vram_address(batches[next].state.render_target_address);
+        // Only framebuffers that have been shown; and not without end, if one stops being shown.
+        auto found = drawing_.find(address);
+        if (found == drawing_.end()) continue;
+        if (found->second.size() >= 65536U) found->second.clear();
+        found->second.push_back(std::move(batches[next]));
+      }
+    };
+    for (const auto& flip : flips) {
+      keep_until(flip.batch_index);
+      auto& drawn = drawing_[flip.address];
+      push_frame({std::move(drawn), flip.address, flip.time});
+      drawn.clear();
+    }
+    keep_until(batches.size());
+  }
+
+  static std::uint64_t draw_key(const GeometryBatch& batch) {
+    std::uint64_t key = batch.state.vertex_address;
+    key = key * 0x9e3779b97f4a7c15ULL ^ batch.state.index_address;
+    key = key * 0x9e3779b97f4a7c15ULL ^ batch.state.texture_address;
+    return key * 0x9e3779b97f4a7c15ULL ^ (batch.vertices.size() << 3U | batch.type);
+  }
+
+  static bool same_draw(const GeometryBatch& left, const GeometryBatch& right) {
+    return left.type == right.type && left.vertices.size() == right.vertices.size() &&
+           left.state.vertex_address == right.state.vertex_address &&
+           left.state.index_address == right.state.index_address &&
+           left.state.texture_address == right.state.texture_address &&
+           left.state.through_coordinates == right.state.through_coordinates;
+  }
+
+  // 4x3 transforms as the GE has them: columns x, y, z, then the translation.
+  using Transform = std::array<float, 12>;
+
+  static Transform compose(const Transform& after, const Transform& before) {
+    Transform result{};
+    for (std::size_t column = 0; column < 4U; ++column)
+      for (std::size_t row = 0; row < 3U; ++row) {
+        float value = column == 3U ? after[9U + row] : 0.0F;
+        for (std::size_t k = 0; k < 3U; ++k) value += after[k * 3U + row] * before[column * 3U + k];
+        result[column * 3U + row] = value;
+      }
+    return result;
+  }
+
+  static std::optional<Transform> inverse(const Transform& m) {
+    const float a = m[0], b = m[3], c = m[6], d = m[1], e = m[4], f = m[7], g = m[2], h = m[5],
+                i = m[8];
+    const float determinant = a * (e * i - f * h) - b * (d * i - f * g) + c * (d * h - e * g);
+    if (!(std::fabs(determinant) > 1e-12F)) return std::nullopt;
+    const float rows[3][3] = {{(e * i - f * h), -(b * i - c * h), (b * f - c * e)},
+                              {-(d * i - f * g), (a * i - c * g), -(a * f - c * d)},
+                              {(d * h - e * g), -(a * h - b * g), (a * e - b * d)}};
+    Transform result{};
+    for (std::size_t row = 0; row < 3U; ++row)
+      for (std::size_t column = 0; column < 3U; ++column)
+        result[column * 3U + row] = rows[row][column] / determinant;
+    for (std::size_t row = 0; row < 3U; ++row)
+      result[9U + row] = -(result[row] * m[9] + result[3U + row] * m[10] + result[6U + row] * m[11]);
+    return result;
+  }
+
+  // How far a transform's translation is from another's, and how much that may be for "the same
+  // place": a little, growing with the distance from the camera.
+  static float translation_distance(const Transform& left, const Transform& right) {
+    return std::hypot(left[9] - right[9], left[10] - right[10], left[11] - right[11]);
+  }
+  static float placement_tolerance(const Transform& transform) {
+    return 0.02F * std::hypot(transform[9], transform[10], transform[11]) + 0.05F;
+  }
+
+  // How the camera moved between the frames: the change in transform that most draws seen once
+  // in both frames agree on (still things; moving ones disagree with each other).
+  std::optional<Transform> camera_motion(
+      const std::vector<std::pair<std::size_t, std::size_t>>& unique) const {
+    if (unique.size() < 3U) return std::nullopt;
+    const auto& previous = previous_frame_.batches;
+    const auto& current = current_frame_.batches;
+    const auto step = [&](std::size_t limit) { return std::max<std::size_t>(1U, unique.size() / limit); };
+    std::optional<Transform> best;
+    std::size_t best_agreeing{};
+    std::size_t checked{};
+    for (std::size_t k = 0; k < unique.size(); k += step(48)) {
+      const auto undo = inverse(previous[unique[k].first].state.transform);
+      if (!undo) continue;
+      const auto motion = compose(current[unique[k].second].state.transform, *undo);
+      std::size_t agreeing{};
+      checked = 0;
+      for (std::size_t m = 0; m < unique.size(); m += step(128)) {
+        ++checked;
+        const auto& now = current[unique[m].second].state.transform;
+        if (translation_distance(compose(motion, previous[unique[m].first].state.transform), now) <
+            placement_tolerance(now))
+          ++agreeing;
+      }
+      if (agreeing > best_agreeing) {
+        best_agreeing = agreeing;
+        best = motion;
+      }
+    }
+    if (best_agreeing < 3U || best_agreeing * 4U < checked) return std::nullopt;
+    return best;
+  }
+
+  // Where a draw is on screen: the middle of its vertices in front of the camera.
+  static std::array<float, 2> screen_center(const GeometryBatch& batch) {
+    std::array<float, 2> sum{};
+    float count{};
+    for (const auto& vertex : batch.vertices) {
+      if (vertex.position[3] <= 1e-6F) continue;
+      sum[0] += vertex.position[0] / vertex.position[3];
+      sum[1] += vertex.position[1] / vertex.position[3];
+      count += 1.0F;
+    }
+    if (count > 0.0F) sum = {sum[0] / count, sum[1] / count};
+    return sum;
+  }
+
+  // Where a vertex is on screen, if it is in front of the camera and on or near the screen.
+  static std::optional<std::array<float, 2>> on_screen(const float* position) {
+    if (position[3] <= 1e-6F) return std::nullopt;
+    const std::array<float, 2> point{position[0] / position[3], position[1] / position[3]};
+    if (std::fabs(point[0]) > 1.5F || std::fabs(point[1]) > 1.5F) return std::nullopt;
+    return point;
+  }
+
+  // No vertex on screen in both frames moved more than a quarter of the screen. Vertices near or
+  // behind the camera are left out: their screen positions swing wildly as the camera moves a
+  // little (big ground pieces around the player have them), and blending output positions moves
+  // them right anyway.
+  static bool moved_smoothly(const GeometryBatch& from, const GeometryBatch& to) {
+    for (std::size_t index = 0; index < to.vertices.size(); ++index) {
+      const auto a = on_screen(from.vertices[index].position);
+      const auto b = on_screen(to.vertices[index].position);
+      if (a && b && (std::fabs((*b)[0] - (*a)[0]) > 0.5F || std::fabs((*b)[1] - (*a)[1]) > 0.5F))
+        return false;
+    }
+    return true;
+  }
+
+  static bool in_view(const GeometryBatch& batch) {
+    return std::any_of(batch.vertices.begin(), batch.vertices.end(), [](const auto& vertex) {
+      const auto point = on_screen(vertex.position);
+      return point && std::fabs((*point)[0]) <= 1.0F && std::fabs((*point)[1]) <= 1.0F;
+    });
+  }
+
+  void push_frame(ShownFrame frame) {
+    previous_frame_ = std::move(current_frame_);
+    current_frame_ = std::move(frame);
+    matches_.assign(current_frame_.batches.size(), -1);
+    interpolating_ = false;
+    camera_undo_.reset();
+    if (!pacer_.frame(current_frame_.time) || previous_frame_.batches.empty()) return;
+    const auto& previous = previous_frame_.batches;
+    const auto& current = current_frame_.batches;
+    const auto counted = [](const GeometryBatch& batch) {
+      return !batch.state.through_coordinates && !batch.vertices.empty();
+    };
+    std::unordered_map<std::uint64_t, std::vector<std::size_t>> previous_draws;
+    std::unordered_map<std::uint64_t, std::size_t> current_counts;
+    for (std::size_t index = 0; index < previous.size(); ++index)
+      if (counted(previous[index])) previous_draws[draw_key(previous[index])].push_back(index);
+    for (const auto& batch : current)
+      if (counted(batch)) ++current_counts[draw_key(batch)];
+    // Models drawn once in both frames pair up by themselves; they also show how the camera moved.
+    std::vector<std::pair<std::size_t, std::size_t>> unique;
+    for (std::size_t index = 0; index < current.size(); ++index) {
+      if (!counted(current[index])) continue;
+      const auto key = draw_key(current[index]);
+      const auto found = previous_draws.find(key);
+      if (found != previous_draws.end() && found->second.size() == 1U && current_counts[key] == 1U &&
+          same_draw(previous[found->second[0]], current[index]))
+        unique.emplace_back(found->second[0], index);
+    }
+    const auto motion = camera_motion(unique);
+    std::vector<bool> taken(previous.size());
+    std::size_t candidates{};
+    std::size_t matched{};
+    std::size_t in_view_now{};
+    std::size_t in_view_both{};
+    for (std::size_t index = 0; index < current.size(); ++index) {
+      const auto& batch = current[index];
+      if (!counted(batch)) continue;
+      ++candidates;
+      const auto found = previous_draws.find(draw_key(batch));
+      if (found == previous_draws.end()) continue;
+      // A model drawn several times (tiles, props): the copy that, moved along with the camera,
+      // lands where this one is; it must land close by or be clearly closer than any other copy.
+      // Without the camera's motion, the copy nearest on screen.
+      std::ptrdiff_t best = -1;
+      float best_error = std::numeric_limits<float>::max();
+      float second_error = std::numeric_limits<float>::max();
+      const auto center = screen_center(batch);
+      for (const auto candidate : found->second) {
+        if (taken[candidate] || !same_draw(previous[candidate], batch)) continue;
+        float error{};
+        if (motion) {
+          error = translation_distance(compose(*motion, previous[candidate].state.transform),
+                                       batch.state.transform);
+        } else {
+          const auto other = screen_center(previous[candidate]);
+          error = std::fabs(other[0] - center[0]) + std::fabs(other[1] - center[1]);
+        }
+        if (error < best_error) {
+          second_error = best_error;
+          best_error = error;
+          best = static_cast<std::ptrdiff_t>(candidate);
+        } else if (error < second_error) {
+          second_error = error;
+        }
+      }
+      if (best < 0) continue;
+      if (motion && found->second.size() > 1U && best_error > 0.25F * second_error &&
+          best_error > placement_tolerance(batch.state.transform))
+        continue;
+      if (!moved_smoothly(previous[static_cast<std::size_t>(best)], batch)) continue;
+      taken[static_cast<std::size_t>(best)] = true;
+      matches_[index] = best;
+      ++matched;
+      if (in_view(batch)) {
+        ++in_view_now;
+        if (in_view(previous[static_cast<std::size_t>(best)])) ++in_view_both;
+      }
+    }
+    // Most of what is in view now was in view before too, unless the camera cut to another view.
+    interpolating_ = candidates != 0U && matched * 2U >= candidates && in_view_both * 2U >= in_view_now;
+    if (interpolating_ && motion) camera_undo_ = inverse(*motion);
+    if (smooth_stats_) {
+      ++stats_frames_;
+      stats_interpolated_ += interpolating_ ? 1U : 0U;
+      stats_candidates_ += candidates;
+      stats_matched_ += matched;
+      if (stats_frames_ % 300U == 0U)
+        std::fprintf(stderr, "[smooth] %llu frames, %.0f%% smoothed, %.0f%% of 3D draws matched\n",
+                     static_cast<unsigned long long>(stats_frames_),
+                     100.0 * static_cast<double>(stats_interpolated_) / static_cast<double>(stats_frames_),
+                     stats_candidates_ == 0U ? 0.0
+                                             : 100.0 * static_cast<double>(stats_matched_) /
+                                                   static_cast<double>(stats_candidates_));
+    }
+  }
+
+  // Where an unmatched 3D draw was if it stood still while the camera moved: back from the output
+  // position to camera space, the camera's motion undone, and out again. Returns false if the
+  // draw's projection can't be undone (no perspective).
+  static bool unmoved_by_camera(const GeometryBatch& batch, const Transform& camera_undo,
+                                std::vector<GeometryVertex>& previous) {
+    const auto& o = batch.state.view_to_output;
+    // Camera space to the output x, y and w, which (with perspective) give the point back.
+    const Transform to_output{o[0], o[1], o[3], o[4], o[5], o[7], o[8], o[9], o[11], o[12], o[13], o[15]};
+    const auto from_output = inverse(to_output);
+    if (!from_output) return false;
+    const auto back = compose(camera_undo, *from_output);
+    previous = batch.vertices;
+    for (auto& vertex : previous) {
+      auto* position = vertex.position;
+      const float x = position[0], y = position[1], w = position[3];
+      const float view[3] = {back[0] * x + back[3] * y + back[6] * w + back[9],
+                             back[1] * x + back[4] * y + back[7] * w + back[10],
+                             back[2] * x + back[5] * y + back[8] * w + back[11]};
+      for (std::size_t row = 0; row < 4U; ++row)
+        position[row] = o[row] * view[0] + o[4U + row] * view[1] + o[8U + row] * view[2] + o[12U + row];
+      if (position[3] != 0.0F)
+        position[2] = normalized_viewport_depth(position[2] / position[3] * 65535.0F) * position[3];
+    }
+    return true;
+  }
+
+  // The current frame's drawing with vertices `alpha` of the way from where they were: matched
+  // draws from their previous positions, other 3D draws from where the camera's motion says.
+  std::vector<GeometryBatch> blended_frame(float alpha) const {
+    auto batches = current_frame_.batches;
+    std::vector<GeometryVertex> unmoved;
+    for (std::size_t index = 0; index < batches.size(); ++index) {
+      const std::vector<GeometryVertex>* from = nullptr;
+      if (matches_[index] >= 0) {
+        from = &previous_frame_.batches[static_cast<std::size_t>(matches_[index])].vertices;
+      } else if (camera_undo_ && !batches[index].state.through_coordinates &&
+                 unmoved_by_camera(batches[index], *camera_undo_, unmoved)) {
+        from = &unmoved;
+      }
+      if (from == nullptr) continue;
+      auto& to = batches[index].vertices;
+      for (std::size_t vertex = 0; vertex < to.size(); ++vertex)
+        for (std::size_t component = 0; component < 4U; ++component) {
+          const auto start = (*from)[vertex].position[component];
+          to[vertex].position[component] = start + (to[vertex].position[component] - start) * alpha;
+        }
+    }
+    return batches;
+  }
+
+  // Where in-between frames are drawn: like the shown framebuffer, starting from its picture
+  // (for games that don't clear all of it). The game draws its next frame into the other
+  // framebuffer meanwhile, so this one is still the finished current frame.
+  RenderTarget* smooth_target(std::uint32_t address) {
+    const auto found = render_targets_.find(address);
+    if (found == render_targets_.end() || found->second.target == nullptr) return nullptr;
+    const auto& shown = found->second.color;
+    if (smooth_target_.target == nullptr || smooth_target_.color.width != shown.width ||
+        smooth_target_.color.height != shown.height || smooth_target_.color.scale != shown.scale ||
+        smooth_target_.color.extra != shown.extra) {
+      create_render_target(smooth_target_, shown.width, shown.height, shown.scale);
+      smooth_target_.color.extra = shown.extra;
+    }
+    smooth_target_.stride = found->second.stride;
+    smooth_target_.format = found->second.format;
+    gpu_.copy_target(*found->second.target, *smooth_target_.target);
+    return &smooth_target_;
+  }
+
+  // The largest rectangle of this shape (the PSP's 480:272 unless widened) centred in the window.
+  static gpu::Rect display_rect(int window_width, int window_height, float aspect = 480.0F / 272.0F) {
+    auto width = static_cast<float>(window_width);
+    auto height = width / aspect;
+    if (height > static_cast<float>(window_height)) {
+      height = static_cast<float>(window_height);
+      width = height * aspect;
+    }
+    // Rounded as OpenGL had it, from the bottom.
+    const auto bottom = static_cast<int>((static_cast<float>(window_height) - height) * 0.5F);
+    return {static_cast<int>((static_cast<float>(window_width) - width) * 0.5F),
+            window_height - bottom - static_cast<int>(height), static_cast<int>(width), static_cast<int>(height)};
+  }
+
+  gpu::Backend& gpu_;
+  std::uint32_t extra_{};  // widescreen: PSP pixels at each side of the full-size framebuffers
+  std::array<TextureResource, 2U> overlay_textures_{};  // the keyboard or settings screen, the FPS counter
+  std::size_t vertex_capacity_{};  // for the cache metrics
+  std::vector<GeometryVertex> staging_;
+  std::unordered_map<std::uint32_t, RenderTarget> render_targets_;
+  std::unordered_map<std::uint32_t, TextureResource> cpu_textures_;
+  std::unordered_map<std::uint64_t, TextureResource> uploaded_textures_;
+  std::optional<std::uint32_t> shown_address_;  // the framebuffer of the last flip drawn
+  // Smooth motion: what is being drawn into each shown framebuffer, the last two shown frames,
+  // which previous draw each current draw matches, and where in-between frames are drawn.
+  std::unordered_map<std::uint32_t, std::vector<GeometryBatch>> drawing_;
+  ShownFrame previous_frame_;
+  ShownFrame current_frame_;
+  std::vector<std::ptrdiff_t> matches_;
+  bool interpolating_{};
+  std::optional<Transform> camera_undo_;  // the camera's motion between the frames, backwards
+  FramePacer pacer_;
+  float shown_alpha_{1.0F};
+  RenderTarget smooth_target_;
+  // REFRACT_SMOOTH_STATS=1 prints how much is smoothed.
+  bool smooth_stats_{std::getenv("REFRACT_SMOOTH_STATS") != nullptr};
+  std::uint64_t stats_frames_{};
+  std::uint64_t stats_interpolated_{};
+  std::uint64_t stats_candidates_{};
+  std::uint64_t stats_matched_{};
+};
+
+std::unique_ptr<Renderer>& renderer = *new std::unique_ptr<Renderer>;  // as backend
