--- /dev/null
+++ b/refract/src/stubs/net/adhoc_state.hpp
@@ -0,0 +1,181 @@
+#pragma once
+
+// The game's side of the ad hoc network (sceNet, sceNetAdhoc, sceNetAdhocctl, sceWlan and the
+// netconf dialog): its sockets, its adhocctl handlers and the dialog. Groups and peers come from
+// the server session in net/adhoc_control.hpp; PDP and PTP data go through aemu_postoffice's
+// relay client.
+
+#include "../../net/adhoc_control.hpp"
+#include "../../../third_party/aemu_postoffice/client/postoffice_client.h"
+
+#include <atomic>
+#include <chrono>
+#include <cstdarg>
+#include <cstdint>
+#include <map>
+#include <memory>
+#include <mutex>
+#include <thread>
+
+namespace adhoc_state {
+
+using refract::adhoc::Mac;
+
+inline constexpr std::uint32_t net_already_initialized = 0x80410001U;
+inline constexpr std::uint32_t invalid_socket_id = 0x80410701U;
+inline constexpr std::uint32_t invalid_address = 0x80410702U;
+inline constexpr std::uint32_t invalid_port = 0x80410703U;
+inline constexpr std::uint32_t invalid_data_length = 0x80410705U;
+inline constexpr std::uint32_t not_enough_space = 0x80400706U;
+inline constexpr std::uint32_t would_block = 0x80410709U;
+inline constexpr std::uint32_t port_in_use = 0x8041070aU;
+inline constexpr std::uint32_t not_connected = 0x8041070bU;
+inline constexpr std::uint32_t disconnected = 0x8041070cU;
+inline constexpr std::uint32_t invalid_argument = 0x80410711U;
+inline constexpr std::uint32_t not_initialized = 0x80410712U;
+inline constexpr std::uint32_t already_initialized = 0x80410713U;
+inline constexpr std::uint32_t timeout = 0x80410715U;
+inline constexpr std::uint32_t connection_refused = 0x80410718U;
+inline constexpr std::uint32_t thread_aborted = 0x80410719U;
+inline constexpr std::uint32_t ctl_invalid_argument = 0x80410b04U;
+inline constexpr std::uint32_t ctl_timeout = 0x80410b05U;
+inline constexpr std::uint32_t ctl_id_not_found = 0x80410b06U;
+inline constexpr std::uint32_t ctl_already_initialized = 0x80410b07U;
+inline constexpr std::uint32_t ctl_not_initialized = 0x80410b08U;
+inline constexpr std::uint32_t ctl_busy = 0x80410b10U;
+inline constexpr std::uint32_t ctl_too_many_handlers = 0x80410b12U;
+
+// A PTP socket's state, as sceNetAdhocGetPtpStat reports it.
+inline constexpr std::int32_t ptp_closed = 0;
+inline constexpr std::int32_t ptp_listening = 1;
+inline constexpr std::int32_t ptp_connecting = 2;
+inline constexpr std::int32_t ptp_established = 4;
+
+struct Socket {
+  bool ptp{};
+  Mac local{};
+  std::uint16_t local_port{};
+  Mac peer{};
+  std::uint16_t peer_port{};
+  std::uint32_t buffer_size{};
+  std::chrono::steady_clock::time_point last_attempt;  // to reach the relay
+  void* pdp{};       // PDP: the relay's session for local_port
+  void* listener{};  // PTP: listening for connections
+  void* stream{};    // PTP: connected
+  // PTP: sceNetAdhocPtpConnect's attempts, on a thread of their own (the relay answers once the
+  // other side accepts): its result, taken by the next call on the socket.
+  std::atomic<bool> connecting{};
+  std::atomic<bool> closed{};
+  std::mutex connect_mutex;
+  void* connected_stream{};
+  std::mutex mutex;  // one call into the relay client at a time
+
+  std::int32_t ptp_state() const {
+    if (stream != nullptr) return ptp_established;
+    if (listener != nullptr) return ptp_listening;
+    return connecting ? ptp_connecting : ptp_closed;
+  }
+};
+
+struct Handler {
+  std::uint32_t entry{};
+  std::uint32_t argument{};
+};
+
+// The netconf dialog (sceUtilityNetconf*): connecting to an ad hoc group, which the PSP shows a
+// dialog for while it joins.
+struct Netconf {
+  std::uint32_t status{};  // 0 none, 1 starting, 2 shown, 3 finished, 4 shutting down
+  std::uint32_t params{};
+  std::int32_t action{};
+  refract::adhoc::GroupName group{};
+  bool asked{};
+  std::chrono::steady_clock::time_point started;
+};
+
+struct State {
+  std::mutex mutex;
+  bool net{};
+  bool adhoc{};
+  bool adhocctl{};
+  std::map<int, Handler> handlers;
+  std::jthread handler_thread;
+  std::map<int, std::shared_ptr<Socket>> sockets;
+  int next_socket{1};
+  Netconf netconf;
+};
+
+inline State& state() {
+  static State instance;
+  return instance;
+}
+
+inline std::shared_ptr<Socket> find_socket(int id, bool ptp) {
+  auto& adhoc = state();
+  std::lock_guard lock(adhoc.mutex);
+  const auto found = adhoc.sockets.find(id);
+  if (found == adhoc.sockets.end() || found->second->ptp != ptp) return nullptr;
+  return found->second;
+}
+
+inline int add_socket(std::shared_ptr<Socket> socket) {
+  auto& adhoc = state();
+  std::lock_guard lock(adhoc.mutex);
+  const int id = adhoc.next_socket++;
+  adhoc.sockets.emplace(id, std::move(socket));
+  return id;
+}
+
+// Whether a socket of the kind is on the port; with listening, only listening ones count.
+inline bool port_taken(bool ptp, std::uint16_t port, bool listening = false) {
+  auto& adhoc = state();
+  std::lock_guard lock(adhoc.mutex);
+  for (const auto& [id, socket] : adhoc.sockets)
+    if (socket->ptp == ptp && socket->local_port == port && (!listening || socket->listener != nullptr))
+      return true;
+  return false;
+}
+
+// A free port for a socket asked for on port 0.
+inline std::uint16_t free_port(bool ptp) {
+  for (std::uint16_t port = 50000U; port < 55000U; ++port)
+    if (!port_taken(ptp, port)) return port;
+  return 0U;
+}
+
+// Takes in the connection sceNetAdhocPtpConnect's thread made, if it's made one. Call with the
+// socket's mutex held.
+inline void take_connection(Socket& socket) {
+  std::lock_guard lock(socket.connect_mutex);
+  if (socket.connected_stream == nullptr) return;
+  socket.stream = socket.connected_stream;
+  socket.connected_stream = nullptr;
+}
+
+// Closes everything the socket has with the relay.
+inline void close_socket(Socket& socket) {
+  {
+    std::lock_guard lock(socket.connect_mutex);
+    socket.closed = true;
+    if (socket.connected_stream != nullptr) ptp_close(socket.connected_stream);
+    socket.connected_stream = nullptr;
+  }
+  std::lock_guard lock(socket.mutex);
+  if (socket.pdp != nullptr) pdp_delete(socket.pdp);
+  if (socket.listener != nullptr) ptp_listen_close(socket.listener);
+  if (socket.stream != nullptr) ptp_close(socket.stream);
+  socket.pdp = socket.listener = socket.stream = nullptr;
+}
+
+// Removes the socket from the game's.
+inline std::shared_ptr<Socket> remove_socket(int id, bool ptp) {
+  auto& adhoc = state();
+  std::lock_guard lock(adhoc.mutex);
+  const auto found = adhoc.sockets.find(id);
+  if (found == adhoc.sockets.end() || found->second->ptp != ptp) return nullptr;
+  auto socket = found->second;
+  adhoc.sockets.erase(found);
+  return socket;
+}
+
+}  // namespace adhoc_state
