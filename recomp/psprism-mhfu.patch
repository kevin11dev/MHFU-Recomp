diff --git a/refract/include/refract/adhoc.hpp b/refract/include/refract/adhoc.hpp
new file mode 100644
index 0000000..da2157f
--- /dev/null
+++ b/refract/include/refract/adhoc.hpp
@@ -0,0 +1,29 @@
+#pragma once
+
+// Ad hoc multiplayer over the internet. The PSP's ad hoc network (sceNetAdhoc*, sceNetAdhocctl*)
+// is carried by an aemu_postoffice server: its adhocctl service finds the other players and the
+// groups they're in, and its relay passes the game's data between them, so no one has to open
+// ports. PPSSPP (relay servers, 1.20 and later) and PSPs with the aemu plugin use the same servers
+// and ports, so they can play together.
+
+#include <array>
+#include <chrono>
+#include <cstdint>
+#include <string>
+
+namespace refract::adhoc {
+
+struct Settings {
+  std::string server;                 // the server's host name or address; empty: no network
+  std::array<std::uint8_t, 6> mac{};  // this player's address on the ad hoc network
+  std::string nickname;               // this player's name, as the other players see it
+};
+
+// Call before the game starts. Without a server the PSP's wireless switch reads as off.
+void configure(const Settings& settings);
+
+// Whether a server takes connections (on its adhocctl port) within `timeout`, to show players
+// which servers they can reach before they play. Blocks; looking up the name can take longer.
+bool server_answers(const std::string& host, std::chrono::milliseconds timeout);
+
+}  // namespace refract::adhoc
diff --git a/refract/include/refract/frontend.hpp b/refract/include/refract/frontend.hpp
new file mode 100644
index 0000000..c34908a
--- /dev/null
+++ b/refract/include/refract/frontend.hpp
@@ -0,0 +1,86 @@
+#pragma once
+
+// Extras of the SDL2 + OpenGL ES host (src/host/sdl_gles.cpp) for an entry point to use before
+// the game starts: how the game is displayed, and a launcher in the game's window.
+
+#include <cstddef>
+#include <cstdint>
+#include <string>
+#include <vector>
+
+namespace refract::frontend {
+
+struct Choice {
+  std::string label;
+  std::vector<std::string> values;
+  std::size_t selected{};
+  std::string section;      // the heading it's listed under (one shows where it changes)
+  std::string description;  // what it does, shown while it's chosen
+};
+
+// An image: 8-bit RGBA, rows top to bottom.
+struct Image {
+  int width{};
+  int height{};
+  std::vector<std::uint8_t> rgba;
+};
+
+// Reads an image file (PNG, JPEG, BMP...); empty if it can't.
+Image load_image(const std::string& path);
+
+// Draws the game at render_scale GL pixels per PSP pixel (1 is the PSP's 480x272), in a window of
+// the given size (made to fit the screen) or fullscreen on the current display. Call it before
+// the game starts.
+void set_display_settings(std::uint32_t render_scale, int window_width, int window_height,
+                          bool fullscreen);
+
+// Shows how many frames a second the game draws, in the top-left corner of the window.
+void set_fps_counter(bool shown);
+
+// Widescreen: in a window wider than the PSP's 480:272, the game's 3D world is drawn wider to
+// fill it, at the same size (more of it at the sides), instead of black bars; its 2D (the HUD,
+// menus) stays in the middle, and what covers the whole screen flat (fades, backgrounds) is
+// stretched.
+void set_widescreen(bool enabled);
+
+// How the game is drawn: Vulkan, where this build has it and the device can, else OpenGL ES.
+// Set before the window opens; once it's open, a change starts over in a new window.
+enum class GraphicsApi { vulkan, opengl };
+void set_graphics_api(GraphicsApi api);
+// What draws now (Vulkan may not have been usable).
+GraphicsApi graphics_api();
+bool vulkan_built();
+// Where Vulkan keeps the pipelines it compiled, so they're ready the next time.
+void set_pipeline_cache(const std::string& path);
+
+// Frame interpolation: shows frames in between the game's, with its 3D drawing moved part of
+// the way, up to `pictures_per_second` pictures a second (and at most one per refresh of the
+// screen); 0 turns it off. The game itself runs as before; the picture is one game frame later.
+void set_frame_interpolation(std::uint32_t pictures_per_second);
+
+// What the launcher shows: the game's art and logo, and the pages behind its menu.
+struct Launcher {
+  std::string title;    // the game's name, shown instead of the logo if there's none
+  Image logo;           // the game's logo, at the left of the menu
+  std::string caption;  // under the logo
+  Image background;     // behind everything, covering the window
+  std::string play;     // the menu's first item, which starts the game
+  std::string version;  // bottom left
+  std::string details;  // bottom right (the disc, ...)
+  // The Controls page: what each PSP button is on a keyboard and a game controller. A row for
+  // "Cross", "Circle", "Square" or "Triangle" shows its symbol.
+  struct Control {
+    std::string psp;
+    std::string keyboard;
+    std::string controller;
+  };
+  std::vector<Control> controls;
+};
+
+// Shows the launcher in the game window: a menu over the game's art (play, settings, controls,
+// quit), a page for `choices` grouped by section, and one for the controls. Returns true to play,
+// false if the player quit or closed the window. Keyboard, mouse and game controllers work;
+// REFRACT_SETTINGS_SCRIPT drives it with an input script (for testing).
+bool run_launcher(const Launcher& launcher, std::vector<Choice>& choices);
+
+}  // namespace refract::frontend
