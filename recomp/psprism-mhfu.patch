+  }
+
+  void draw_row(std::size_t index, float top) {
+    const auto& choice = choices_[index];
+    const bool chosen = index == choice_;
+    const auto left = panel_left + 18.0F, right = panel_right - 18.0F;
+    if (chosen) {
+      fill(canvas, left, top, right, top + row_height - 2.0F, rgba(234, 180, 78, 38));
+      fill(canvas, left, top, left + 3.0F, top + row_height - 2.0F, gold);
+    }
+    hits_.push_back({Hit::row, left, top, right, top + row_height, static_cast<int>(index), 0});
+    const auto label_end = panel_left + 34.0F + text(canvas, panel_left + 34.0F, top + 23.0F, 18.0F, choice.label, parchment);
+    if (choice.values.empty()) return;
+    // The options side by side, the chosen one underlined; or, if they don't fit, < the chosen one >.
+    constexpr float size = 14.0F, gap = 22.0F;
+    const auto end = right - 18.0F;
+    std::vector<std::string> names;
+    std::vector<float> widths;
+    float total = 0.0F;
+    for (const auto& value : choice.values) {
+      names.push_back(capitals(value));
+      widths.push_back(measure(canvas, size, names.back(), UiFace::bold));
+      total += widths.back() + (names.size() > 1U ? gap : 0.0F);
+    }
+    const auto baseline = top + 22.0F;
+    if (total <= end - label_end - 30.0F) {
+      auto x = end - total;
+      for (std::size_t option = 0; option < names.size(); ++option) {
+        const bool selected = option == choice.selected;
+        text(canvas, x, baseline, size, names[option], selected ? gold : muted, UiFace::bold);
+        if (selected) fill(canvas, x, baseline + 5.0F, x + widths[option], baseline + 7.0F, gold);
+        hits_.push_back({Hit::option, x - gap * 0.5F, top, x + widths[option] + gap * 0.5F, top + row_height,
+                         static_cast<int>(index), static_cast<int>(option)});
+        x += widths[option] + gap;
+      }
+    } else {
+      const auto& name = names[std::min(choice.selected, names.size() - 1U)];
+      const auto width = measure(canvas, size, name, UiFace::bold);
+      const auto x = end - 14.0F - width;
+      text(canvas, x, baseline, size, name, gold, UiFace::bold);
+      arrow(canvas, x - 14.0F, baseline - 5.0F, 4.5F, -1, 0, chosen ? gold : muted);
+      arrow(canvas, end - 4.0F, baseline - 5.0F, 4.5F, 1, 0, chosen ? gold : muted);
+      hits_.push_back({Hit::step, x - 26.0F, top, x + width * 0.5F, top + row_height, static_cast<int>(index), -1});
+      hits_.push_back({Hit::step, x + width * 0.5F, top, end + 8.0F, top + row_height, static_cast<int>(index), 1});
+    }
+  }
