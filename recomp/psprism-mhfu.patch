+constexpr std::uint32_t psp_up = 0x000010U;
+constexpr std::uint32_t psp_right = 0x000020U;
+constexpr std::uint32_t psp_down = 0x000040U;
+constexpr std::uint32_t psp_left = 0x000080U;
+constexpr std::uint32_t psp_l = 0x000100U;
+constexpr std::uint32_t psp_r = 0x000200U;
+constexpr std::uint32_t psp_triangle = 0x001000U;
+constexpr std::uint32_t psp_circle = 0x002000U;
+constexpr std::uint32_t psp_cross = 0x004000U;
+constexpr std::uint32_t psp_square = 0x008000U;
+constexpr std::uint32_t analog_left = 1U << 0U;
+constexpr std::uint32_t analog_right = 1U << 1U;
+constexpr std::uint32_t analog_up = 1U << 2U;
+constexpr std::uint32_t analog_down = 1U << 3U;
+constexpr std::uint32_t host_audio_sample_rate = 44100U;
+
+std::uint64_t env_number(const char* name, std::uint64_t fallback) {
+  const auto* value = std::getenv(name);
+  return value == nullptr ? fallback : std::strtoull(value, nullptr, 0);
+}
+
+// PSP address helpers (shared semantics with the other backends) ------------
+
+std::uint32_t normalized_vram_address(std::uint32_t address) {
+  if (address < 0x00200000U || (address & 0x0fe00000U) == 0x04000000U)
+    return 0x04000000U | (address & 0x001fffffU);
+  return address;
+}
+
+float render_target_texture_scale(std::uint32_t declared_size, std::size_t target_size) {
+  if (declared_size == 0U || target_size == 0U) return 1.0F;
+  return static_cast<float>(declared_size) / static_cast<float>(target_size);
+}
+
+float render_target_geometry_scale(bool through_coordinates, std::uint32_t declared_size,
+                                   std::size_t target_size) {
+  return through_coordinates ? render_target_texture_scale(declared_size, target_size) : 1.0F;
+}
+
+struct RenderTargetAddressOffset {
+  std::uint32_t x{};
+  std::uint32_t y{};
+};
+
+std::optional<RenderTargetAddressOffset> render_target_address_offset(
+    std::uint32_t texture_address, std::uint32_t target_address, std::uint32_t target_stride,
+    std::size_t target_width, std::size_t target_height, std::uint32_t target_format,
+    std::uint32_t texture_format) {
+  if (target_stride == 0U || target_format != texture_format || texture_address < target_address)
+    return std::nullopt;
+  const std::uint32_t bytes_per_pixel = target_format == 3U ? 4U : 2U;
+  const auto row_bytes = target_stride * bytes_per_pixel;
+  const auto byte_offset = texture_address - target_address;
+  const auto x_bytes = byte_offset % row_bytes;
+  if (x_bytes % bytes_per_pixel != 0U) return std::nullopt;
+  const RenderTargetAddressOffset result{x_bytes / bytes_per_pixel, byte_offset / row_bytes};
+  if (result.x >= target_width || result.y >= target_height) return std::nullopt;
+  return result;
+}
+
+std::uint8_t expand4(std::uint32_t value) { return static_cast<std::uint8_t>(value * 17U); }
+std::uint8_t expand5(std::uint32_t value) {
+  return static_cast<std::uint8_t>((value << 3U) | (value >> 2U));
+}
+
+std::vector<std::uint8_t> convert_frame(const std::uint8_t* source, std::uint32_t stride,
+                                        std::uint32_t width, std::uint32_t height,
+                                        std::uint32_t format) {
+  std::vector<std::uint8_t> output(static_cast<std::size_t>(width) * height * 4U);
+  const auto bytes_per_pixel = format == 3U ? 4U : 2U;
+  for (std::uint32_t y = 0; y < height; ++y) {
+    for (std::uint32_t x = 0; x < width; ++x) {
+      const auto* p = source + (static_cast<std::size_t>(y) * stride + x) * bytes_per_pixel;
+      auto* out = output.data() + (static_cast<std::size_t>(y) * width + x) * 4U;
+      if (format == 3U) {
+        std::memcpy(out, p, 4U);
+        continue;
+      }
+      const std::uint32_t packed = p[0] | (p[1] << 8U);
+      out[3] = 255U;
+      if (format == 0U) {
+        out[0] = expand5(packed & 31U);
+        out[1] = static_cast<std::uint8_t>(((packed >> 5U) & 63U) * 255U / 63U);
+        out[2] = expand5((packed >> 11U) & 31U);
+      } else if (format == 1U) {
+        out[0] = expand5(packed & 31U);
+        out[1] = expand5((packed >> 5U) & 31U);
+        out[2] = expand5((packed >> 10U) & 31U);
+        out[3] = (packed & 0x8000U) != 0U ? 255U : 0U;
+      } else {
+        out[0] = expand4(packed & 15U);
+        out[1] = expand4((packed >> 4U) & 15U);
+        out[2] = expand4((packed >> 8U) & 15U);
+        out[3] = expand4((packed >> 12U) & 15U);
+      }
+    }
+  }
+  return output;
+}
+
+// GE state, as the graphics backends take it ---------------------------------
+
+gpu::Blend blend_factor(std::uint32_t factor, std::uint32_t fixed, bool source) {
+  using gpu::Blend;
+  if (factor >= 10U) {
+    if ((fixed & 0x00ffffffU) == 0U) return Blend::zero;
+    if ((fixed & 0x00ffffffU) == 0x00ffffffU) return Blend::one;
+    return Blend::constant_color;
+  }
+  constexpr Blend source_factors[] = {
+      Blend::destination_color, Blend::one_minus_destination_color, Blend::source_alpha,
+      Blend::one_minus_source_alpha, Blend::destination_alpha, Blend::one_minus_destination_alpha,
+      Blend::source_alpha, Blend::one_minus_source_alpha, Blend::destination_alpha,
+      Blend::one_minus_destination_alpha};
+  constexpr Blend destination_factors[] = {
+      Blend::source_color, Blend::one_minus_source_color, Blend::source_alpha,
+      Blend::one_minus_source_alpha, Blend::destination_alpha, Blend::one_minus_destination_alpha,
+      Blend::source_alpha, Blend::one_minus_source_alpha, Blend::destination_alpha,
+      Blend::one_minus_destination_alpha};
+  return source ? source_factors[factor] : destination_factors[factor];
+}
+
+std::uint8_t geometry_color_write_mask(const GeometryState& state) {
+  auto mask = state.color_write_mask;
+  if (state.render_target_format != 3U || (!state.stencil_test && !state.clear_stencil))
+    return mask;
+  const auto operation = state.clear_stencil ? 2U : state.stencil_depth_pass;
+  if ((operation != 1U && operation != 2U) || state.stencil_write_mask != 0xffU)
+    mask &= static_cast<std::uint8_t>(~0x08U);
+  return mask;
+}
+
+// A draw's fixed-function state: the GE's, as far as the graphics APIs have it.
+gpu::Draw draw_state(const GeometryState& state, std::uint32_t type) {
+  gpu::Draw draw;
+  auto& pipeline = draw.pipeline;
+  pipeline.primitive = static_cast<std::uint8_t>(type);
+  pipeline.cull = state.cull_face;
+  pipeline.front_clockwise = state.front_face_clockwise;
+  pipeline.color_mask = geometry_color_write_mask(state);
+  if (state.alpha_blend) {
+    pipeline.blend = true;
+    pipeline.blend_source = blend_factor(state.blend_source, state.blend_fix_a, true);
+    pipeline.blend_destination = blend_factor(state.blend_destination, state.blend_fix_b, false);
+    pipeline.blend_operation = static_cast<std::uint8_t>(state.blend_equation <= 4U ? state.blend_equation : 0U);
+    const auto fixed = state.blend_source >= 10U ? state.blend_fix_a : state.blend_fix_b;
+    draw.blend_color[0] = static_cast<float>(fixed & 0xffU) / 255.0F;
+    draw.blend_color[1] = static_cast<float>((fixed >> 8U) & 0xffU) / 255.0F;
+    draw.blend_color[2] = static_cast<float>((fixed >> 16U) & 0xffU) / 255.0F;
+    draw.blend_color[3] = 1.0F;
+  }
+  if (state.depth_test || state.depth_write) {
+    pipeline.depth = true;
+    pipeline.depth_function = static_cast<std::uint8_t>(state.depth_test ? std::min(state.depth_function, 7U) : 1U);
+    pipeline.depth_write = state.depth_write;
+  }
+  if (state.stencil_test || state.clear_stencil) {
+    const auto operation = [](std::uint32_t value) { return static_cast<std::uint8_t>(value <= 5U ? value : 0U); };
+    pipeline.stencil = true;
+    draw.stencil_reference = static_cast<std::uint8_t>(state.stencil_reference & 0xffU);
+    if (state.clear_stencil) {
+      pipeline.stencil_function = 1U;
+      pipeline.stencil_fail = pipeline.stencil_depth_fail = pipeline.stencil_pass = 2U;
+    } else {
+      pipeline.stencil_function = static_cast<std::uint8_t>(std::min(state.stencil_function, 7U));
+      pipeline.stencil_fail = operation(state.stencil_fail);
+      pipeline.stencil_depth_fail = operation(state.stencil_depth_fail);
+      pipeline.stencil_pass = operation(state.stencil_depth_pass);
+      draw.stencil_read_mask = static_cast<std::uint8_t>(state.stencil_read_mask & 0xffU);
+    }
+    draw.stencil_write_mask = static_cast<std::uint8_t>(state.stencil_write_mask & 0xffU);
+  }
+  return draw;
+}
