+#include "adhoc_calls.hpp"
+
+void sceNetAdhocGetPdpStat(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  // (int* size, SceNetAdhocPdpStat* list): 20 bytes each: next, id, address (6), port, bytes waiting.
+  (void)implementation;
+  constexpr std::uint32_t entry_size = 20U;
+  auto* size = guest_pointer<std::int32_t>(state, state.gpr[4]);
+  if (size == nullptr) {
+    state.gpr[2] = adhoc_state::invalid_argument;
+    return;
+  }
+  std::vector<std::pair<int, std::shared_ptr<adhoc_state::Socket>>> sockets;
+  {
+    auto& adhoc = adhoc_state::state();
+    std::lock_guard lock(adhoc.mutex);
+    for (const auto& [id, socket] : adhoc.sockets)
+      if (!socket->ptp) sockets.emplace_back(id, socket);
+  }
+  const auto list = state.gpr[5];
+  if (list == 0U) {
+    *size = static_cast<std::int32_t>(sockets.size() * entry_size);
+    state.gpr[2] = 0U;
+    return;
+  }
+  const auto count = std::min<std::size_t>(sockets.size(), static_cast<std::size_t>(std::max(*size, 0)) / entry_size);
+  for (std::size_t index = 0; index < count; ++index) {
+    auto& [id, socket] = sockets[index];
+    const auto entry = list + static_cast<std::uint32_t>(index) * entry_size;
+    int waiting = 0;
+    {
+      std::lock_guard lock(socket->mutex);
+      if (socket->pdp != nullptr) waiting = std::max(pdp_buffered_data_size(socket->pdp), 0);
+    }
+    psprecomp::store32(state, entry, index + 1U < count ? entry + entry_size : 0U);
+    psprecomp::store32(state, entry + 4U, static_cast<std::uint32_t>(id));
+    adhoc_calls::write_mac(state, entry + 8U, socket->local);
+    psprecomp::store16(state, entry + 14U, socket->local_port);
+    psprecomp::store32(state, entry + 16U, static_cast<std::uint32_t>(waiting));
+  }
+  *size = static_cast<std::int32_t>(count * entry_size);
+  state.gpr[2] = 0U;
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
