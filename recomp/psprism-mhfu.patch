diff --git a/refract/src/stubs/net/adhoc_calls.hpp b/refract/src/stubs/net/adhoc_calls.hpp
new file mode 100644
index 0000000..2874553
--- /dev/null
+++ b/refract/src/stubs/net/adhoc_calls.hpp
@@ -0,0 +1,181 @@
+#pragma once
+
+// Helpers for the ad hoc calls (stubs/net): waiting the way the PSP's blocking calls do, and
+// the guest's addresses. Included by the stubs, inside runtime.cpp's namespace (which includes
+// adhoc_state.hpp and the standard headers at its top).
+
+namespace adhoc_calls {
+
+using adhoc_state::Mac;
+
+// With REFRACT_ADHOC_LOG set, prints the game's ad hoc calls: what it asked and what it got.
+inline bool logging() {
+  static const bool on = std::getenv("REFRACT_ADHOC_LOG") != nullptr;
+  return on;
+}
+
+[[gnu::format(printf, 1, 2)]] inline void log(const char* format, ...) {
+  if (!logging()) return;
+  va_list arguments;
+  va_start(arguments, format);
+  std::vfprintf(stderr, format, arguments);
+  va_end(arguments);
+}
+
+// With logging on, the PDP traffic summed up every 2 s (a line for each socket and direction)
+// rather than a line a packet, which would bury everything else: how many packets, how many of
+// them to everyone, their sizes, and the last player and port. `socket` 0 just prints what is due.
+inline void log_pdp(int socket, bool sent, const Mac& peer, std::uint16_t port, int bytes, bool broadcast) {
+  if (!logging()) return;
+  struct Totals {
+    unsigned packets{};
+    unsigned broadcasts{};
+    int smallest{};
+    int largest{};
+    Mac peer{};
+    std::uint16_t port{};
+  };
+  static std::mutex mutex;
+  static std::map<std::pair<int, bool>, Totals> totals;
+  static const auto started = std::chrono::steady_clock::now();
+  static auto printed = started;
+  std::lock_guard lock(mutex);
+  if (socket != 0) {
+    auto& total = totals[{socket, sent}];
+    total.smallest = total.packets == 0U ? bytes : std::min(total.smallest, bytes);
+    total.largest = total.packets == 0U ? bytes : std::max(total.largest, bytes);
+    ++total.packets;
+    if (broadcast) ++total.broadcasts;
+    total.peer = peer;
+    total.port = port;
+  }
+  const auto now = std::chrono::steady_clock::now();
+  if (now - printed < std::chrono::seconds(2) || totals.empty()) return;
+  printed = now;
+  const auto seconds = std::chrono::duration<double>(now - started).count();
+  for (const auto& [key, total] : totals)
+    std::fprintf(stderr, "[adhoc] %.1f s: PDP %d %s %u packets (%u to everyone), %d-%d bytes, last %s %02x:..:%02x port %u\n",
+                 seconds, key.first, key.second ? "sent" : "received", total.packets, total.broadcasts, total.smallest,
+                 total.largest, key.second ? "to" : "from", total.peer[0], total.peer[5], total.port);
+  totals.clear();
+}
+
+// Logs `text` when it differs from what the call logged last (for calls the game makes every frame).
+inline void log_change(std::string& last, const std::string& text) {
+  if (!logging() || text == last) return;
+  last = text;
+  std::fputs(text.c_str(), stderr);
+}
+
+// Calls `attempt` until it gives something other than would_block: once if `nonblock`, else until
+// `timeout_us` passes (0: no limit), letting the game's other threads run meanwhile. `attempt`
+// runs while they do, so it mustn't touch the game's memory.
+template <typename Attempt>
+std::uint32_t wait(Implementation& implementation, bool nonblock, std::uint32_t timeout_us, Attempt attempt) {
+  auto result = attempt();
+  if (result != adhoc_state::would_block || nonblock) return result;
+  const auto deadline = std::chrono::steady_clock::now() + std::chrono::microseconds(timeout_us);
+  GuestExecutionPause pause(implementation);
+  for (;;) {
+    {
+      std::unique_lock lock(implementation.exit_mutex);
+      if (implementation.exit_changed.wait_for(lock, std::chrono::milliseconds(1),
+                                               [&] { return implementation.exit_requested.load(); }))
+        return adhoc_state::thread_aborted;
+    }
+    result = attempt();
+    if (result != adhoc_state::would_block) return result;
+    if (timeout_us != 0U && std::chrono::steady_clock::now() >= deadline) return adhoc_state::timeout;
+  }
+}
+
+// Runs `work` (something that waits on the network) with the game's other threads running.
+template <typename Work>
+auto paused(Implementation& implementation, Work work) {
+  GuestExecutionPause pause(implementation);
+  return work();
+}
+
+inline bool read_mac(psprecomp::State& state, std::uint32_t address, Mac& mac) {
+  const auto* bytes = guest_pointer<std::array<std::uint8_t, 6>>(state, address);
+  if (bytes == nullptr) return false;
+  std::memcpy(mac.data(), bytes->data(), mac.size());
+  return true;
+}
+
+inline void write_mac(psprecomp::State& state, std::uint32_t address, const Mac& mac) {
+  if (auto* bytes = guest_pointer<std::array<std::uint8_t, 6>>(state, address))
+    std::memcpy(bytes->data(), mac.data(), mac.size());
+}
+
+inline bool is_broadcast(const Mac& mac) { return mac == refract::adhoc::broadcast_mac; }
+
+// The PDP socket's session with the relay, made again if the relay lost it: while in a group (so
+// the server answers), at most once a second.
+inline void* pdp_session(adhoc_state::Socket& socket) {
+  if (socket.pdp != nullptr && !pdp_is_dead(socket.pdp)) return socket.pdp;
+  if (socket.pdp != nullptr) pdp_delete(socket.pdp);
+  socket.pdp = nullptr;
+  const auto relay = refract::adhoc::relay_address();
+  const auto now = std::chrono::steady_clock::now();
+  if (!relay || refract::adhoc::control().state() != refract::adhoc::State::connected ||
+      now - socket.last_attempt < std::chrono::seconds(1))
+    return nullptr;
+  socket.last_attempt = now;
+  int status = 0;
+  socket.pdp = pdp_create_v4(&*relay, reinterpret_cast<const char*>(socket.local.data()),
+                             refract::adhoc::relay_port(socket.local_port), false, false, &status);
+  return socket.pdp;
+}
+
+// The PTP socket's listening session with the relay, made again if the relay lost it (as
+// pdp_session).
+inline void* listen_session(adhoc_state::Socket& socket) {
+  if (socket.listener != nullptr && !ptp_listen_is_dead(socket.listener)) return socket.listener;
+  if (socket.listener != nullptr) ptp_listen_close(socket.listener);
+  socket.listener = nullptr;
+  const auto relay = refract::adhoc::relay_address();
+  const auto now = std::chrono::steady_clock::now();
+  if (!relay || refract::adhoc::control().state() != refract::adhoc::State::connected ||
+      now - socket.last_attempt < std::chrono::seconds(1))
+    return nullptr;
+  socket.last_attempt = now;
+  int status = 0;
+  socket.listener = ptp_listen_v4(&*relay, reinterpret_cast<const char*>(socket.local.data()),
+                                  refract::adhoc::relay_port(socket.local_port), false, &status);
+  return socket.listener;
+}
+
+// Connects the PTP socket on a thread of its own: the relay answers once the other player
+// accepts, and refuses while they aren't listening yet, so it tries again for a while (as the
+// PSP resends). take_connection takes in the result.
+inline void start_connecting(const std::shared_ptr<adhoc_state::Socket>& socket) {
+  constexpr auto give_up_after = std::chrono::seconds(30);
+  socket->connecting = true;
+  std::thread([socket, give_up_after] {
+    const auto give_up = std::chrono::steady_clock::now() + give_up_after;
+    void* stream = nullptr;
+    while (!socket->closed && stream == nullptr && std::chrono::steady_clock::now() < give_up) {
+      const auto relay = refract::adhoc::relay_address();
+      if (relay) {
+        int status = 0;
+        stream = ptp_connect_v4(&*relay, reinterpret_cast<const char*>(socket->local.data()),
+                                refract::adhoc::relay_port(socket->local_port),
+                                reinterpret_cast<const char*>(socket->peer.data()),
+                                refract::adhoc::relay_port(socket->peer_port), false, &status);
+      }
+      if (stream == nullptr) std::this_thread::sleep_for(std::chrono::milliseconds(200));
+    }
+    {
+      std::lock_guard lock(socket->connect_mutex);
+      if (stream != nullptr && socket->closed) {
+        ptp_close(stream);
+        stream = nullptr;
+      }
+      socket->connected_stream = stream;
+      socket->connecting = false;
+    }
+  }).detach();
+}
+
+}  // namespace adhoc_calls
diff --git a/refract/src/stubs/net/adhoc_state.hpp b/refract/src/stubs/net/adhoc_state.hpp
