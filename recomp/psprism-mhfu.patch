+        switch (option) {
+            case ENET_SOCKOPT_ERROR:
+                len    = sizeof(int);
+                result = getsockopt(socket, SOL_SOCKET, SO_ERROR, (char *)value, &len);
+                break;
+
+            case ENET_SOCKOPT_TTL:
+                len = sizeof(int);
+                result = getsockopt(socket, IPPROTO_IP, IP_TTL, (char *)value, &len);
