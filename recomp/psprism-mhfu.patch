+++ b/refract/src/stubs/font/font_state.hpp
@@ -0,0 +1,49 @@
+#pragma once
+
+#if !defined(__PSP__)
+
+// Guest-side state for the sceLibFont replacement: font libraries and open fonts, keyed by
+// small guest allocations so their handles look like real pointers. Rendering and metrics
+// come from refract::font (src/font/font_engine.hpp).
+namespace font_state {
+
+constexpr std::uint32_t error_invalid_library = 0x80460002U;
+constexpr std::uint32_t error_invalid_parameter = 0x80460003U;
+constexpr std::uint32_t error_too_many_open_fonts = 0x80460009U;
+constexpr std::uint32_t default_alt_character = 0x5FU;  // '_', as on the firmware
+constexpr std::uint32_t handle_size = 16U;
+
+struct Library {
+  std::uint32_t max_fonts{};
+  std::uint32_t alt_character{default_alt_character};
+  float h_resolution{128.0F};
+  float v_resolution{128.0F};
+  std::uint32_t open_fonts{};
+};
+
+struct OpenFont {
+  std::uint32_t library{};
+  int index{};
+};
+
+inline std::mutex mutex;
+inline std::unordered_map<std::uint32_t, Library> libraries;
+inline std::unordered_map<std::uint32_t, OpenFont> fonts;
+
+inline void write_error(psprecomp::State& state, std::uint32_t address, std::uint32_t code) {
+  if (auto* error = guest_pointer<std::uint32_t>(state, address)) *error = code;
+}
+
+inline std::uint32_t allocate_handle(Implementation& implementation) {
+  std::lock_guard lock(implementation.objects_mutex);
+  return implementation.allocate_heap(handle_size);
+}
+
+inline void free_handle(Implementation& implementation, std::uint32_t handle) {
+  std::lock_guard lock(implementation.objects_mutex);
+  implementation.free_heap(handle, handle_size);
+}
+
+}  // namespace font_state
+
+#endif
diff --git a/refract/src/stubs/font/sceFontClose.cpp b/refract/src/stubs/font/sceFontClose.cpp
new file mode 100644
index 0000000..bf107c4
--- /dev/null
+++ b/refract/src/stubs/font/sceFontClose.cpp
@@ -0,0 +1,25 @@
+#include "font_state.hpp"
+
+// (font handle)
+void sceFontClose(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  const auto handle = state.gpr[4];
+  {
+    std::lock_guard lock(font_state::mutex);
+    const auto found = font_state::fonts.find(handle);
+    if (found == font_state::fonts.end()) {
+      state.gpr[2] = 0U;  // the firmware ignores unknown handles
+      return;
+    }
+    if (const auto library = font_state::libraries.find(found->second.library);
+        library != font_state::libraries.end() && library->second.open_fonts > 0U)
+      --library->second.open_fonts;
+    font_state::fonts.erase(found);
+  }
+  font_state::free_handle(implementation, handle);
+  state.gpr[2] = 0U;
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
