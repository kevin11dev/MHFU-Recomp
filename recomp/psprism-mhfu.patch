+// Headless host backend: no window, audio device or input hardware. Used to boot and trace
+// recompiled games on machines without a display (CI, servers).
+//
+// Environment variables:
+//   REFRACT_HEADLESS_FRAMES=N     exit after N presented frames (default: run until the guest exits)
+//   REFRACT_HEADLESS_DUMP=DIR     write CPU-presented frames to DIR as PPM images
+//   REFRACT_HEADLESS_DUMP_EVERY=N dump every Nth frame (default 60)
+//   REFRACT_HEADLESS_INPUT=SCRIPT press buttons on given frames: "FRAME:MASK[:LENGTH],..." with
+//                                 MASK in hex PSP button bits (START=8, CROSS=4000, CIRCLE=2000;
+//                                 bits 28 to 31 push the analog stick up, right, down and
+//                                 left, bits 24 to 27 the right stick)
+//   REFRACT_HEADLESS_WAV=FILE     record the mixed audio output to a WAV file
+#include "host.hpp"
+#include "audio_engine.hpp"
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <filesystem>
+#include <mutex>
+#include <string>
+#include <thread>
+#include <vector>
+
+namespace refract::host {
+namespace {
+
+constexpr std::uint32_t host_audio_sample_rate = 44100U;
+constexpr std::uint32_t host_audio_buffer_frames = 512U;
+
+std::atomic<bool> verbose_logging{};
+std::atomic<bool> frontend_exit_requested{};
+std::atomic<std::uint64_t> presented_frames{};
+std::atomic<std::uint64_t> primitives_this_frame{};
+std::atomic<std::uint64_t> primitives_total{};
+refract::ge::CacheMetricsAccumulator ge_cache_counters;
+
+std::uint64_t env_number(const char* name, std::uint64_t fallback) {
+  const auto* value = std::getenv(name);
+  return value == nullptr ? fallback : std::strtoull(value, nullptr, 0);
+}
+
+// Scripted controller input -------------------------------------------------
+
+struct InputStep {
+  std::uint64_t frame{};
+  std::uint32_t buttons{};
+  std::uint64_t length{};
+};
+
+std::vector<InputStep> parse_input_script() {
+  std::vector<InputStep> steps;
+  const auto* script = std::getenv("REFRACT_HEADLESS_INPUT");
+  if (script == nullptr) return steps;
+  std::string text = script;
+  std::size_t start = 0;
+  while (start < text.size()) {
+    auto end = text.find(',', start);
+    if (end == std::string::npos) end = text.size();
+    const auto item = text.substr(start, end - start);
+    InputStep step{};
+    char* cursor = nullptr;
+    step.frame = std::strtoull(item.c_str(), &cursor, 10);
+    if (cursor != nullptr && *cursor == ':') {
+      step.buttons = static_cast<std::uint32_t>(std::strtoul(cursor + 1, &cursor, 16));
+      step.length = 5U;
+      if (cursor != nullptr && *cursor == ':') step.length = std::strtoull(cursor + 1, nullptr, 10);
+      steps.push_back(step);
+    }
+    start = end + 1U;
+  }
+  return steps;
+}
+
+const std::vector<InputStep>& input_script() {
+  static const auto steps = parse_input_script();
+  return steps;
+}
+
+// Audio: a virtual sound card that drains the mixer in real time ----------
+
+struct AudioOutput {
+  AudioEngine engine;
+  std::mutex configuration_mutex;
+  std::thread worker;
+  std::atomic<bool> running{};
+  bool shut_down{};  // at exit: game threads still sending sound don't start it again
+  std::FILE* wav{};
+  std::uint32_t wav_frames{};
+
+  ~AudioOutput() { stop(); }
+
+  void start() {
+    std::lock_guard lock(configuration_mutex);
+    if (running.load() || shut_down) return;
+    if (const auto* path = std::getenv("REFRACT_HEADLESS_WAV")) {
+      wav = std::fopen(path, "wb");
+      if (wav != nullptr) write_wav_header();
+    }
+    running.store(true);
+    worker = std::thread([this] { drain(); });
+  }
+
+  void stop() {
+    // Joined under the lock, so start() can't put a new thread in its place meanwhile.
+    std::lock_guard lock(configuration_mutex);
+    shut_down = true;
+    if (!running.exchange(false)) return;
+    if (worker.joinable()) worker.join();
+    if (wav != nullptr) {
+      write_wav_header();
+      std::fclose(wav);
+      wav = nullptr;
+    }
+  }
+
+  void drain() {
+    std::array<std::int16_t, host_audio_buffer_frames * 2U> samples{};
+    const auto period = std::chrono::microseconds(
+        1000000ULL * host_audio_buffer_frames / host_audio_sample_rate);
+    auto next = std::chrono::steady_clock::now();
+    while (running.load(std::memory_order_relaxed)) {
+      engine.consume(samples.data(), host_audio_buffer_frames);
+      if (wav != nullptr) {
+        std::fwrite(samples.data(), sizeof(std::int16_t), samples.size(), wav);
+        wav_frames += host_audio_buffer_frames;
+      }
+      next += period;
+      std::this_thread::sleep_until(next);
+    }
+  }
+
+  void write_wav_header() {
+    const std::uint32_t data_bytes = wav_frames * 4U;
+    const std::uint32_t riff_bytes = 36U + data_bytes;
+    const std::uint32_t format_bytes = 16U, rate = host_audio_sample_rate,
+                        byte_rate = rate * 4U;
+    const std::uint16_t pcm = 1U, channels = 2U, block_align = 4U, bits = 16U;
+    std::fseek(wav, 0, SEEK_SET);
+    std::fwrite("RIFF", 1, 4, wav);
+    std::fwrite(&riff_bytes, 4, 1, wav);
+    std::fwrite("WAVEfmt ", 1, 8, wav);
+    std::fwrite(&format_bytes, 4, 1, wav);
+    std::fwrite(&pcm, 2, 1, wav);
+    std::fwrite(&channels, 2, 1, wav);
+    std::fwrite(&rate, 4, 1, wav);
+    std::fwrite(&byte_rate, 4, 1, wav);
+    std::fwrite(&block_align, 2, 1, wav);
+    std::fwrite(&bits, 2, 1, wav);
+    std::fwrite("data", 1, 4, wav);
+    std::fwrite(&data_bytes, 4, 1, wav);
+    std::fseek(wav, 0, SEEK_END);
+  }
+};
+
+AudioOutput& audio_output() {
+  static AudioOutput value;
+  return value;
+}
+
+std::uint32_t backend_queued_audio_frames(std::uint32_t channel) {
+  return audio_output().engine.queued_frames(channel);
+}
+void backend_reset_audio_channel(std::uint32_t channel) {
+  audio_output().engine.reset_channel(channel);
+}
+AudioTelemetry backend_audio_telemetry() { return audio_output().engine.telemetry(); }
+std::uint64_t backend_audio_clock_frames() { return audio_output().engine.clock_frames(); }
+
+// Frames ---------------------------------------------------------------------
+
+std::uint8_t expand(std::uint32_t value, std::uint32_t bits) {
+  return static_cast<std::uint8_t>(value * 255U / ((1U << bits) - 1U));
+}
+
+void dump_frame(const std::uint8_t* pixels, std::uint32_t stride, std::uint32_t width,
+                std::uint32_t height, std::uint32_t format, std::uint64_t frame) {
+  const auto* directory = std::getenv("REFRACT_HEADLESS_DUMP");
+  if (directory == nullptr) return;
+  const auto every = env_number("REFRACT_HEADLESS_DUMP_EVERY", 60U);
+  if (every == 0U || frame % every != 0U) return;
+  std::filesystem::create_directories(directory);
+  char name[64];
+  std::snprintf(name, sizeof(name), "/frame_%06llu.ppm", static_cast<unsigned long long>(frame));
+  auto* file = std::fopen((std::string(directory) + name).c_str(), "wb");
+  if (file == nullptr) return;
+  std::fprintf(file, "P6\n%u %u\n255\n", width, height);
+  const auto bytes_per_pixel = format == 3U ? 4U : 2U;
+  std::vector<std::uint8_t> row(static_cast<std::size_t>(width) * 3U);
+  for (std::uint32_t y = 0; y < height; ++y) {
+    for (std::uint32_t x = 0; x < width; ++x) {
+      const auto* p = pixels + (static_cast<std::size_t>(y) * stride + x) * bytes_per_pixel;
+      std::uint8_t r{}, g{}, b{};
+      if (format == 3U) {
+        r = p[0], g = p[1], b = p[2];
+      } else {
+        const std::uint32_t v = p[0] | (p[1] << 8U);
+        if (format == 0U) r = expand(v & 31U, 5), g = expand((v >> 5U) & 63U, 6), b = expand((v >> 11U) & 31U, 5);
+        else if (format == 1U) r = expand(v & 31U, 5), g = expand((v >> 5U) & 31U, 5), b = expand((v >> 10U) & 31U, 5);
+        else r = expand(v & 15U, 4), g = expand((v >> 4U) & 15U, 4), b = expand((v >> 8U) & 15U, 4);
+      }
+      row[x * 3U] = r, row[x * 3U + 1U] = g, row[x * 3U + 2U] = b;
+    }
+    std::fwrite(row.data(), 1, row.size(), file);
+  }
+  std::fclose(file);
+}
+
+// Dialogs: accepted automatically after a short delay ------------------------
+
+std::mutex dialog_mutex;
+std::optional<DialogModel> pending_dialog;
+std::uint32_t pending_dialog_polls{};
+
+} // namespace
+
+bool submit_audio(const std::int16_t* interleaved_stereo, std::uint32_t frame_count,
+                  std::uint32_t channel, bool blocking, std::uint32_t sample_rate) {
+  if (interleaved_stereo == nullptr || frame_count == 0U ||
+      sample_rate != host_audio_sample_rate || channel >= AudioEngine::channel_count)
+    return false;
+  auto& output = audio_output();
+  set_audio_queue_callbacks(backend_queued_audio_frames, backend_reset_audio_channel);
+  set_audio_telemetry_callback(backend_audio_telemetry);
+  set_audio_clock_frames_callback(backend_audio_clock_frames);
+  output.start();
+  const auto timeout = std::chrono::microseconds(
+      audio_callback_timeout_microseconds(frame_count, sample_rate));
+  return output.engine.submit(interleaved_stereo, frame_count, channel, blocking, timeout) ==
+         AudioEngine::SubmitResult::submitted;
+}
+
+void shutdown_audio() {
+  auto& output = audio_output();
+  output.stop();
+  output.engine.reset();
+}
+
+void set_verbose_logging(bool enabled) { verbose_logging.store(enabled, std::memory_order_relaxed); }
+
+void initialize_frontend() {}
+
+void run_event_loop() {
+  const auto limit = env_number("REFRACT_HEADLESS_FRAMES", 0U);
+  std::uint64_t reported = 0;
+  auto last_report = std::chrono::steady_clock::now();
+  while (!frontend_exit_requested.load(std::memory_order_relaxed)) {
+    std::this_thread::sleep_for(std::chrono::milliseconds(50));
+    const auto frames = presented_frames.load(std::memory_order_relaxed);
+    const auto now = std::chrono::steady_clock::now();
+    if (now - last_report >= std::chrono::seconds(5)) {
+      std::fprintf(stderr, "[headless] %llu frames presented (+%llu), %llu primitives total, audio clock %llu frames\n",
+                   static_cast<unsigned long long>(frames),
+                   static_cast<unsigned long long>(frames - reported),
+                   static_cast<unsigned long long>(primitives_total.load()),
+                   static_cast<unsigned long long>(audio_clock_frames()));
+      reported = frames;
+      last_report = now;
+    }
+    if (limit != 0U && frames >= limit) break;
+  }
+  shutdown_audio();
+}
+
+void request_frontend_exit() { frontend_exit_requested.store(true, std::memory_order_relaxed); }
+
+void present_frame(const std::uint8_t* pixels, std::uint32_t stride, std::uint32_t width,
+                   std::uint32_t height, std::uint32_t format, std::uint32_t address) {
+  (void)address;
+  if (pixels == nullptr || width == 0U || height == 0U) return;
+  dump_frame(pixels, stride, width, height, format, presented_frames.load());
+  present_ge_frame();
+}
+
+void present_ge_frame() { presented_frames.fetch_add(1U, std::memory_order_relaxed); }
+
+void begin_ge_frame() { primitives_this_frame.store(0U, std::memory_order_relaxed); }
+
+void end_ge_frame() {}
+
+void submit_ge_primitive(std::uint32_t type, std::vector<GeometryVertex> vertices,
+                         std::shared_ptr<const std::vector<std::uint8_t>> texture,
+                         std::uint32_t texture_width, std::uint32_t texture_height,
+                         GeometryState graphics_state) {
+  (void)type, (void)vertices, (void)texture, (void)texture_width, (void)texture_height,
+      (void)graphics_state;
+  primitives_this_frame.fetch_add(1U, std::memory_order_relaxed);
+  primitives_total.fetch_add(1U, std::memory_order_relaxed);
+}
+
+ControllerState controller_state() {
+  ControllerState result;
+  const auto frame = presented_frames.load(std::memory_order_relaxed);
+  for (const auto& step : input_script())
+    if (frame >= step.frame && frame < step.frame + step.length) result.buttons |= step.buttons;
+  // Bits 28 to 31 push the analog stick up, right, down and left, bits 24 to 27 the right stick.
+  const auto horizontal = ((result.buttons & 0x20000000U) != 0U ? 1 : 0) -
+                          ((result.buttons & 0x80000000U) != 0U ? 1 : 0);
+  const auto vertical = ((result.buttons & 0x40000000U) != 0U ? 1 : 0) -
+                        ((result.buttons & 0x10000000U) != 0U ? 1 : 0);
+  result.analog_x = static_cast<std::uint8_t>(128 + horizontal * 127);
+  result.analog_y = static_cast<std::uint8_t>(128 + vertical * 127);
+  result.right_x = static_cast<float>(((result.buttons & 0x02000000U) != 0U ? 1 : 0) -
+                                      ((result.buttons & 0x08000000U) != 0U ? 1 : 0));
+  result.right_y = static_cast<float>(((result.buttons & 0x04000000U) != 0U ? 1 : 0) -
+                                      ((result.buttons & 0x01000000U) != 0U ? 1 : 0));
+  result.buttons &= 0x00ffffffU;
+  return result;
+}
+
+void present_dialog(DialogModel model) {
+  std::fprintf(stderr, "[headless] dialog %llu (kind %d): %s | %s\n",
+               static_cast<unsigned long long>(model.id), static_cast<int>(model.kind),
+               model.title.c_str(), model.message.c_str());
+  std::lock_guard lock(dialog_mutex);
+  pending_dialog = std::move(model);
+  pending_dialog_polls = 0;
+}
+
+std::optional<DialogResult> poll_dialog_result(std::uint64_t id) {
+  std::lock_guard lock(dialog_mutex);
+  if (!pending_dialog || pending_dialog->id != id) return std::nullopt;
+  if (++pending_dialog_polls < 30U) return std::nullopt;
+  DialogResult result;
+  result.id = id;
+  result.affirmative = !pending_dialog->default_no;
+  result.selected_item = pending_dialog->selected_item;
+  for (const auto& field : pending_dialog->fields) result.field_text.push_back(field.text);
+  pending_dialog.reset();
+  return result;
+}
+
+void dismiss_dialog(std::uint64_t id) {
+  std::lock_guard lock(dialog_mutex);
+  if (pending_dialog && pending_dialog->id == id) pending_dialog.reset();
+}
+
+bool dialog_visible() {
+  std::lock_guard lock(dialog_mutex);
+  return pending_dialog.has_value();
+}
+
+ge::CacheMetrics ge_cache_metrics() { return ge_cache_counters.snapshot(); }
+
+void reset_ge_cache_metrics() { ge_cache_counters.reset(); }
+
