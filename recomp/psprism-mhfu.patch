+    // What the server sent.
+    for (;;) {
+      adhocctl_event event{};
+      adhocctl_get_event(session, &event);
+      if (event.type == ADHOCCTL_CLIENT_EVENT_WOULD_BLOCK) break;
+      if (event.type == ADHOCCTL_CLIENT_EVENT_ERROR) {
+        std::fprintf(stderr, "[adhoc] lost the server %s\n", own.server.c_str());
+        lose();
+        break;
+      }
+      std::lock_guard lock(mutex_);
+      switch (event.type) {
+        case ADHOCCTL_CLIENT_EVENT_SCAN: {
+          Group group;
+          std::memcpy(group.name.data(), event.scan.group_name, group.name.size());
+          std::memcpy(group.leader.data(), event.scan.leader_mac, group.leader.size());
+          groups_.push_back(group);
+          break;
+        }
+        case ADHOCCTL_CLIENT_EVENT_SCAN_COMPLETE:
+          if (logging()) std::fprintf(stderr, "[adhoc] scanned: %zu groups\n", groups_.size());
+          if (state_ == State::scanning) {
+            state_ = State::disconnected;
+            post(Event::scanned);
+          }
+          break;
+        case ADHOCCTL_CLIENT_EVENT_CONNECT: {
+          Peer peer;
+          std::memcpy(peer.mac.data(), event.connect.mac, peer.mac.size());
+          peer.nickname.assign(event.connect.nickname, strnlen(event.connect.nickname, 127));
+          peer.id = event.connect.id;
+          std::erase_if(peers_, [&](const Peer& known) { return known.mac == peer.mac; });
+          if (peer.mac != own.mac) peers_.push_back(peer);
+          if (logging())
+            std::fprintf(stderr, "[adhoc] %s (%s) is in the group\n", peer.nickname.c_str(),
+                         mac_text(peer.mac.data()).c_str());
+          break;
+        }
+        case ADHOCCTL_CLIENT_EVENT_LEADER_MAC:
+          if (connecting) {
+            connecting = false;
+            state_ = State::connected;
+            post(Event::connected);
+            if (logging()) std::fprintf(stderr, "[adhoc] joined %s\n", group_text(group_).c_str());
+          }
+          break;
+        case ADHOCCTL_CLIENT_EVENT_DISCONNECT:
+          std::erase_if(peers_, [&](const Peer& peer) { return peer.id == event.disconnect.id; });
+          break;
+        default:
+          break;
+      }
+    }
+    if (session == nullptr) continue;
+
+    if (now - last_ping >= ping_interval) {
+      if (adhocctl_ping(session) == ADHOCCTL_CALL_ERROR) {
+        lose();
+        continue;
+      }
+      last_ping = now;
+    }
+    std::this_thread::sleep_for(poll_interval);
+  }
+  if (session != nullptr) {
+    adhocctl_disconnect(session);
+    destroy_adhocctl_session(session);
+  }
+}
