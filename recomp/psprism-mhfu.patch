+// The stages and accesses of an image in a layout, for barriers into and out of it.
+struct LayoutUse {
+  VkPipelineStageFlags stages;
+  VkAccessFlags access;
+};
+
+LayoutUse layout_use(VkImageLayout layout) {
+  switch (layout) {
+    case VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL:
+      return {VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT,
+              VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT};
+    case VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL:
+      return {VK_PIPELINE_STAGE_EARLY_FRAGMENT_TESTS_BIT | VK_PIPELINE_STAGE_LATE_FRAGMENT_TESTS_BIT,
+              VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_READ_BIT | VK_ACCESS_DEPTH_STENCIL_ATTACHMENT_WRITE_BIT};
+    case VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL:
+      return {VK_PIPELINE_STAGE_FRAGMENT_SHADER_BIT, VK_ACCESS_SHADER_READ_BIT};
+    case VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL: return {VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_READ_BIT};
+    case VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL: return {VK_PIPELINE_STAGE_TRANSFER_BIT, VK_ACCESS_TRANSFER_WRITE_BIT};
+    case VK_IMAGE_LAYOUT_PRESENT_SRC_KHR: return {VK_PIPELINE_STAGE_BOTTOM_OF_PIPE_BIT, 0U};
+    default: return {VK_PIPELINE_STAGE_TOP_OF_PIPE_BIT, 0U};
+  }
+}
+
+VkCompareOp compare_op(std::uint32_t function) {
+  constexpr VkCompareOp ops[] = {VK_COMPARE_OP_NEVER, VK_COMPARE_OP_ALWAYS,  VK_COMPARE_OP_EQUAL,
+                                 VK_COMPARE_OP_NOT_EQUAL, VK_COMPARE_OP_LESS, VK_COMPARE_OP_LESS_OR_EQUAL,
+                                 VK_COMPARE_OP_GREATER, VK_COMPARE_OP_GREATER_OR_EQUAL};
+  return ops[std::min(function, 7U)];
+}
+
+VkStencilOp stencil_op(std::uint32_t operation) {
+  switch (operation) {
+    case 1U: return VK_STENCIL_OP_ZERO;
+    case 2U: return VK_STENCIL_OP_REPLACE;
+    case 3U: return VK_STENCIL_OP_INVERT;
+    case 4U: return VK_STENCIL_OP_INCREMENT_AND_CLAMP;
+    case 5U: return VK_STENCIL_OP_DECREMENT_AND_CLAMP;
+    default: return VK_STENCIL_OP_KEEP;
+  }
+}
+
+VkBlendFactor blend_factor(Blend factor) {
+  switch (factor) {
+    case Blend::zero: return VK_BLEND_FACTOR_ZERO;
+    case Blend::one: return VK_BLEND_FACTOR_ONE;
+    case Blend::source_color: return VK_BLEND_FACTOR_SRC_COLOR;
+    case Blend::one_minus_source_color: return VK_BLEND_FACTOR_ONE_MINUS_SRC_COLOR;
+    case Blend::destination_color: return VK_BLEND_FACTOR_DST_COLOR;
+    case Blend::one_minus_destination_color: return VK_BLEND_FACTOR_ONE_MINUS_DST_COLOR;
+    case Blend::source_alpha: return VK_BLEND_FACTOR_SRC_ALPHA;
+    case Blend::one_minus_source_alpha: return VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+    case Blend::destination_alpha: return VK_BLEND_FACTOR_DST_ALPHA;
+    case Blend::one_minus_destination_alpha: return VK_BLEND_FACTOR_ONE_MINUS_DST_ALPHA;
+    case Blend::constant_color: return VK_BLEND_FACTOR_CONSTANT_COLOR;
+  }
+  return VK_BLEND_FACTOR_ONE;
+}
+
+VkBlendOp blend_op(std::uint32_t operation) {
+  switch (operation) {
+    case 1U: return VK_BLEND_OP_SUBTRACT;
+    case 2U: return VK_BLEND_OP_REVERSE_SUBTRACT;
+    case 3U: return VK_BLEND_OP_MIN;
+    case 4U: return VK_BLEND_OP_MAX;
+    default: return VK_BLEND_OP_ADD;
+  }
+}
+
+// The fields of a pipeline that it depends on, packed (what a disabled stage leaves is left out).
+std::uint64_t pipeline_key(const Pipeline& pipeline) {
+  std::uint64_t key = pipeline.primitive & 7U;
+  key |= static_cast<std::uint64_t>(pipeline.color_mask & 0xfU) << 3U;
+  if (pipeline.cull) key |= 1ULL << 7U | static_cast<std::uint64_t>(pipeline.front_clockwise) << 8U;
+  if (pipeline.blend)
+    key |= 1ULL << 9U | static_cast<std::uint64_t>(pipeline.blend_source) << 10U |
+           static_cast<std::uint64_t>(pipeline.blend_destination) << 14U |
+           static_cast<std::uint64_t>(pipeline.blend_operation & 7U) << 18U;
+  if (pipeline.depth)
+    key |= 1ULL << 21U | static_cast<std::uint64_t>(pipeline.depth_function & 7U) << 22U |
+           static_cast<std::uint64_t>(pipeline.depth_write) << 25U;
+  if (pipeline.stencil)
+    key |= 1ULL << 26U | static_cast<std::uint64_t>(pipeline.stencil_function & 7U) << 27U |
+           static_cast<std::uint64_t>(pipeline.stencil_fail & 7U) << 30U |
+           static_cast<std::uint64_t>(pipeline.stencil_depth_fail & 7U) << 33U |
+           static_cast<std::uint64_t>(pipeline.stencil_pass & 7U) << 36U;
+  return key;
+}
+
+// The pipeline a key stands for (keys saved by an earlier run), if it's one.
+std::optional<Pipeline> pipeline_from_key(std::uint64_t key) {
+  Pipeline pipeline;
+  pipeline.primitive = static_cast<std::uint8_t>(key & 7U);
+  pipeline.color_mask = static_cast<std::uint8_t>((key >> 3U) & 0xfU);
+  pipeline.cull = ((key >> 7U) & 1U) != 0U;
+  if (pipeline.cull) pipeline.front_clockwise = ((key >> 8U) & 1U) != 0U;
+  pipeline.blend = ((key >> 9U) & 1U) != 0U;
+  if (pipeline.blend) {
+    pipeline.blend_source = static_cast<Blend>((key >> 10U) & 0xfU);
+    pipeline.blend_destination = static_cast<Blend>((key >> 14U) & 0xfU);
+    pipeline.blend_operation = static_cast<std::uint8_t>((key >> 18U) & 7U);
+  }
+  pipeline.depth = ((key >> 21U) & 1U) != 0U;
+  if (pipeline.depth) {
+    pipeline.depth_function = static_cast<std::uint8_t>((key >> 22U) & 7U);
+    pipeline.depth_write = ((key >> 25U) & 1U) != 0U;
+  }
+  pipeline.stencil = ((key >> 26U) & 1U) != 0U;
+  if (pipeline.stencil) {
+    pipeline.stencil_function = static_cast<std::uint8_t>((key >> 27U) & 7U);
+    pipeline.stencil_fail = static_cast<std::uint8_t>((key >> 30U) & 7U);
+    pipeline.stencil_depth_fail = static_cast<std::uint8_t>((key >> 33U) & 7U);
+    pipeline.stencil_pass = static_cast<std::uint8_t>((key >> 36U) & 7U);
+  }
+  if (pipeline.primitive > 4U || static_cast<std::uint8_t>(pipeline.blend_source) > 10U ||
+      static_cast<std::uint8_t>(pipeline.blend_destination) > 10U || pipeline_key(pipeline) != key)
+    return std::nullopt;
+  return pipeline;
+}
