+// Buttons still held when the keyboard closed; the game sees them again once released.
+std::atomic_uint32_t suppressed_buttons{};
+
+std::string to_utf8(const std::u16string& text) {
+  std::string result;
+  for (std::size_t i = 0; i < text.size(); ++i) {
+    std::uint32_t code = text[i];
+    if (code >= 0xd800U && code < 0xdc00U && i + 1U < text.size())
+      code = 0x10000U + ((code - 0xd800U) << 10U) + (static_cast<std::uint32_t>(text[++i]) - 0xdc00U);
+    if (code < 0x80U) {
+      result += static_cast<char>(code);
+    } else if (code < 0x800U) {
+      result += static_cast<char>(0xc0U | code >> 6U);
+      result += static_cast<char>(0x80U | (code & 63U));
+    } else if (code < 0x10000U) {
+      result += static_cast<char>(0xe0U | code >> 12U);
+      result += static_cast<char>(0x80U | (code >> 6U & 63U));
+      result += static_cast<char>(0x80U | (code & 63U));
+    } else {
+      result += static_cast<char>(0xf0U | code >> 18U);
+      result += static_cast<char>(0x80U | (code >> 12U & 63U));
+      result += static_cast<char>(0x80U | (code >> 6U & 63U));
+      result += static_cast<char>(0x80U | (code & 63U));
+    }
+  }
+  return result;
+}
+
+std::uint32_t held_buttons() {
+  return keyboard_buttons.load(std::memory_order_relaxed) |
+         controller_buttons.load(std::memory_order_relaxed) |
+         scripted_buttons(presented_frames.load(std::memory_order_relaxed));
+}
+
+// The functions below run on the window thread with dialog_mutex held.
+
+int osk_wide_key(int column) {
+  for (int key = 0; key < 3; ++key)
+    if (column < osk_wide_keys[key].first_column + osk_wide_keys[key].columns) return key;
+  return osk_done;
+}
+
+void osk_type(OskSession& session, std::uint32_t code) {
+  if (code < 0x20U || code == 0x7fU || code > 0xffffU || (code >= 0xd800U && code < 0xe000U)) return;
+  if (session.limit != 0U && session.text.size() >= session.limit) return;
+  session.text.push_back(static_cast<char16_t>(code));
+}
+
+void osk_erase(OskSession& session) {
+  if (!session.text.empty()) session.text.pop_back();
+}
+
+void osk_finish(bool cancelled) {
+  DialogResult result;
+  result.id = osk->id;
+  result.cancelled = cancelled;
+  result.affirmative = !cancelled;
+  result.field_text = osk->original;
+  if (!cancelled && !result.field_text.empty()) result.field_text[0] = osk->text;
+  osk_result = std::move(result);
+  osk.reset();
+  osk_visible.store(false);
+  suppressed_buttons.store(held_buttons());
+}
+
+void osk_move(OskSession& session, int right, int down) {
+  constexpr int rows = osk_character_rows + 1;
+  if (down != 0) session.row = (session.row + down + rows) % rows;
+  if (right == 0) return;
+  if (session.row == osk_character_rows) {
+    const auto key = (osk_wide_key(session.column) + right + 3) % 3;
+    session.column = osk_wide_keys[key].first_column + osk_wide_keys[key].columns / 2;
+  } else {
+    session.column = (session.column + right + osk_columns) % osk_columns;
+  }
+}
+
+// Returns false once the keyboard has closed.
+bool osk_press_selected(OskSession& session) {
+  if (session.row < osk_character_rows) {
+    osk_type(session, static_cast<unsigned char>(
+                          osk_characters[session.row][static_cast<std::size_t>(session.column)]));
+    return true;
+  }
+  switch (osk_wide_key(session.column)) {
+    case osk_space: osk_type(session, ' '); return true;
+    case osk_delete: osk_erase(session); return true;
+    default: osk_finish(false); return false;
+  }
+}
+
+void osk_handle_pad(std::uint32_t pad) {
+  auto& session = *osk;
+  const auto pressed = pad & ~session.previous_pad;
+  session.previous_pad = pad;
+  constexpr auto directions = psp_up | psp_down | psp_left | psp_right;
+  const auto now = SDL_GetTicks();
+  auto direction = pressed & directions;
+  if (direction != 0U) {
+    session.repeat_direction = direction;
+    session.repeat_at = now + 400U;
+  } else if ((pad & session.repeat_direction) == 0U) {
+    session.repeat_direction = 0U;
+  } else if (now >= session.repeat_at) {
+    direction = pad & session.repeat_direction;
+    session.repeat_at = now + 90U;
+  }
+  if ((direction & psp_up) != 0U) osk_move(session, 0, -1);
+  if ((direction & psp_down) != 0U) osk_move(session, 0, 1);
+  if ((direction & psp_left) != 0U) osk_move(session, -1, 0);
+  if ((direction & psp_right) != 0U) osk_move(session, 1, 0);
+  const auto confirm = session.confirm_with_cross ? psp_cross : psp_circle;
+  const auto back = session.confirm_with_cross ? psp_circle : psp_cross;
+  if ((pressed & confirm) != 0U) {
+    osk_press_selected(session);
+  } else if ((pressed & back) != 0U) {
+    osk_erase(session);
+  } else if ((pressed & psp_triangle) != 0U) {
+    osk_type(session, ' ');
+  } else if ((pressed & psp_start) != 0U) {
+    osk_finish(false);
+  } else if ((pressed & psp_select) != 0U) {
+    osk_finish(true);
+  }
+}
+
+void osk_handle_key(SDL_Keycode key) {
+  auto& session = *osk;
+  switch (key) {
+    case SDLK_BACKSPACE: osk_erase(session); break;
+    case SDLK_RETURN:
+    case SDLK_KP_ENTER: osk_finish(false); break;
+    case SDLK_ESCAPE: osk_finish(true); break;
+    case SDLK_UP: osk_move(session, 0, -1); break;
+    case SDLK_DOWN: osk_move(session, 0, 1); break;
+    case SDLK_LEFT: osk_move(session, -1, 0); break;
+    case SDLK_RIGHT: osk_move(session, 1, 0); break;
+    default: break;
+  }
+}
+
+void osk_handle_text(std::string_view text) {
+  auto& session = *osk;
+  for (std::size_t at = 0; at < text.size();) {
+    const auto lead = static_cast<std::uint8_t>(text[at++]);
+    int extra = lead >= 0xf0U ? 3 : lead >= 0xe0U ? 2 : lead >= 0xc0U ? 1 : 0;
+    std::uint32_t code = extra == 3 ? lead & 7U : extra == 2 ? lead & 15U : extra == 1 ? lead & 31U : lead;
+    for (; extra > 0 && at < text.size(); --extra)
+      code = code << 6U | (static_cast<std::uint8_t>(text[at++]) & 63U);
+    osk_type(session, code);
+  }
+}
+
+// FPS counter -----------------------------------------------------------------------
+//
+// How often the game shows a new frame (each sceDisplaySetFrameBuf), in the top-left corner.
+
+std::atomic_bool fps_counter_shown{};
+std::atomic_uint64_t display_flips{};
+
+void draw_fps_counter(double rate, double drawing_ms);
+
+// Drawing ---------------------------------------------------------------------------
+
+std::vector<std::uint8_t> osk_canvas(static_cast<std::size_t>(osk_canvas_width) * osk_canvas_height * 4U);
+// The FPS counter has its own canvas, drawn over the game (and over the keyboard).
+std::vector<std::uint8_t> fps_canvas(osk_canvas.size());
+std::vector<std::uint8_t>* active_canvas = &osk_canvas;  // what the canvas_ helpers draw into
+
+void canvas_fill(int left, int top, int right, int bottom, std::uint32_t abgr) {
+  const auto alpha = (abgr >> 24U) & 0xffU;
+  left = std::max(left, 0);
+  top = std::max(top, 0);
+  right = std::min(right, osk_canvas_width);
+  bottom = std::min(bottom, osk_canvas_height);
+  for (int y = top; y < bottom; ++y) {
+    auto* pixel = &(*active_canvas)[(static_cast<std::size_t>(y) * osk_canvas_width + static_cast<std::size_t>(left)) * 4U];
+    for (int x = left; x < right; ++x, pixel += 4) {
+      for (int channel = 0; channel < 3; ++channel) {
+        const auto source = (abgr >> (channel * 8)) & 0xffU;
+        pixel[channel] = static_cast<std::uint8_t>((source * alpha + pixel[channel] * (255U - alpha)) / 255U);
+      }
+      pixel[3] = static_cast<std::uint8_t>(alpha + pixel[3] * (255U - alpha) / 255U);
+    }
+  }
+}
+
+void canvas_frame(int left, int top, int right, int bottom, int width, std::uint32_t abgr) {
+  canvas_fill(left, top, right, top + width, abgr);
+  canvas_fill(left, bottom - width, right, bottom, abgr);
+  canvas_fill(left, top + width, left + width, bottom - width, abgr);
+  canvas_fill(right - width, top + width, right, bottom - width, abgr);
+}
+
+int canvas_text(int x, int baseline, float size, std::string_view text, std::uint32_t abgr, bool bold = false) {
+  return refract::font::draw_ui_text(active_canvas->data(), osk_canvas_width, osk_canvas_height, x, baseline,
+                                     size, text, abgr, bold);
+}
+
+void canvas_centered_text(int left, int right, int baseline, float size, std::string_view text,
+                          std::uint32_t abgr, bool bold = false) {
+  const auto width = refract::font::measure_ui_text(size, text, bold);
+  canvas_text(left + (right - left - width) / 2, baseline, size, text, abgr, bold);
+}
+
+// The game's frames a second, and how long drawing a picture takes the renderer (its share of a
+// frame: when it's most of one, drawing holds the game up).
+void draw_fps_counter(double rate, double drawing_ms) {
+  active_canvas = &fps_canvas;
+  std::fill(fps_canvas.begin(), fps_canvas.end(), std::uint8_t{0});
+  char text[48];
+  std::snprintf(text, sizeof(text), "%.0f fps, drawing %.0f ms", rate, drawing_ms);
+  const auto width = refract::font::measure_ui_text(22.0F, text, true);
+  canvas_fill(8, 8, 8 + width + 20, 42, 0xa0000000U);
+  canvas_text(18, 33, 22.0F, text, 0xffffffffU, true);
+  active_canvas = &osk_canvas;
+}
+
+void draw_osk(const OskSession& session, bool cursor_shown) {
+  constexpr std::uint32_t white = 0xffffffffU;
+  constexpr std::uint32_t grey = 0xffb4aaa0U;
+  constexpr std::uint32_t key_colour = 0xff3a3028U;
+  constexpr std::uint32_t selected_colour = 0xff2f9e4aU;
+  std::fill(osk_canvas.begin(), osk_canvas.end(), std::uint8_t{0});
+  canvas_fill(0, 0, osk_canvas_width, osk_canvas_height, 0x99000000U);
+  canvas_fill(90, 30, 870, 516, 0xf2241c18U);
+  canvas_frame(90, 30, 870, 516, 2, 0xff7a6a5aU);
+  canvas_text(120, 74, 26.0F, session.prompt, white, true);
+
+  canvas_fill(120, 92, 840, 152, 0xff0e0b09U);
+  canvas_frame(120, 92, 840, 152, 2, 0xffc0a080U);
+  const auto text = to_utf8(session.text);
+  const auto end = 136 + canvas_text(136, 134, 32.0F, text, white);
+  if (cursor_shown) canvas_fill(end + 2, 104, end + 5, 142, white);
+  if (session.limit != 0U) {
+    const auto count = std::to_string(session.text.size()) + " / " + std::to_string(session.limit);
+    const auto width = refract::font::measure_ui_text(20.0F, count);
+    canvas_text(826 - width, 130, 20.0F, count, grey);
+  }
+
+  constexpr int key_width = 52;
+  constexpr int key_height = 40;
+  constexpr int pitch_x = 58;
+  constexpr int pitch_y = 46;
+  constexpr int grid_left = (osk_canvas_width - (osk_columns * pitch_x - (pitch_x - key_width))) / 2;
+  constexpr int grid_top = 172;
+  for (int row = 0; row < osk_character_rows; ++row) {
+    for (int column = 0; column < osk_columns; ++column) {
+      const auto left = grid_left + column * pitch_x;
+      const auto top = grid_top + row * pitch_y;
+      const bool selected = session.row == row && session.column == column;
+      canvas_fill(left, top, left + key_width, top + key_height, selected ? selected_colour : key_colour);
+      const char label[2] = {osk_characters[row][static_cast<std::size_t>(column)], '\0'};
+      canvas_centered_text(left, left + key_width, top + 29, 24.0F, label, white, selected);
+    }
+  }
+  const auto selected_wide = session.row == osk_character_rows ? osk_wide_key(session.column) : -1;
+  for (int key = 0; key < 3; ++key) {
+    const auto& wide = osk_wide_keys[key];
+    const auto left = grid_left + wide.first_column * pitch_x;
+    const auto right = left + wide.columns * pitch_x - (pitch_x - key_width);
+    const auto top = grid_top + osk_character_rows * pitch_y;
+    canvas_fill(left, top, right, top + key_height, key == selected_wide ? selected_colour : key_colour);
+    canvas_centered_text(left, right, top + 28, 22.0F, wide.label, white, key == selected_wide);
+  }
+
+  const auto* confirm = session.confirm_with_cross ? "A" : "B";
+  const auto* back = session.confirm_with_cross ? "B" : "A";
+  canvas_centered_text(90, 870, 474, 18.0F,
+                       "Keyboard: type your text, Backspace deletes, Enter when done, Esc cancels", grey);
+  canvas_centered_text(90, 870, 500, 18.0F,
+                       std::string("Controller: D-pad and ") + confirm + " pick keys, " + back +
+                           " deletes, Y adds a space, Start when done, Back cancels",
+                       grey);
+}
+
+
+// Screenshots (REFRACT_SCREENSHOT_DIR): whether this frame is one, and saving it.
+bool screenshot_due(std::uint64_t frame) {
+  if (std::getenv("REFRACT_SCREENSHOT_DIR") == nullptr) return false;
+  const auto every = env_number("REFRACT_SCREENSHOT_EVERY", 60U);
+  return every != 0U && frame % every == 0U && frame >= env_number("REFRACT_SCREENSHOT_FROM", 0U) &&
+         frame <= env_number("REFRACT_SCREENSHOT_UNTIL", std::numeric_limits<std::uint64_t>::max());
+}
+
+void save_screenshot(const std::vector<std::uint8_t>& pixels, int width, int height, std::uint64_t frame,
+                     const char* prefix) {
+  const auto* directory = std::getenv("REFRACT_SCREENSHOT_DIR");
+  if (directory == nullptr || pixels.size() < static_cast<std::size_t>(width) * height * 4U) return;
+  std::filesystem::create_directories(directory);
+  char name[64];
+  std::snprintf(name, sizeof(name), "/%s_%06llu.ppm", prefix, static_cast<unsigned long long>(frame));
+  auto* file = std::fopen((std::string(directory) + name).c_str(), "wb");
+  if (file == nullptr) return;
+  std::fprintf(file, "P6\n%d %d\n255\n", width, height);
+  std::vector<std::uint8_t> row(static_cast<std::size_t>(width) * 3U);
+  for (int y = 0; y < height; ++y) {
+    for (int x = 0; x < width; ++x)
+      std::memcpy(&row[static_cast<std::size_t>(x) * 3U],
+                  &pixels[(static_cast<std::size_t>(y) * width + x) * 4U], 3U);
+    std::fwrite(row.data(), 1, row.size(), file);
+  }
+  std::fclose(file);
+}
+
+// Shows the frame drawn, saving it as screenshot `frame` if that is one (and it's a new frame).
+void present_window(std::uint64_t frame, const char* prefix, bool new_frame = true) {
+  if (!new_frame || !screenshot_due(frame)) {
+    backend->present(nullptr, nullptr, nullptr);
+    return;
+  }
+  std::vector<std::uint8_t> pixels;
+  int width{}, height{};
+  backend->present(&pixels, &width, &height);
+  save_screenshot(pixels, width, height, frame, prefix);
+}
+
+// The window, with the graphics API asked for: Vulkan where this build has it and the device can,
+// else OpenGL ES.
+bool open_window(frontend::GraphicsApi api) {
+  const bool vulkan = api == frontend::GraphicsApi::vulkan;
+  // REFRACT_WINDOW_SIZE=WxH creates the window at that size (offscreen runs can't resize it).
+  int window_width = 960;
+  int window_height = 544;
+  if (const auto* size = std::getenv("REFRACT_WINDOW_SIZE"))
+    std::sscanf(size, "%dx%d", &window_width, &window_height);
+  // Offscreen (for testing), Vulkan draws into an image of its own, without a window surface.
+  const bool offscreen = std::strcmp(SDL_GetCurrentVideoDriver(), "offscreen") == 0;
+  Uint32 flags = SDL_WINDOW_RESIZABLE | SDL_WINDOW_ALLOW_HIGHDPI;
+  if (!vulkan) flags |= SDL_WINDOW_OPENGL;
+  else if (!offscreen) flags |= SDL_WINDOW_VULKAN;
+  window = SDL_CreateWindow("MHFU", SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED, window_width,
+                            window_height, flags);
+  if (window == nullptr) {
+    std::fprintf(stderr, "refract: cannot create window: %s\n", SDL_GetError());
+    return false;
+  }
+  if (vulkan) {
+    std::string problem;
+    backend = gpu::create_vulkan_backend(window, pipeline_cache_path, problem);
+    if (backend == nullptr) {
+      std::fprintf(stderr, "refract: Vulkan can't draw here (%s): drawing with OpenGL ES\n", problem.c_str());
+      SDL_DestroyWindow(window);
+      window = nullptr;
+      return false;
+    }
+  } else {
+    gl_context = SDL_GL_CreateContext(window);
+    if (gl_context == nullptr) {
+      std::fprintf(stderr, "refract: cannot create OpenGL ES 3.0 context: %s\n", SDL_GetError());
+      SDL_DestroyWindow(window);
+      window = nullptr;
+      return false;
+    }
+    SDL_GL_SetSwapInterval(1);
+    backend = gpu::create_gl_backend(window);
+  }
+  graphics_in_use = api;
+  std::fprintf(stderr, "[refract:sdl] drawing with %s (%s)\n", backend->name(), SDL_GetCurrentVideoDriver());
+  renderer = std::make_unique<Renderer>(*backend);
+  return true;
+}
+
+void open_window_or_fall_back() {
+  if (requested_graphics.load() == frontend::GraphicsApi::vulkan && gpu::vulkan_built() && !vulkan_unusable) {
+    if (open_window(frontend::GraphicsApi::vulkan)) return;
+    vulkan_unusable = true;
+  }
+  open_window(frontend::GraphicsApi::opengl);
+}
+
+void close_window() {
+  renderer.reset();
+  backend.reset();
+  if (gl_context != nullptr) {
+    SDL_GL_DeleteContext(gl_context);
+    gl_context = nullptr;
+  }
+  if (window != nullptr) {
+    SDL_DestroyWindow(window);
+    window = nullptr;
+  }
+}
+
+}  // namespace
+
+bool submit_audio(const std::int16_t* interleaved_stereo, std::uint32_t frame_count,
+                  std::uint32_t channel, bool blocking, std::uint32_t sample_rate) {
+  if (interleaved_stereo == nullptr || frame_count == 0U || sample_rate != host_audio_sample_rate ||
+      channel >= AudioEngine::channel_count)
+    return false;
+  auto& output = audio_output();
+  set_audio_queue_callbacks(backend_queued_audio_frames, backend_reset_audio_channel);
+  set_audio_telemetry_callback(backend_audio_telemetry);
+  set_audio_clock_frames_callback(backend_audio_clock_frames);
+  if (!start_audio(output)) return false;
+  const auto timeout =
+      std::chrono::microseconds(audio_callback_timeout_microseconds(frame_count, sample_rate));
+  return output.engine.submit(interleaved_stereo, frame_count, channel, blocking, timeout) ==
+         AudioEngine::SubmitResult::submitted;
+}
+
+void shutdown_audio() {
+  auto& output = audio_output();
+  static std::atomic_bool stats_reported{};
+  if (std::getenv("REFRACT_AUDIO_STATS") != nullptr && !stats_reported.exchange(true)) {
+    const auto stats = output.engine.telemetry();
+    std::fprintf(stderr,
+                 "[refract:sdl] audio: %llu frames played, %llu callbacks, %llu short of data "
+                 "(%llu frames of silence), %llu dropped\n",
+                 static_cast<unsigned long long>(stats.consumed_frames),
+                 static_cast<unsigned long long>(stats.callback_count),
+                 static_cast<unsigned long long>(stats.underrun_callbacks),
+                 static_cast<unsigned long long>(stats.underrun_frames),
+                 static_cast<unsigned long long>(stats.dropped_frames));
+  }
+  std::lock_guard lock(output.configuration_mutex);
+  output.shut_down = true;
+  if (output.device != 0U) {
+    SDL_CloseAudioDevice(output.device);
+    output.device = 0U;
+  }
+  output.engine.reset();
+}
+
+void set_verbose_logging(bool enabled) { verbose_logging.store(enabled, std::memory_order_relaxed); }
+
+void initialize_frontend() {
+  std::call_once(frontend_once, [] {
+    if (SDL_Init(SDL_INIT_VIDEO | SDL_INIT_GAMECONTROLLER) != 0) {
+      std::fprintf(stderr, "refract: SDL_Init failed: %s\n", SDL_GetError());
+      return;
+    }
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_PROFILE_MASK, SDL_GL_CONTEXT_PROFILE_ES);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MAJOR_VERSION, 3);
+    SDL_GL_SetAttribute(SDL_GL_CONTEXT_MINOR_VERSION, 0);
+    SDL_GL_SetAttribute(SDL_GL_DOUBLEBUFFER, 1);
+    render_scale.store(static_cast<std::uint32_t>(std::clamp<std::uint64_t>(
+        env_number("REFRACT_RENDER_SCALE", 1U), 1U, 8U)));
+    // REFRACT_GRAPHICS=opengl or vulkan (for testing) wins over the setting.
+    if (const auto* api = std::getenv("REFRACT_GRAPHICS"))
+      requested_graphics.store(std::strcmp(api, "opengl") == 0 ? frontend::GraphicsApi::opengl
+                                                               : frontend::GraphicsApi::vulkan);
+    open_window_or_fall_back();
+    SDL_StopTextInput();  // only while the on-screen keyboard is open
+  });
+}
+
+void run_event_loop() {
+  initialize_frontend();
+  if (window == nullptr || renderer == nullptr) return;
+  const auto exit_after = env_number("REFRACT_EXIT_AFTER_FRAMES", 0U);
+  std::uint64_t drawn_frame{};
+  bool text_input_active{};
+  std::string drawn_osk;  // what the keyboard canvas currently shows
+  std::uint32_t fps_window_start = SDL_GetTicks();
+  std::uint64_t fps_window_flips = display_flips.load();
+  bool fps_changed = true;
+  double drawing_time{};  // milliseconds drawing pictures, for the FPS counter
+  std::uint64_t drawn_pictures{};
+  // With smooth motion, a picture every 1/interpolation_rate s, but at most one per refresh of
+  // the screen, should vsync not wait. Each is due one interval after the last one was due, so
+  // the pictures keep to the rate on average when vsync rounds each to a refresh (120 a second
+  // on a 144 Hz screen, not 72).
+  using Clock = std::chrono::steady_clock;
+  Clock::duration refresh_interval = std::chrono::microseconds(16667);
+  if (SDL_DisplayMode mode{}; SDL_GetWindowDisplayMode(window, &mode) == 0 && mode.refresh_rate > 0)
+    refresh_interval = std::chrono::microseconds(1000000 / mode.refresh_rate);
+  auto next_picture = Clock::now();
+  std::uint64_t smooth_pictures{};
+  scripted_buttons(0U);   // parses the input script, including its text steps
+  while (!frontend_exit_requested.load(std::memory_order_relaxed)) {
+    const auto keyboard_open = osk_visible.load();
+    if (keyboard_open != text_input_active) {
+      if (keyboard_open) SDL_StartTextInput();
+      else SDL_StopTextInput();
+      text_input_active = keyboard_open;
+    }
+    for (auto& step : scripted_text) {
+      if (step.sent || presented_frames.load(std::memory_order_relaxed) < step.frame) continue;
+      SDL_Event typed{};
+      typed.type = SDL_TEXTINPUT;
+      std::strncpy(typed.text.text, step.text.c_str(), sizeof(typed.text.text) - 1U);
+      SDL_PushEvent(&typed);
+      step.sent = true;
+    }
+    SDL_Event event;
+    while (SDL_PollEvent(&event) != 0) {
+      switch (event.type) {
+        case SDL_QUIT: frontend_exit_requested.store(true); break;
+        case SDL_KEYDOWN: {
+          std::unique_lock lock(dialog_mutex);
+          if (osk) {
+            osk_handle_key(event.key.keysym.sym);
+          } else {
+            lock.unlock();
+            if (event.key.repeat == 0) handle_key(event.key.keysym.sym, true);
+          }
+          break;
+        }
+        case SDL_KEYUP:
+          // Releases always reach the game, so nothing stays held behind the keyboard.
+          if (event.key.repeat == 0) handle_key(event.key.keysym.sym, false);
+          break;
+        case SDL_TEXTINPUT: {
+          std::lock_guard lock(dialog_mutex);
+          if (osk) osk_handle_text(event.text.text);
+          break;
+        }
+        case SDL_CONTROLLERDEVICEADDED:
+          if (game_controller == nullptr) game_controller = SDL_GameControllerOpen(event.cdevice.which);
+          break;
+        case SDL_CONTROLLERDEVICEREMOVED:
+          if (game_controller != nullptr &&
+              SDL_JoystickInstanceID(SDL_GameControllerGetJoystick(game_controller)) == event.cdevice.which) {
+            SDL_GameControllerClose(game_controller);
+            game_controller = nullptr;
+          }
+          break;
+        default: break;
+      }
+    }
+    poll_controller();
+    std::optional<OskSession> keyboard;
+    {
+      std::lock_guard lock(dialog_mutex);
+      if (osk) osk_handle_pad(controller_buttons.load(std::memory_order_relaxed) |
+                              scripted_buttons(presented_frames.load(std::memory_order_relaxed)));
+      keyboard = osk;
+    }
+    const bool smooth = smooth_motion.load(std::memory_order_relaxed);
+    const bool new_drawing = frame_pending.exchange(false, std::memory_order_acq_rel);
+    if (!new_drawing && !(smooth && renderer->smoothing())) {
+      SDL_Delay(1);
+      continue;
+    }
+    if (smooth) {
+      const auto rate = std::max(interpolation_rate.load(std::memory_order_relaxed), 1U);
+      const auto interval =
+          std::max(refresh_interval, Clock::duration(std::chrono::microseconds(1000000U / rate)));
+      const auto now = Clock::now();
+      if (next_picture < now - interval) next_picture = now;  // after a pause, start again
+      const auto wait = next_picture - refresh_interval / 2 - now;
+      if (wait > Clock::duration::zero())
+        SDL_Delay(static_cast<Uint32>(std::chrono::duration_cast<std::chrono::milliseconds>(wait).count()));
+      next_picture += interval;
+    }
+    int width{}, height{};
+    const auto drawing_started = Clock::now();
+    backend->drawable_size(width, height);
+    if (new_drawing) renderer->draw_new_geometry();
+    renderer->present(width, height, std::chrono::steady_clock::now());
+    if (keyboard) {
+      const bool cursor_shown = SDL_GetTicks() / 500U % 2U == 0U;
+      auto shown = keyboard->prompt + '\n' + to_utf8(keyboard->text) + '\n' +
+                   std::to_string(keyboard->row) + ',' + std::to_string(keyboard->column) +
+                   (cursor_shown ? "|" : "");
+      const bool changed = shown != drawn_osk;
+      if (changed) {
+        draw_osk(*keyboard, cursor_shown);
+        drawn_osk = std::move(shown);
+      }
+      renderer->draw_overlay(width, height, osk_canvas, osk_canvas_width, osk_canvas_height, changed);
+    } else {
+      drawn_osk.clear();
+    }
+    if (fps_counter_shown.load(std::memory_order_relaxed)) {
+      const std::uint32_t now = SDL_GetTicks();
+      if (now - fps_window_start >= 500U) {
+        const auto flips = display_flips.load(std::memory_order_relaxed);
+        draw_fps_counter(static_cast<double>(flips - fps_window_flips) * 1000.0 /
+                             static_cast<double>(now - fps_window_start),
+                         drawn_pictures != 0U ? drawing_time / static_cast<double>(drawn_pictures) : 0.0);
+        drawing_time = 0.0;
+        drawn_pictures = 0U;
+        fps_window_start = now;
+        fps_window_flips = flips;
+        fps_changed = true;
+      }
+      renderer->draw_overlay(width, height, fps_canvas, osk_canvas_width, osk_canvas_height, fps_changed,
+                             1U);
+      fps_changed = false;
+    }
+    const auto frame = presented_frames.load(std::memory_order_relaxed);
+    if (smooth) {
+      present_window(++smooth_pictures, "smooth");  // every picture shown
+    } else {
+      present_window(frame, "frame", frame != drawn_frame);
+      drawn_frame = frame;
+    }
+    drawing_time += std::chrono::duration<double, std::milli>(Clock::now() - drawing_started).count();
+    ++drawn_pictures;
+    if (exit_after != 0U && frame >= exit_after) break;
+  }
+  shutdown_audio();
+  close_window();  // (Vulkan keeps the pipelines it made for next time)
+}
+
+void request_frontend_exit() { frontend_exit_requested.store(true, std::memory_order_relaxed); }
+
+void present_frame(const std::uint8_t* pixels, std::uint32_t stride, std::uint32_t width,
+                   std::uint32_t height, std::uint32_t format, std::uint32_t address) {
+  if (pixels == nullptr || width == 0U || height == 0U) return;
+  display_flips.fetch_add(1U, std::memory_order_relaxed);
+  const auto framebuffer_address = normalized_vram_address(address);
+  // Usually the game draws with the GE and this memory doesn't change: check that from the
+  // PSP pixels, and convert them only when they did (videos).
+  const std::size_t row_bytes = static_cast<std::size_t>(width) * (format == 3U ? 4U : 2U);
+  const std::size_t stride_bytes = static_cast<std::size_t>(stride) * (format == 3U ? 4U : 2U);
+  auto hash = static_cast<std::uint64_t>(format) | static_cast<std::uint64_t>(width) << 8U |
+              static_cast<std::uint64_t>(height) << 24U;
+  for (std::uint32_t y = 0; y < height; ++y)
+    hash = refract::ge::content_hash({pixels + y * stride_bytes, row_bytes}, hash);
+  const auto changed = framebuffer_sources.record_cpu_frame(framebuffer_address, hash);
+  bool convert = changed;
+  {
+    std::lock_guard lock(cpu_frame_mutex);
+    const auto found = cpu_frames.find(framebuffer_address);
+    convert = convert || found == cpu_frames.end() || found->second.width != width ||
+              found->second.height != height;
+  }
+  if (convert) {
+    auto converted = std::make_shared<const std::vector<std::uint8_t>>(
+        convert_frame(pixels, stride, width, height, format));
+    std::lock_guard lock(cpu_frame_mutex);
+    cpu_frames[framebuffer_address] = {std::move(converted), width, height, ++cpu_frame_generation};
+  }
+  display_framebuffer_address.store(framebuffer_address, std::memory_order_relaxed);
+  present_ge_frame();
+  // If drawing falls behind (a slow GPU at a high resolution), the game waits for it a little
+  // instead of piling up frames.
+  std::unique_lock lock(geometry_mutex);
+  presented_flips.push_back(
+      {presented_geometry_batches.size(), framebuffer_address, std::chrono::steady_clock::now()});
+  ++undrawn_flips;
+  geometry_taken.wait_for(lock, std::chrono::milliseconds(50), [] {
+    return undrawn_flips <= 2U || frontend_exit_requested.load(std::memory_order_relaxed);
+  });
+}
+
+void present_ge_frame() {
+  keyboard_latched_buttons.store(0U, std::memory_order_relaxed);
+  {
+    std::lock_guard lock(geometry_mutex);
+    // Everything drawn reaches the render targets, in order, even when the render thread is
+    // behind: a frame is drawn by several display lists, and a target keeps what was drawn into
+    // it, so replacing undrawn lists left parts of frames missing (walls, flickering menus).
+    if (presented_geometry_batches.empty())
+      presented_geometry_batches.swap(pending_geometry_batches);
+    else
+      presented_geometry_batches.insert(presented_geometry_batches.end(),
+                                        std::make_move_iterator(pending_geometry_batches.begin()),
+                                        std::make_move_iterator(pending_geometry_batches.end()));
+    pending_geometry_batches.clear();
+  }
+  presented_frames.fetch_add(1U, std::memory_order_relaxed);
+  frame_pending.store(true, std::memory_order_release);
+}
+
+void begin_ge_frame() {
+  std::lock_guard lock(geometry_mutex);
+  building_geometry_batches.clear();
+  if (building_geometry_batches.capacity() < 4096U) building_geometry_batches.reserve(4096U);
+}
+
+void end_ge_frame() {
+  std::lock_guard lock(geometry_mutex);
+  if (pending_geometry_batches.empty()) {
+    pending_geometry_batches.swap(building_geometry_batches);
+    return;
+  }
+  pending_geometry_batches.insert(pending_geometry_batches.end(),
+                                  std::make_move_iterator(building_geometry_batches.begin()),
+                                  std::make_move_iterator(building_geometry_batches.end()));
+  building_geometry_batches.clear();
+}
+
+void submit_ge_primitive(std::uint32_t type, std::vector<GeometryVertex> vertices,
+                         std::shared_ptr<const std::vector<std::uint8_t>> texture,
+                         std::uint32_t texture_width, std::uint32_t texture_height,
+                         GeometryState graphics_state) {
+  if (type > 4U) return;
+  framebuffer_sources.record_ge_write(normalized_vram_address(graphics_state.render_target_address));
+  std::lock_guard lock(geometry_mutex);
+  building_geometry_batches.push_back(
+      {type, std::move(vertices), std::move(texture), texture_width, texture_height, graphics_state});
+}
+
+ControllerState controller_state() {
+  ControllerState result;
+  // The game gets no input while the on-screen keyboard has it.
+  if (osk_visible.load()) return result;
+  // Scripted input: bits 28 to 31 push the analog stick up, right, down and left, bits 24 to 27
+  // the right stick.
+  const auto scripted = scripted_buttons(presented_frames.load(std::memory_order_relaxed));
+  result.buttons = keyboard_buttons.load(std::memory_order_relaxed) |
+                   keyboard_latched_buttons.load(std::memory_order_relaxed) |
+                   controller_buttons.load(std::memory_order_relaxed) | (scripted & 0x00ffffffU);
+  if (auto suppressed = suppressed_buttons.load(); suppressed != 0U) {
+    suppressed &= result.buttons;
+    suppressed_buttons.store(suppressed);
+    result.buttons &= ~suppressed;
+  }
+  auto directions = keyboard_analog_directions.load(std::memory_order_relaxed);
+  if ((scripted & 0x10000000U) != 0U) directions |= analog_up;
+  if ((scripted & 0x20000000U) != 0U) directions |= analog_right;
+  if ((scripted & 0x40000000U) != 0U) directions |= analog_down;
+  if ((scripted & 0x80000000U) != 0U) directions |= analog_left;
+  if (directions != 0U) {
+    const auto horizontal = ((directions & analog_right) != 0U ? 1 : 0) -
+                            ((directions & analog_left) != 0U ? 1 : 0);
+    const auto vertical = ((directions & analog_down) != 0U ? 1 : 0) -
+                          ((directions & analog_up) != 0U ? 1 : 0);
+    result.analog_x = static_cast<std::uint8_t>(128 + horizontal * 127);
+    result.analog_y = static_cast<std::uint8_t>(128 + vertical * 127);
+  } else {
+    const auto analog = controller_analog.load(std::memory_order_relaxed);
+    result.analog_x = static_cast<std::uint8_t>(analog & 0xffU);
+    result.analog_y = static_cast<std::uint8_t>((analog >> 8U) & 0xffU);
+  }
+  if ((scripted & 0x0f000000U) != 0U) {
+    result.right_x = ((scripted & 0x02000000U) != 0U ? 1.0F : 0.0F) - ((scripted & 0x08000000U) != 0U ? 1.0F : 0.0F);
+    result.right_y = ((scripted & 0x04000000U) != 0U ? 1.0F : 0.0F) - ((scripted & 0x01000000U) != 0U ? 1.0F : 0.0F);
+  } else {
+    const auto right = controller_right_stick.load(std::memory_order_relaxed);
+    result.right_x = static_cast<std::int16_t>(right & 0xffffU) / 32767.0F;
+    result.right_y = static_cast<std::int16_t>(right >> 16U) / 32767.0F;
+  }
+  return result;
+}
+
+// Text entry gets the on-screen keyboard; other dialogs (messages, saving) are still accepted
+// automatically.
+void present_dialog(DialogModel model) {
+  if (verbose_logging.load(std::memory_order_relaxed))
+    std::fprintf(stderr, "[refract:sdl] dialog %llu (kind %d): %s | %s\n",
+                 static_cast<unsigned long long>(model.id), static_cast<int>(model.kind),
+                 model.title.c_str(), model.message.c_str());
+  std::lock_guard lock(dialog_mutex);
+  if (model.kind == DialogKind::osk) {
+    OskSession session;
+    session.id = model.id;
+    session.prompt = !model.fields.empty() && !model.fields[0].label.empty() ? model.fields[0].label
+                                                                             : model.title;
+    for (const auto& field : model.fields) session.original.push_back(field.text);
+    if (!model.fields.empty()) {
+      session.text = model.fields[0].text;
+      session.limit = model.fields[0].limit;
+    }
+    session.confirm_with_cross = model.confirm_with_cross;
+    osk = std::move(session);
+    osk_result.reset();
+    osk_visible.store(true);
+    return;
+  }
+  pending_dialog = std::move(model);
+  pending_dialog_polls = 0;
+}
+
+std::optional<DialogResult> poll_dialog_result(std::uint64_t id) {
+  std::lock_guard lock(dialog_mutex);
+  if (osk_result && osk_result->id == id) {
+    auto result = std::move(osk_result);
+    osk_result.reset();
+    return result;
+  }
+  if (!pending_dialog || pending_dialog->id != id) return std::nullopt;
+  if (++pending_dialog_polls < 30U) return std::nullopt;
+  DialogResult result;
+  result.id = id;
+  result.affirmative = !pending_dialog->default_no;
+  result.selected_item = pending_dialog->selected_item;
+  for (const auto& field : pending_dialog->fields) result.field_text.push_back(field.text);
+  pending_dialog.reset();
+  return result;
+}
+
+void dismiss_dialog(std::uint64_t id) {
+  std::lock_guard lock(dialog_mutex);
+  if (pending_dialog && pending_dialog->id == id) pending_dialog.reset();
+  if (osk && osk->id == id) {
+    osk.reset();
+    osk_visible.store(false);
+  }
+  if (osk_result && osk_result->id == id) osk_result.reset();
+}
+
+bool dialog_visible() {
+  std::lock_guard lock(dialog_mutex);
+  return pending_dialog.has_value() || osk.has_value();
+}
+
+ge::CacheMetrics ge_cache_metrics() { return ge_cache_counters.snapshot(); }
+
+void reset_ge_cache_metrics() { ge_cache_counters.reset(); }
+
