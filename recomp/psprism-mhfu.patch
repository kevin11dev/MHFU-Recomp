+    if (scroll_ > 0.5F) arrow(canvas, (panel_left + panel_right) * 0.5F, list_top - 4.0F, 5.0F, 0, -1, gold_dim);
+    if (scroll_ < height - view - 0.5F) arrow(canvas, (panel_left + panel_right) * 0.5F, list_bottom + 4.0F, 5.0F, 0, 1, gold_dim);
+    // What the chosen setting does.
+    fill(canvas, panel_left + 28.0F, 422.0F, panel_right - 28.0F, 423.0F, frame_inner);
+    if (choice_ < choices_.size()) {
+      float baseline = 445.0F;
+      for (const auto& line : wrap(canvas, 15.0F, choices_[choice_].description, panel_right - panel_left - 56.0F)) {
+        if (baseline > 492.0F) break;
+        text(canvas, panel_left + 28.0F, baseline, 15.0F, line, rgba(206, 194, 166));
+        baseline += 20.0F;
