+constexpr std::uint16_t style_bold = 5;
+constexpr std::uint16_t style_bold_italic = 6;
+constexpr std::uint16_t style_demi_bold = 103;
+constexpr std::uint16_t language_japanese = 1;
+constexpr std::uint16_t language_latin = 2;
+constexpr std::uint16_t language_korean = 3;
+constexpr float point_dpi = 72.0F;
+
+struct Registered {
+  float size_points;  // the firmware font's design size
+  std::uint16_t family;
+  std::uint16_t style;
+  std::uint16_t language;
+  const char* file_name;   // the firmware's PGF file
+  const char* font_name;
+  const char* substitute;  // TrueType file standing in for it
+};
+
+// jpn0, ltn0..ltn15 and kr0, as on a retail PSP. ltn8..15 are the small (7 pt) variants.
+constexpr Registered registry[] = {
+    {10.125F, family_sans, style_demi_bold, language_japanese, "jpn0.pgf", "FTT-NewRodin Pro DB", "LiberationSans-Bold.ttf"},
+    {10.125F, family_sans, style_regular, language_latin, "ltn0.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-Regular.ttf"},
+    {10.125F, family_serif, style_regular, language_latin, "ltn1.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-Regular.ttf"},
+    {10.125F, family_sans, style_italic, language_latin, "ltn2.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-Italic.ttf"},
+    {10.125F, family_serif, style_italic, language_latin, "ltn3.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-Italic.ttf"},
+    {10.125F, family_sans, style_bold, language_latin, "ltn4.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-Bold.ttf"},
+    {10.125F, family_serif, style_bold, language_latin, "ltn5.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-Bold.ttf"},
+    {10.125F, family_sans, style_bold_italic, language_latin, "ltn6.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-BoldItalic.ttf"},
+    {10.125F, family_serif, style_bold_italic, language_latin, "ltn7.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-BoldItalic.ttf"},
+    {7.0F, family_sans, style_regular, language_latin, "ltn8.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-Regular.ttf"},
+    {7.0F, family_serif, style_regular, language_latin, "ltn9.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-Regular.ttf"},
+    {7.0F, family_sans, style_italic, language_latin, "ltn10.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-Italic.ttf"},
+    {7.0F, family_serif, style_italic, language_latin, "ltn11.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-Italic.ttf"},
+    {7.0F, family_sans, style_bold, language_latin, "ltn12.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-Bold.ttf"},
+    {7.0F, family_serif, style_bold, language_latin, "ltn13.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-Bold.ttf"},
+    {7.0F, family_sans, style_bold_italic, language_latin, "ltn14.pgf", "FTT-NewRodin Pro Latin", "LiberationSans-BoldItalic.ttf"},
+    {7.0F, family_serif, style_bold_italic, language_latin, "ltn15.pgf", "FTT-Matisse Pro Latin", "LiberationSerif-BoldItalic.ttf"},
+    {10.125F, family_sans, style_regular, language_korean, "kr0.pgf", "AsiaNHH(512Johab)", "LiberationSans-Regular.ttf"},
+};
+constexpr int registry_size = static_cast<int>(sizeof(registry) / sizeof(registry[0]));
+
+// sceFontGetFontInfo values measured on hardware (pspautotests font/fonttest and
+// font/fontinfo), in pixels. Games size their text layout from these, so they're reported
+// as-is instead of being derived from the substitute fonts, which have different extents.
+struct MeasuredMetrics {
+  float width, height, ascender, descender, left_x, base_y, min_center_x, top_y, advance_x,
+      advance_y;
+  std::int16_t pixel_width, pixel_height;
+  std::int32_t glyph_count;
+};
+constexpr MeasuredMetrics jpn0_metrics{18.140625F, 19.546875F, 15.828125F, -2.171875F, 15.75F,
+                                       18.8125F,   -9.0625F,   17.984375F, 18.71875F,  18.71875F,
+                                       19,         20,         7000};
+constexpr MeasuredMetrics ltn0_metrics{22.734375F, 19.09375F, 13.484375F, -3.0625F, 3.046875F,
+                                       18.78125F,  -11.359375F, 0.28125F,  24.765625F, 17.09375F,
+                                       23,         20,          324};
+
+MeasuredMetrics measured_metrics(int index) {
+  if (registry[index].language != language_latin) return jpn0_metrics;
+  if (registry[index].size_points >= 10.0F) return ltn0_metrics;
+  // The 7 pt variants: scale ltn0's metrics to their size.
+  const float scale = registry[index].size_points / registry[1].size_points;
+  auto metrics = ltn0_metrics;
+  for (float* value : {&metrics.width, &metrics.height, &metrics.ascender, &metrics.descender,
+                       &metrics.left_x, &metrics.base_y, &metrics.min_center_x, &metrics.top_y,
+                       &metrics.advance_x, &metrics.advance_y})
+    *value = std::round(*value * scale * 64.0F) / 64.0F;
+  metrics.pixel_width = static_cast<std::int16_t>(std::ceil(metrics.width));
+  metrics.pixel_height = static_cast<std::int16_t>(std::ceil(metrics.height));
+  return metrics;
+}
+constexpr float firmware_resolution = 128.0F;
+
+const std::array<Style, registry_size>& styles() {
+  static const auto value = [] {
+    std::array<Style, registry_size> result{};
+    for (int i = 0; i < registry_size; ++i) {
+      auto& style = result[static_cast<std::size_t>(i)];
+      style.h = style.v = registry[i].size_points;
+      style.h_resolution = style.v_resolution = firmware_resolution;
+      style.family = registry[i].family;
+      style.style = registry[i].style;
+      style.language = registry[i].language;
+      style.country = 1;
+      std::strncpy(style.name, registry[i].font_name, sizeof(style.name) - 1U);
+      std::strncpy(style.file_name, registry[i].file_name, sizeof(style.file_name) - 1U);
+    }
+    return result;
+  }();
+  return value;
+}
+
+std::optional<std::filesystem::path> executable_directory() {
+  std::error_code error;
+  const auto path = std::filesystem::read_symlink("/proc/self/exe", error);
+  if (error) return std::nullopt;
+  return path.parent_path();
+}
+
+std::array<std::filesystem::path, 4> font_directories() {
+  std::array<std::filesystem::path, 4> result;
+  if (const auto* value = std::getenv("REFRACT_FONT_DIR")) result[0] = value;
+  if (const auto directory = executable_directory()) {
+    result[1] = *directory / "Resources" / "fonts";
+    result[2] = directory->parent_path() / "Resources" / "fonts";
+  }
+  result[3] = "/usr/share/fonts/truetype/liberation";
+  return result;
+}
+
+// One TrueType file, shared by every registry entry that uses it.
+struct FontFile {
+  std::vector<unsigned char> data;
+  stbtt_fontinfo info{};
+};
+
+// A registry entry at its pixel size, with its glyph cache.
+struct Face {
+  std::shared_ptr<FontFile> file;
+  float pixels{};
+  float scale{};
+  int ascent{};
+  int descent{};
+  int line_gap{};
+  std::unordered_map<std::uint32_t, std::optional<CharInfo>> char_infos;
+  std::unordered_map<std::uint32_t, std::optional<Glyph>> glyphs;
+};
+
+std::mutex mutex;
+std::unordered_map<std::string, std::shared_ptr<FontFile>> files;
+std::array<std::unique_ptr<Face>, registry_size> faces;
+
+std::shared_ptr<FontFile> load_file(const std::string& name) {
+  if (const auto found = files.find(name); found != files.end()) return found->second;
+  std::shared_ptr<FontFile> result;
+  for (const auto& directory : font_directories()) {
+    if (directory.empty()) continue;
+    std::ifstream input(directory / name, std::ios::binary);
+    if (!input) continue;
+    auto file = std::make_shared<FontFile>();
+    file->data.assign(std::istreambuf_iterator<char>(input), {});
+    if (stbtt_InitFont(&file->info, file->data.data(),
+                       stbtt_GetFontOffsetForIndex(file->data.data(), 0)) != 0) {
+      result = std::move(file);
+      break;
+    }
+  }
+  if (!result) std::fprintf(stderr, "[refract:font] cannot load %s\n", name.c_str());
+  files.emplace(name, result);
+  return result;
+}
+
+Face* face(int index) {
+  if (index < 0 || index >= registry_size) return nullptr;
+  auto& slot = faces[static_cast<std::size_t>(index)];
+  if (slot) return slot->file ? slot.get() : nullptr;
+  slot = std::make_unique<Face>();
+  slot->file = load_file(registry[index].substitute);
+  if (!slot->file) return nullptr;
+  slot->pixels = registry[index].size_points * firmware_resolution / point_dpi;
+  slot->scale = stbtt_ScaleForMappingEmToPixels(&slot->file->info, slot->pixels);
+  stbtt_GetFontVMetrics(&slot->file->info, &slot->ascent, &slot->descent, &slot->line_gap);
+  return slot.get();
+}
+
+std::int32_t fixed26(float pixels) { return static_cast<std::int32_t>(std::lround(pixels * 64.0F)); }
+
+int glyph_index(const Face& f, std::uint32_t code) {
+  return code < 0x20U ? 0 : stbtt_FindGlyphIndex(&f.file->info, static_cast<int>(code));
+}
+
+// The code to render for a request: the character itself if the font has it, else the
+// alternative (as the firmware does), else nothing.
+std::optional<std::uint32_t> resolve(const Face& f, std::uint32_t code, std::uint32_t alt_code) {
+  if (code == 0x20U || glyph_index(f, code) != 0) return code;
+  if (code < 0x20U) return std::nullopt;
+  if (alt_code == 0x20U || glyph_index(f, alt_code) != 0) return alt_code;
+  return std::nullopt;
+}
+
+std::optional<CharInfo> compute_char_info(const Face& f, std::uint32_t code) {
+  const auto index = stbtt_FindGlyphIndex(&f.file->info, static_cast<int>(code));
+  int advance{}, left_bearing{};
+  stbtt_GetGlyphHMetrics(&f.file->info, index, &advance, &left_bearing);
+  int x0{}, y0{}, x1{}, y1{};
+  stbtt_GetGlyphBitmapBox(&f.file->info, index, f.scale, f.scale, &x0, &y0, &x1, &y1);
+  CharInfo info{};
+  info.bitmap_width = static_cast<std::uint32_t>(std::max(0, x1 - x0));
+  info.bitmap_height = static_cast<std::uint32_t>(std::max(0, y1 - y0));
+  info.bitmap_left = x0;
+  info.bitmap_top = -y0;
+  info.width = info.bitmap_width * 64U;
+  info.height = info.bitmap_height * 64U;
+  info.ascender = info.bitmap_top * 64;
+  info.descender = info.ascender - static_cast<std::int32_t>(info.height);
+  info.bearing_h_x = fixed26(static_cast<float>(left_bearing) * f.scale);
+  info.bearing_h_y = info.ascender;
+  info.advance_h = fixed26(static_cast<float>(advance) * f.scale);
+  info.advance_v = fixed26(static_cast<float>(f.ascent - f.descent) * f.scale);
+  info.bearing_v_x = -info.advance_h / 2;
+  info.bearing_v_y = 0;
+  return info;
+}
+
+std::optional<Glyph> render_glyph(const Face& f, std::uint32_t code) {
+  int width{}, height{}, x_offset{}, y_offset{};
+  auto* coverage = stbtt_GetCodepointBitmap(&f.file->info, f.scale, f.scale, static_cast<int>(code),
+                                            &width, &height, &x_offset, &y_offset);
+  Glyph glyph;
+  glyph.width = width;
+  glyph.height = height;
+  glyph.pixels.resize(static_cast<std::size_t>(std::max(0, width * height)));
+  for (std::size_t i = 0; i < glyph.pixels.size(); ++i)
+    glyph.pixels[i] = static_cast<std::uint8_t>((coverage[i] * 15U + 127U) / 255U);
+  stbtt_FreeBitmap(coverage, nullptr);
+  return glyph;
+}
+
+}  // namespace
+
+int font_count() { return registry_size; }
+
+const Style& font_style(int index) {
+  return styles()[static_cast<std::size_t>(std::clamp(index, 0, registry_size - 1))];
+}
+
+// Like the firmware: fields the request sets must match exactly; among matches the size
+// closest to the request wins, otherwise the last exact match.
+int find_optimum_font(const Style& requested, float library_h_resolution,
+                      float library_v_resolution) {
+  const auto h_resolution =
+      requested.h_resolution > 0.0F ? requested.h_resolution : library_h_resolution;
+  const auto v_resolution =
+      requested.v_resolution > 0.0F ? requested.v_resolution : library_v_resolution;
+  int nearest = -1, exact = -1;
+  float nearest_distance = INFINITY;
+  for (int i = 0; i < registry_size; ++i) {
+    const auto& style = font_style(i);
+    bool matched = false;
+    const auto field = [&](std::uint16_t want, std::uint16_t have) {
+      if (want == 0U) return true;
+      matched = true;
+      return want == have;
+    };
+    const auto text = [&](const char* want, const char* have) {
+      if (want[0] == '\0') return true;
+      matched = true;
+      return std::strncmp(want, have, 64) == 0;
+    };
+    if (!field(requested.family, style.family) || !field(requested.style, style.style) ||
+        !field(requested.language, style.language) || !field(requested.country, style.country) ||
+        !text(requested.name, style.name) || !text(requested.file_name, style.file_name))
+      continue;
+    if (requested.h > 0.0F) {
+      const auto distance = std::fabs(style.h_resolution * style.h - h_resolution * requested.h);
+      if (distance < nearest_distance) nearest_distance = distance, nearest = i;
+    }
+    if (requested.v > 0.0F) {
+      const auto distance = std::fabs(style.v_resolution * style.v - v_resolution * requested.v);
+      if (distance < nearest_distance) nearest_distance = distance, nearest = i;
+    }
+    if (matched) exact = i;
+  }
+  if (nearest >= 0) return nearest;
+  if (exact >= 0) return exact;
+  return requested.language == language_japanese ? 0 : 1;
+}
+
+bool font_info(int index, FontInfo& info) {
+  info = {};
+  if (index < 0 || index >= registry_size) return false;
+  info.style = font_style(index);
+  info.bits_per_pixel = 4U;
+  const auto metrics = measured_metrics(index);
+  const auto set = [](std::int32_t& fixed, float& value, float pixels) {
+    fixed = fixed26(pixels);
+    value = pixels;
+  };
+  set(info.max_glyph_width_i, info.max_glyph_width_f, metrics.width);
+  set(info.max_glyph_height_i, info.max_glyph_height_f, metrics.height);
+  set(info.max_glyph_ascender_i, info.max_glyph_ascender_f, metrics.ascender);
+  set(info.max_glyph_descender_i, info.max_glyph_descender_f, metrics.descender);
+  set(info.max_glyph_left_x_i, info.max_glyph_left_x_f, metrics.left_x);
+  set(info.max_glyph_base_y_i, info.max_glyph_base_y_f, metrics.base_y);
+  set(info.min_glyph_center_x_i, info.min_glyph_center_x_f, metrics.min_center_x);
+  set(info.max_glyph_top_y_i, info.max_glyph_top_y_f, metrics.top_y);
+  set(info.max_glyph_advance_x_i, info.max_glyph_advance_x_f, metrics.advance_x);
+  set(info.max_glyph_advance_y_i, info.max_glyph_advance_y_f, metrics.advance_y);
+  info.max_glyph_width = metrics.pixel_width;
+  info.max_glyph_height = metrics.pixel_height;
+  info.glyph_count = metrics.glyph_count;
+  return true;
+}
+
+bool char_info(int index, std::uint32_t code, std::uint32_t alt_code, CharInfo& info) {
+  std::lock_guard lock(mutex);
+  info = {};
+  auto* f = face(index);
+  if (f == nullptr) return false;
+  const auto resolved = resolve(*f, code, alt_code);
+  if (!resolved) return false;
+  auto [entry, inserted] = f->char_infos.try_emplace(*resolved);
+  if (inserted) entry->second = compute_char_info(*f, *resolved);
+  if (!entry->second) return false;
+  info = *entry->second;
+  return true;
+}
+
+const Glyph* glyph(int index, std::uint32_t code, std::uint32_t alt_code) {
+  std::lock_guard lock(mutex);
+  auto* f = face(index);
+  if (f == nullptr) return nullptr;
+  const auto resolved = resolve(*f, code, alt_code);
+  if (!resolved) return nullptr;
+  auto [entry, inserted] = f->glyphs.try_emplace(*resolved);
+  if (inserted) entry->second = render_glyph(*f, *resolved);
+  return entry->second ? &*entry->second : nullptr;
+}
+
+namespace {
+
+std::uint32_t next_code_point(std::string_view text, std::size_t& at) {
+  const auto byte = [&](std::size_t i) { return static_cast<std::uint8_t>(text[i]); };
+  const auto lead = byte(at++);
+  int extra = lead >= 0xf0U ? 3 : lead >= 0xe0U ? 2 : lead >= 0xc0U ? 1 : 0;
+  std::uint32_t code = extra == 3 ? lead & 7U : extra == 2 ? lead & 15U : extra == 1 ? lead & 31U : lead;
+  for (; extra > 0 && at < text.size() && (byte(at) & 0xc0U) == 0x80U; --extra) code = code << 6U | (byte(at++) & 63U);
+  return code;
+}
+
+int ui_text(std::uint8_t* canvas, int canvas_width, int canvas_height, int x, int y,
+            float pixel_height, std::string_view utf8, std::uint32_t abgr, UiFace face) {
+  std::lock_guard lock(mutex);
+  auto file = load_file(face == UiFace::display ? "Cinzel-Bold.ttf"
+                        : face == UiFace::bold  ? "LiberationSans-Bold.ttf"
+                                                : "LiberationSans-Regular.ttf");
+  if (!file && face == UiFace::display) file = load_file("LiberationSerif-Bold.ttf");
+  if (!file) return 0;
+  const auto& info = file->info;
+  const auto scale = stbtt_ScaleForPixelHeight(&info, pixel_height);
+  float pen = static_cast<float>(x);
+  std::uint32_t previous{};
+  std::vector<unsigned char> bitmap;
+  for (std::size_t at = 0; at < utf8.size();) {
+    const auto code = next_code_point(utf8, at);
+    if (previous != 0U)
+      pen += scale * static_cast<float>(stbtt_GetCodepointKernAdvance(&info, static_cast<int>(previous),
+                                                                      static_cast<int>(code)));
+    previous = code;
+    int advance{}, bearing{};
+    stbtt_GetCodepointHMetrics(&info, static_cast<int>(code), &advance, &bearing);
+    if (canvas != nullptr) {
+      const auto shift = pen - std::floor(pen);
+      int left{}, top{}, right{}, bottom{};
+      stbtt_GetCodepointBitmapBoxSubpixel(&info, static_cast<int>(code), scale, scale, shift, 0.0F,
+                                          &left, &top, &right, &bottom);
+      const auto width = right - left;
+      const auto height = bottom - top;
+      if (width > 0 && height > 0) {
+        bitmap.assign(static_cast<std::size_t>(width) * static_cast<std::size_t>(height), 0U);
+        stbtt_MakeCodepointBitmapSubpixel(&info, bitmap.data(), width, height, width, scale, scale, shift,
+                                          0.0F, static_cast<int>(code));
+        const auto origin_x = static_cast<int>(std::floor(pen)) + left;
+        const auto origin_y = y + top;
+        for (int row = 0; row < height; ++row) {
+          const auto canvas_y = origin_y + row;
+          if (canvas_y < 0 || canvas_y >= canvas_height) continue;
+          for (int column = 0; column < width; ++column) {
+            const auto canvas_x = origin_x + column;
+            if (canvas_x < 0 || canvas_x >= canvas_width) continue;
+            const auto coverage = bitmap[static_cast<std::size_t>(row * width + column)] *
+                                  ((abgr >> 24U) & 0xffU) / 255U;
+            if (coverage == 0U) continue;
+            auto* pixel = canvas + (static_cast<std::size_t>(canvas_y) * static_cast<std::size_t>(canvas_width) +
+                                    static_cast<std::size_t>(canvas_x)) * 4U;
+            for (int channel = 0; channel < 3; ++channel) {
+              const auto source = (abgr >> (channel * 8)) & 0xffU;
+              pixel[channel] = static_cast<std::uint8_t>((source * coverage + pixel[channel] * (255U - coverage)) / 255U);
+            }
+            pixel[3] = static_cast<std::uint8_t>(coverage + pixel[3] * (255U - coverage) / 255U);
+          }
+        }
+      }
+    }
+    pen += scale * static_cast<float>(advance);
+  }
+  return static_cast<int>(std::lround(pen)) - x;
+}
+
+}  // namespace
+
+int draw_ui_text(std::uint8_t* canvas, int canvas_width, int canvas_height, int x, int y,
+                 float pixel_height, std::string_view utf8, std::uint32_t abgr, UiFace face) {
+  return ui_text(canvas, canvas_width, canvas_height, x, y, pixel_height, utf8, abgr, face);
+}
+
+int measure_ui_text(float pixel_height, std::string_view utf8, UiFace face) {
+  return ui_text(nullptr, 0, 0, 0, 0, pixel_height, utf8, 0U, face);
+}
+
+int draw_ui_text(std::uint8_t* canvas, int canvas_width, int canvas_height, int x, int y,
+                 float pixel_height, std::string_view utf8, std::uint32_t abgr, bool bold) {
+  return ui_text(canvas, canvas_width, canvas_height, x, y, pixel_height, utf8, abgr,
+                 bold ? UiFace::bold : UiFace::regular);
+}
+
+int measure_ui_text(float pixel_height, std::string_view utf8, bool bold) {
+  return ui_text(nullptr, 0, 0, 0, 0, pixel_height, utf8, 0U, bold ? UiFace::bold : UiFace::regular);
+}
+
+}  // namespace refract::font
