+#include "atrac_state.hpp"
+
+// The sample the next sceAtracDecodeData call starts at, or "all data decoded"
+// once the track has been played to its end.
+void sceAtracGetNextDecodePosition(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  static_cast<void>(implementation);
+  const auto decoder = atrac_state::get(static_cast<int>(state.gpr[4]));
+  if (decoder == nullptr) {
+    state.gpr[2] = atrac_state::invalid_id;
+    return;
+  }
+  std::lock_guard lock(decoder->decoder_mutex);
+  if (decoder->decoded_samples > decoder->track.end_sample) {  // end_sample is the last one
+    state.gpr[2] = atrac_state::all_data_decoded;
+    return;
+  }
+  atrac_state::write_u32(state, state.gpr[5],
+                         static_cast<std::uint32_t>(decoder->decoded_samples));
+  state.gpr[2] = 0U;
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
