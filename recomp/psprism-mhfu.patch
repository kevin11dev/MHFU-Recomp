+
+class VulkanBackend final : public Backend {
+public:
+  VulkanBackend(SDL_Window* window, std::string pipeline_cache)
+      : window_(window), pipeline_cache_path_(std::move(pipeline_cache)) {}
+
+  ~VulkanBackend() override {
+    stop_warm_up_ = true;
+    if (warm_up_.joinable()) warm_up_.join();
+    if (device_ != nullptr) {
+      vk_.vkDeviceWaitIdle(device_);
+      save_pipeline_cache();
+      shutting_down_ = true;  // what goes now goes at once
+      dummy_.reset();
+      for (auto& frame : frames_) {
+        run_retired(frame);
+        for (auto pool : frame.descriptor_pools) vk_.vkDestroyDescriptorPool(device_, pool, nullptr);
+        destroy_buffer(frame.staging);
+        destroy_buffer(frame.vertices);
+        vk_.vkDestroyCommandPool(device_, frame.command_pool, nullptr);
+        vk_.vkDestroyFence(device_, frame.done, nullptr);
+        vk_.vkDestroySemaphore(device_, frame.acquired, nullptr);
+      }
+      destroy_swapchain();
+      destroy_offscreen();
+      for (auto& [key, pipeline] : pipelines_) vk_.vkDestroyPipeline(device_, pipeline, nullptr);
+      destroy_window_pipelines();
+      vk_.vkDestroyPipelineCache(device_, pipeline_cache_, nullptr);
+      vk_.vkDestroyPipelineLayout(device_, layout_, nullptr);
+      vk_.vkDestroyDescriptorSetLayout(device_, set_layout_, nullptr);
+      for (auto sampler : samplers_) vk_.vkDestroySampler(device_, sampler, nullptr);
+      for (auto module : modules_) vk_.vkDestroyShaderModule(device_, module, nullptr);
+      vk_.vkDestroyRenderPass(device_, target_pass_, nullptr);
+      for (auto& block : blocks_) vk_.vkFreeMemory(device_, block.memory, nullptr);
+      vk_.vkDestroyDevice(device_, nullptr);
+    }
+    if (surface_ != VK_NULL_HANDLE) vk_.vkDestroySurfaceKHR(instance_, surface_, nullptr);
+    if (instance_ != nullptr) vk_.vkDestroyInstance(instance_, nullptr);
+    if (library_ != nullptr) dlclose(library_);
+  }
+
+  bool initialize(std::string& problem) {
+    offscreen_ = std::strcmp(SDL_GetCurrentVideoDriver(), "offscreen") == 0;
+    if (!offscreen_) {
+      vk_.vkGetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(SDL_Vulkan_GetVkGetInstanceProcAddr());
+    } else {
+      // SDL's offscreen windows have no Vulkan: draw into an image instead.
+      library_ = dlopen("libvulkan.so.1", RTLD_NOW | RTLD_LOCAL);
+      if (library_ == nullptr) library_ = dlopen("libvulkan.so", RTLD_NOW | RTLD_LOCAL);
+      if (library_ != nullptr)
+        vk_.vkGetInstanceProcAddr = reinterpret_cast<PFN_vkGetInstanceProcAddr>(dlsym(library_, "vkGetInstanceProcAddr"));
+    }
+    if (vk_.vkGetInstanceProcAddr == nullptr) return fail(problem, "no Vulkan loader");
+    vk_.vkCreateInstance =
+        reinterpret_cast<PFN_vkCreateInstance>(vk_.vkGetInstanceProcAddr(nullptr, "vkCreateInstance"));
+    vk_.vkEnumerateInstanceLayerProperties = reinterpret_cast<PFN_vkEnumerateInstanceLayerProperties>(
+        vk_.vkGetInstanceProcAddr(nullptr, "vkEnumerateInstanceLayerProperties"));
+    if (vk_.vkCreateInstance == nullptr) return fail(problem, "no vkCreateInstance");
+
+    std::vector<const char*> extensions;
+    if (!offscreen_) {
+      unsigned count{};
+      if (SDL_Vulkan_GetInstanceExtensions(window_, &count, nullptr) == SDL_FALSE)
+        return fail(problem, SDL_GetError());
+      extensions.resize(count);
+      SDL_Vulkan_GetInstanceExtensions(window_, &count, extensions.data());
+    }
+    std::vector<const char*> layers;
+    if (std::getenv("REFRACT_VULKAN_VALIDATION") != nullptr && vk_.vkEnumerateInstanceLayerProperties != nullptr) {
+      std::uint32_t count{};
+      vk_.vkEnumerateInstanceLayerProperties(&count, nullptr);
+      std::vector<VkLayerProperties> available(count);
+      vk_.vkEnumerateInstanceLayerProperties(&count, available.data());
+      for (const auto& layer : available)
+        if (std::strcmp(layer.layerName, "VK_LAYER_KHRONOS_validation") == 0)
+          layers.push_back("VK_LAYER_KHRONOS_validation");
+    }
+    VkApplicationInfo application{VK_STRUCTURE_TYPE_APPLICATION_INFO};
+    application.pApplicationName = "refract";
+    application.apiVersion = VK_API_VERSION_1_0;
+    VkInstanceCreateInfo instance_info{VK_STRUCTURE_TYPE_INSTANCE_CREATE_INFO};
+    instance_info.pApplicationInfo = &application;
+    instance_info.enabledExtensionCount = static_cast<std::uint32_t>(extensions.size());
+    instance_info.ppEnabledExtensionNames = extensions.data();
+    instance_info.enabledLayerCount = static_cast<std::uint32_t>(layers.size());
+    instance_info.ppEnabledLayerNames = layers.data();
+    if (const auto result = vk_.vkCreateInstance(&instance_info, nullptr, &instance_); result != VK_SUCCESS)
+      return fail(problem, std::string("no instance: ") + result_name(result));
+#define REFRACT_VULKAN_LOAD(name) \
+  vk_.name = reinterpret_cast<PFN_##name>(vk_.vkGetInstanceProcAddr(instance_, #name));
+    REFRACT_VULKAN_INSTANCE_FUNCTIONS(REFRACT_VULKAN_LOAD)
+#undef REFRACT_VULKAN_LOAD
+    if (!offscreen_ && SDL_Vulkan_CreateSurface(window_, instance_, &surface_) == SDL_FALSE)
+      return fail(problem, std::string("no surface: ") + SDL_GetError());
+
+    if (!choose_device(problem)) return false;
+    if (!create_device(problem)) return false;
+    return create_resources(problem);
+  }
+
+  const char* name() const override { return "Vulkan"; }
+  std::uint32_t max_texture_size() const override { return max_image_size_; }
+
+  std::unique_ptr<Image> create_image(std::uint32_t width, std::uint32_t height, const std::uint8_t* rgba) override {
+    auto image = std::make_unique<VulkanImage>(*this);
+    image->width = width;
+    image->height = height;
+    if (!make_image(*image, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT)) return image;
+    upload(*image, rgba);
+    return image;
+  }
+
+  void update_image(Image& base, const std::uint8_t* rgba) override {
+    auto& image = static_cast<VulkanImage&>(base);
+    if (image.image == VK_NULL_HANDLE) return;
+    begin_frame();
+    // Drawn with in this frame already: those draws keep the old contents, in the old image.
+    if (image.drawn_in == frame_number_) {
+      ++stats_.new_versions;
+      retire_image(image.image, image.view, image.memory);
+      image.image = VK_NULL_HANDLE;
+      image.view = VK_NULL_HANDLE;
+      image.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+      if (!make_image(image, VK_IMAGE_USAGE_SAMPLED_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT)) return;
+    }
+    upload(image, rgba);
+  }
+
+  std::unique_ptr<Target> create_target(std::uint32_t width, std::uint32_t height) override {
+    auto target = std::make_unique<VulkanTarget>(*this);
+    auto& color = target->image;
+    color.width = std::max(width, 1U);
+    color.height = std::max(height, 1U);
+    color.target = true;
+    if (!make_image(color, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_SAMPLED_BIT |
+                               VK_IMAGE_USAGE_TRANSFER_SRC_BIT | VK_IMAGE_USAGE_TRANSFER_DST_BIT))
+      return target;
+    VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = depth_format_;
+    info.extent = {color.width, color.height, 1U};
+    info.mipLevels = 1U;
+    info.arrayLayers = 1U;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = VK_IMAGE_USAGE_DEPTH_STENCIL_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT |
+                 VK_IMAGE_USAGE_TRANSFER_DST_BIT;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!check(vk_.vkCreateImage(device_, &info, nullptr, &target->depth), "depth image")) return target;
+    VkMemoryRequirements requirements{};
+    vk_.vkGetImageMemoryRequirements(device_, target->depth, &requirements);
+    target->depth_memory = allocate(requirements);
+    if (target->depth_memory.memory == VK_NULL_HANDLE) return target;
+    vk_.vkBindImageMemory(device_, target->depth, target->depth_memory.memory, target->depth_memory.offset);
+    target->depth_view = make_view(target->depth, depth_format_, VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT);
+    const VkImageView views[] = {color.view, target->depth_view};
+    VkFramebufferCreateInfo framebuffer{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    framebuffer.renderPass = target_pass_;
+    framebuffer.attachmentCount = 2U;
+    framebuffer.pAttachments = views;
+    framebuffer.width = color.width;
+    framebuffer.height = color.height;
+    framebuffer.layers = 1U;
+    check(vk_.vkCreateFramebuffer(device_, &framebuffer, nullptr, &target->framebuffer), "framebuffer");
+
+    // Cleared to transparent black, depth 1 and stencil 0, as the GL backend's.
+    begin_frame();
+    end_pass();
+    auto command = frame().draw;
+    change_layout(command, color.image, VK_IMAGE_ASPECT_COLOR_BIT, color.layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    change_layout(command, target->depth, VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT,
+                  target->depth_layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    const VkClearColorValue clear_color{};
+    const VkImageSubresourceRange color_range{VK_IMAGE_ASPECT_COLOR_BIT, 0U, 1U, 0U, 1U};
+    vk_.vkCmdClearColorImage(command, color.image, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &clear_color, 1U, &color_range);
+    const VkClearDepthStencilValue clear_depth{1.0F, 0U};
+    const VkImageSubresourceRange depth_range{VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT, 0U, 1U, 0U, 1U};
+    vk_.vkCmdClearDepthStencilImage(command, target->depth, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, &clear_depth, 1U,
+                                    &depth_range);
+    change_layout(command, color.image, VK_IMAGE_ASPECT_COLOR_BIT, color.layout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    change_layout(command, target->depth, VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT,
+                  target->depth_layout, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
+    return target;
+  }
+
+  void copy_target(Target& from_base, Target& to_base) override {
+    auto& from = static_cast<VulkanTarget&>(from_base);
+    auto& to = static_cast<VulkanTarget&>(to_base);
+    if (from.framebuffer == VK_NULL_HANDLE || to.framebuffer == VK_NULL_HANDLE) return;
+    begin_frame();
+    end_pass();
+    auto command = frame().draw;
+    constexpr auto depth_aspect = VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT;
+    change_layout(command, from.image.image, VK_IMAGE_ASPECT_COLOR_BIT, from.image.layout,
+                  VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    change_layout(command, from.depth, depth_aspect, from.depth_layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+    change_layout(command, to.image.image, VK_IMAGE_ASPECT_COLOR_BIT, to.image.layout,
+                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    change_layout(command, to.depth, depth_aspect, to.depth_layout, VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkImageCopy region{};
+    region.srcSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0U, 0U, 1U};
+    region.dstSubresource = region.srcSubresource;
+    region.extent = {std::min(from.image.width, to.image.width), std::min(from.image.height, to.image.height), 1U};
+    vk_.vkCmdCopyImage(command, from.image.image, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, to.image.image,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1U, &region);
+    region.srcSubresource.aspectMask = depth_aspect;
+    region.dstSubresource.aspectMask = depth_aspect;
+    vk_.vkCmdCopyImage(command, from.depth, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, to.depth,
+                       VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1U, &region);
+    for (auto* target : {&from, &to}) {
+      change_layout(command, target->image.image, VK_IMAGE_ASPECT_COLOR_BIT, target->image.layout,
+                    VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+      change_layout(command, target->depth, depth_aspect, target->depth_layout,
+                    VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
+    }
+  }
+
+  void set_vertices(const GeometryVertex* vertices, std::size_t count) override {
+    begin_frame();
+    auto& current = frame();
+    const auto bytes = static_cast<VkDeviceSize>(count * sizeof(GeometryVertex));
+    if (current.vertices_used + bytes > current.vertices.size) {
+      // Draws recorded already use the old buffer: it goes when this frame is done.
+      if (current.vertices.buffer != VK_NULL_HANDLE) {
+        auto old = current.vertices;
+        current.retired.emplace_back([this, old]() mutable { destroy_buffer(old); });
+      }
+      current.vertices = make_buffer(std::max<VkDeviceSize>({bytes, current.vertices.size * 2U, 4U << 20U}),
+                                     VK_BUFFER_USAGE_VERTEX_BUFFER_BIT);
+      current.vertices_used = 0U;
+    }
+    if (current.vertices.mapped == nullptr) return;
+    std::memcpy(current.vertices.mapped + current.vertices_used, vertices, static_cast<std::size_t>(bytes));
+    base_vertex_ = static_cast<std::uint32_t>(current.vertices_used / sizeof(GeometryVertex));
+    current.vertices_used += bytes;
+  }
+
+  void draw(Target& target_base, const Draw& draw) override {
+    auto& target = static_cast<VulkanTarget&>(target_base);
+    if (target.framebuffer == VK_NULL_HANDLE || draw.vertex_count == 0U) return;
+    begin_frame();
+    auto* texture = draw.texture != nullptr ? static_cast<VulkanImage*>(draw.texture) : dummy_.get();
+    if (texture->image == VK_NULL_HANDLE) texture = dummy_.get();
+    if (texture->target) texture->sampled = true;
+    if (texture->target && texture->layout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL) {
+      if (pass_target_ != nullptr) ++stats_.sample_breaks;
+      end_pass();
+      change_layout(frame().draw, texture->image, VK_IMAGE_ASPECT_COLOR_BIT, texture->layout,
+                    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    }
+    texture->drawn_in = frame_number_;
+    ++stats_.draws;
+    begin_target_pass(target);
+    auto command = frame().draw;
+    const auto pipeline = geometry_pipeline(draw.pipeline);
+    if (pipeline == VK_NULL_HANDLE) return;
+    if (pipeline != bound_pipeline_) {
+      vk_.vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      bound_pipeline_ = pipeline;
+    }
+    bind_texture(command, *texture, draw.sampler);
+    if (frame().vertices.buffer != bound_vertices_) {
+      const VkDeviceSize offset = 0U;
+      vk_.vkCmdBindVertexBuffers(command, 0U, 1U, &frame().vertices.buffer, &offset);
+      bound_vertices_ = frame().vertices.buffer;
+    }
+    const auto right = std::clamp(draw.scissor[0] + draw.scissor[2], 0, static_cast<std::int32_t>(target.image.width));
+    const auto bottom = std::clamp(draw.scissor[1] + draw.scissor[3], 0, static_cast<std::int32_t>(target.image.height));
+    const auto left = std::clamp(draw.scissor[0], 0, right);
+    const auto top = std::clamp(draw.scissor[1], 0, bottom);
+    if (right <= left || bottom <= top) return;
+    const VkRect2D scissor{{left, top}, {static_cast<std::uint32_t>(right - left), static_cast<std::uint32_t>(bottom - top)}};
+    vk_.vkCmdSetScissor(command, 0U, 1U, &scissor);
+    if (std::memcmp(draw.blend_color, blend_color_, sizeof(blend_color_)) != 0) {
+      vk_.vkCmdSetBlendConstants(command, draw.blend_color);
+      std::memcpy(blend_color_, draw.blend_color, sizeof(blend_color_));
+    }
+    if (draw.stencil_reference != stencil_[0]) {
+      vk_.vkCmdSetStencilReference(command, VK_STENCIL_FACE_FRONT_AND_BACK, draw.stencil_reference);
+      stencil_[0] = draw.stencil_reference;
+    }
+    if (draw.stencil_read_mask != stencil_[1]) {
+      vk_.vkCmdSetStencilCompareMask(command, VK_STENCIL_FACE_FRONT_AND_BACK, draw.stencil_read_mask);
+      stencil_[1] = draw.stencil_read_mask;
+    }
+    if (draw.stencil_write_mask != stencil_[2]) {
+      vk_.vkCmdSetStencilWriteMask(command, VK_STENCIL_FACE_FRONT_AND_BACK, draw.stencil_write_mask);
+      stencil_[2] = draw.stencil_write_mask;
+    }
+    GeometryConstants constants{};
+    std::memcpy(constants.texture_transform, draw.texture_transform, sizeof(constants.texture_transform));
+    std::memcpy(constants.target_scale, draw.target_scale, sizeof(constants.target_scale));
+    std::memcpy(constants.color_test, draw.color_test, sizeof(constants.color_test));
+    std::memcpy(constants.alpha_test, draw.alpha_test, sizeof(constants.alpha_test));
+    std::memcpy(constants.texture_state, draw.texture_state, sizeof(constants.texture_state));
+    std::memcpy(constants.misc, draw.misc, sizeof(constants.misc));
+    vk_.vkCmdPushConstants(command, layout_, VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0U,
+                           sizeof(constants), &constants);
+    vk_.vkCmdDraw(command, draw.vertex_count, 1U, base_vertex_ + draw.first_vertex, 0U);
+  }
+
+  void drawable_size(int& width, int& height) override {
+    if (offscreen_) {
+      SDL_GetWindowSize(window_, &width, &height);
+      return;
+    }
+    if (swapchain_ != VK_NULL_HANDLE && !swapchain_dirty_) {
+      width = static_cast<int>(logical_extent_.width);
+      height = static_cast<int>(logical_extent_.height);
+      return;
+    }
+    SDL_Vulkan_GetDrawableSize(window_, &width, &height);
+  }
+
+  void draw_picture(const Rect& where, Image& image, float u_scale, float v_scale) override {
+    draw_window(where, static_cast<VulkanImage&>(image), u_scale, v_scale, picture_pipeline_);
+  }
+
+  void draw_overlay(const Rect& where, Image& image) override {
+    draw_window(where, static_cast<VulkanImage&>(image), 1.0F, 1.0F, overlay_pipeline_);
+  }
+
+  void present(std::vector<std::uint8_t>* capture, int* width, int* height) override {
+    begin_frame();
+    if (!window_begun_) begin_window_pass();
+    end_pass();
+    auto& current = frame();
+    VkImage shown{};
+    VkExtent2D extent{};
+    if (offscreen_) {
+      shown = offscreen_image_.image;
+      extent = {offscreen_image_.width, offscreen_image_.height};
+    } else if (acquired_) {
+      shown = swapchain_images_[image_index_];
+      extent = swapchain_extent_;
+    }
+    Buffer readback{};
+    if (capture != nullptr && shown != VK_NULL_HANDLE && (offscreen_ || swapchain_readable_)) {
+      readback = make_buffer(static_cast<VkDeviceSize>(extent.width) * extent.height * 4U,
+                             VK_BUFFER_USAGE_TRANSFER_DST_BIT);
+      auto layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      change_layout(current.draw, shown, VK_IMAGE_ASPECT_COLOR_BIT, layout, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL);
+      VkBufferImageCopy region{};
+      region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0U, 0U, 1U};
+      region.imageExtent = {extent.width, extent.height, 1U};
+      vk_.vkCmdCopyImageToBuffer(current.draw, shown, VK_IMAGE_LAYOUT_TRANSFER_SRC_OPTIMAL, readback.buffer, 1U, &region);
+      if (!offscreen_)
+        change_layout(current.draw, shown, VK_IMAGE_ASPECT_COLOR_BIT, layout, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+      else
+        change_layout(current.draw, shown, VK_IMAGE_ASPECT_COLOR_BIT, layout, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    } else if (!offscreen_ && acquired_) {
+      auto layout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      change_layout(current.draw, shown, VK_IMAGE_ASPECT_COLOR_BIT, layout, VK_IMAGE_LAYOUT_PRESENT_SRC_KHR);
+    }
+    stats_.record_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - frame_started_).count();
+    vk_.vkEndCommandBuffer(current.upload);
+    vk_.vkEndCommandBuffer(current.draw);
+    const VkCommandBuffer commands[] = {current.upload, current.draw};
+    VkSubmitInfo submit{VK_STRUCTURE_TYPE_SUBMIT_INFO};
+    submit.commandBufferCount = 2U;
+    submit.pCommandBuffers = commands;
+    const VkPipelineStageFlags wait_stage = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+    if (acquired_) {
+      submit.waitSemaphoreCount = 1U;
+      submit.pWaitSemaphores = &current.acquired;
+      submit.pWaitDstStageMask = &wait_stage;
+      submit.signalSemaphoreCount = 1U;
+      submit.pSignalSemaphores = &rendered_[image_index_];
+    }
+    vk_.vkResetFences(device_, 1U, &current.done);
+    if (const auto result = vk_.vkQueueSubmit(queue_, 1U, &submit, current.done); result != VK_SUCCESS)
+      std::fprintf(stderr, "refract: Vulkan submit failed (%s)\n", result_name(result));
+    if (readback.buffer != VK_NULL_HANDLE) {
+      vk_.vkWaitForFences(device_, 1U, &current.done, VK_TRUE, UINT64_MAX);
+      capture->assign(readback.mapped, readback.mapped + readback.size);
+      if (window_format_ == VK_FORMAT_B8G8R8A8_UNORM)  // to RGBA
+        for (std::size_t index = 0; index + 3U < capture->size(); index += 4U)
+          std::swap((*capture)[index], (*capture)[index + 2U]);
+      turn_back(*capture, extent);
+      if (width != nullptr) *width = static_cast<int>(logical_extent_.width);
+      if (height != nullptr) *height = static_cast<int>(logical_extent_.height);
+      destroy_buffer(readback);
+    } else if (capture != nullptr) {
+      capture->clear();
+    }
+    if (acquired_) {
+      VkPresentInfoKHR present{VK_STRUCTURE_TYPE_PRESENT_INFO_KHR};
+      present.waitSemaphoreCount = 1U;
+      present.pWaitSemaphores = &rendered_[image_index_];
+      present.swapchainCount = 1U;
+      present.pSwapchains = &swapchain_;
+      present.pImageIndices = &image_index_;
+      const auto result = vk_.vkQueuePresentKHR(queue_, &present);
+      if (result == VK_ERROR_OUT_OF_DATE_KHR || result == VK_SUBOPTIMAL_KHR) swapchain_dirty_ = true;
+      else if (result == VK_ERROR_SURFACE_LOST_KHR) surface_lost_ = true;
+      else if (result != VK_SUCCESS) std::fprintf(stderr, "refract: Vulkan present failed (%s)\n", result_name(result));
+    }
+    recording_ = false;
+    acquired_ = false;
+    if (print_stats_ && ++stats_.frames % 300U == 0U) {
+      const auto per = [&](double value) { return value / 300.0; };
+      std::fprintf(stderr,
+                   "[refract:vulkan] per frame: %.0f draws, %.1f passes (%.1f broken to sample), %.1f uploads (%.0f KB, "
+                   "%.2f new images), %.2f pipelines made (%.2f ms); %.2f ms recording, %.2f ms waiting for the GPU\n",
+                   per(stats_.draws), per(stats_.passes), per(stats_.sample_breaks), per(stats_.uploads),
+                   per(stats_.upload_bytes) / 1024.0, per(stats_.new_versions), per(stats_.pipelines),
+                   per(stats_.pipeline_ms), per(stats_.record_ms), per(stats_.wait_ms));
+      stats_ = {};
+    }
+    window_begun_ = false;
+    frame_index_ = (frame_index_ + 1U) % frames_.size();
+    if (pipelines_unsaved_ > 0U &&
+        std::chrono::steady_clock::now() - last_cache_save_ > std::chrono::seconds(10)) {
+      save_pipeline_cache();
+    }
+  }
+
+  // An image's memory and objects, freed when the frames drawing with it are done.
+  void retire_image(VkImage image, VkImageView view, Allocation memory) {
+    if (device_ == nullptr) return;
+    auto release = [this, image, view, memory] {
+      if (view != VK_NULL_HANDLE) vk_.vkDestroyImageView(device_, view, nullptr);
+      if (image != VK_NULL_HANDLE) vk_.vkDestroyImage(device_, image, nullptr);
+      free(memory);
+    };
+    if (shutting_down_) {
+      release();
+      return;
+    }
+    if (!recording_) begin_frame();
+    frame().retired.emplace_back(std::move(release));
+  }
+
+  void retire_framebuffer(VkFramebuffer framebuffer) {
+    if (device_ == nullptr || framebuffer == VK_NULL_HANDLE) return;
+    if (shutting_down_) {
+      vk_.vkDestroyFramebuffer(device_, framebuffer, nullptr);
+      return;
+    }
+    if (!recording_) begin_frame();
+    frame().retired.emplace_back([this, framebuffer] { vk_.vkDestroyFramebuffer(device_, framebuffer, nullptr); });
+  }
+
+  // A render target going while a pass is open on it: the pass ends first.
+  void forget_target(VulkanTarget& target) {
+    if (pass_target_ == &target) end_pass();
+  }
+
+private:
+  struct Frame {
+    VkCommandPool command_pool{};
+    VkCommandBuffer upload{};
+    VkCommandBuffer draw{};
+    VkFence done{};
+    VkSemaphore acquired{};
+    Buffer staging;
+    VkDeviceSize staging_used{};
+    Buffer vertices;
+    VkDeviceSize vertices_used{};
+    std::vector<VkDescriptorPool> descriptor_pools;
+    std::size_t pools_used{};
+    std::unordered_map<std::uint64_t, VkDescriptorSet> sets;
+    std::vector<std::function<void()>> retired;
+  };
+
+  struct Block {
+    VkDeviceMemory memory{};
+    VkDeviceSize size{};
+    std::uint32_t type{};
+    std::map<VkDeviceSize, VkDeviceSize> free;  // offset to size
+  };
+
+  static bool fail(std::string& problem, std::string reason) {
+    problem = std::move(reason);
+    return false;
+  }
+
+  bool check(VkResult result, const char* what) {
+    if (result == VK_SUCCESS) return true;
+    std::fprintf(stderr, "refract: Vulkan: %s failed (%s)\n", what, result_name(result));
+    return false;
+  }
+
+  Frame& frame() { return frames_[frame_index_]; }
+
+  bool choose_device(std::string& problem) {
+    std::uint32_t count{};
+    vk_.vkEnumeratePhysicalDevices(instance_, &count, nullptr);
+    std::vector<VkPhysicalDevice> devices(count);
+    vk_.vkEnumeratePhysicalDevices(instance_, &count, devices.data());
+    const bool allow_cpu = offscreen_ || std::getenv("REFRACT_VULKAN_ALLOW_CPU") != nullptr;
+    int best_score = -1;
+    std::string seen;
+    for (auto device : devices) {
+      VkPhysicalDeviceProperties properties{};
+      vk_.vkGetPhysicalDeviceProperties(device, &properties);
+      seen += std::string(seen.empty() ? "" : ", ") + properties.deviceName;
+      // A software device draws slower than OpenGL on the GPU would.
+      if (properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU && !allow_cpu) continue;
+      std::uint32_t family_count{};
+      vk_.vkGetPhysicalDeviceQueueFamilyProperties(device, &family_count, nullptr);
+      std::vector<VkQueueFamilyProperties> families(family_count);
+      vk_.vkGetPhysicalDeviceQueueFamilyProperties(device, &family_count, families.data());
+      std::optional<std::uint32_t> family;
+      for (std::uint32_t index = 0; index < family_count && !family; ++index) {
+        if ((families[index].queueFlags & VK_QUEUE_GRAPHICS_BIT) == 0U) continue;
+        VkBool32 presents = VK_TRUE;
+        if (!offscreen_) vk_.vkGetPhysicalDeviceSurfaceSupportKHR(device, index, surface_, &presents);
+        if (presents == VK_TRUE) family = index;
+      }
+      if (!family) continue;
+      if (!offscreen_) {
+        std::uint32_t extension_count{};
+        vk_.vkEnumerateDeviceExtensionProperties(device, nullptr, &extension_count, nullptr);
+        std::vector<VkExtensionProperties> extensions(extension_count);
+        vk_.vkEnumerateDeviceExtensionProperties(device, nullptr, &extension_count, extensions.data());
+        if (std::none_of(extensions.begin(), extensions.end(), [](const auto& extension) {
+              return std::strcmp(extension.extensionName, VK_KHR_SWAPCHAIN_EXTENSION_NAME) == 0;
+            }))
+          continue;
+      }
+      VkFormat depth_format = VK_FORMAT_UNDEFINED;
+      for (auto format : {VK_FORMAT_D24_UNORM_S8_UINT, VK_FORMAT_D32_SFLOAT_S8_UINT}) {
+        VkFormatProperties format_properties{};
+        vk_.vkGetPhysicalDeviceFormatProperties(device, format, &format_properties);
+        if ((format_properties.optimalTilingFeatures & VK_FORMAT_FEATURE_DEPTH_STENCIL_ATTACHMENT_BIT) != 0U) {
+          depth_format = format;
+          break;
+        }
+      }
+      if (depth_format == VK_FORMAT_UNDEFINED) continue;
+      int score = 1;
+      if (properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_DISCRETE_GPU) score = 4;
+      else if (properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_INTEGRATED_GPU) score = 3;
+      else if (properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_VIRTUAL_GPU) score = 2;
+      else if (properties.deviceType == VK_PHYSICAL_DEVICE_TYPE_CPU) score = 0;
+      if (score <= best_score) continue;
+      best_score = score;
+      physical_device_ = device;
+      queue_family_ = *family;
+      depth_format_ = depth_format;
+      max_image_size_ = properties.limits.maxImageDimension2D;
+      device_name_ = properties.deviceName;
+    }
+    if (physical_device_ == VK_NULL_HANDLE)
+      return fail(problem, seen.empty() ? "no Vulkan device" : "no Vulkan device that can draw here (" + seen + ")");
+    vk_.vkGetPhysicalDeviceMemoryProperties(physical_device_, &memory_properties_);
+    return true;
+  }
+
+  bool create_device(std::string& problem) {
+    const float priority = 1.0F;
+    VkDeviceQueueCreateInfo queue_info{VK_STRUCTURE_TYPE_DEVICE_QUEUE_CREATE_INFO};
+    queue_info.queueFamilyIndex = queue_family_;
+    queue_info.queueCount = 1U;
+    queue_info.pQueuePriorities = &priority;
+    const char* extensions[] = {VK_KHR_SWAPCHAIN_EXTENSION_NAME};
+    VkDeviceCreateInfo info{VK_STRUCTURE_TYPE_DEVICE_CREATE_INFO};
+    info.queueCreateInfoCount = 1U;
+    info.pQueueCreateInfos = &queue_info;
+    info.enabledExtensionCount = offscreen_ ? 0U : 1U;
+    info.ppEnabledExtensionNames = extensions;
+    if (const auto result = vk_.vkCreateDevice(physical_device_, &info, nullptr, &device_); result != VK_SUCCESS)
+      return fail(problem, std::string("no device: ") + result_name(result));
+#define REFRACT_VULKAN_LOAD(name) vk_.name = reinterpret_cast<PFN_##name>(vk_.vkGetDeviceProcAddr(device_, #name));
+    REFRACT_VULKAN_DEVICE_FUNCTIONS(REFRACT_VULKAN_LOAD)
+#undef REFRACT_VULKAN_LOAD
+    vk_.vkGetDeviceQueue(device_, queue_family_, 0U, &queue_);
+    std::fprintf(stderr, "[refract:vulkan] %s\n", device_name_.c_str());
+    return true;
+  }
+
+  VkShaderModule make_module(const std::uint32_t* code, std::size_t bytes) {
+    VkShaderModuleCreateInfo info{VK_STRUCTURE_TYPE_SHADER_MODULE_CREATE_INFO};
+    info.codeSize = bytes;
+    info.pCode = code;
+    VkShaderModule module{};
+    check(vk_.vkCreateShaderModule(device_, &info, nullptr, &module), "shader");
+    modules_.push_back(module);
+    return module;
+  }
+
+  bool create_resources(std::string& problem) {
+    // The render targets' pass: colour and depth/stencil kept, before and after.
+    VkAttachmentDescription attachments[2]{};
+    attachments[0].format = VK_FORMAT_R8G8B8A8_UNORM;
+    attachments[0].samples = VK_SAMPLE_COUNT_1_BIT;
+    attachments[0].loadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    attachments[0].storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachments[0].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+    attachments[0].stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+    attachments[0].initialLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    attachments[0].finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+    attachments[1] = attachments[0];
+    attachments[1].format = depth_format_;
+    attachments[1].stencilLoadOp = VK_ATTACHMENT_LOAD_OP_LOAD;
+    attachments[1].stencilStoreOp = VK_ATTACHMENT_STORE_OP_STORE;
+    attachments[1].initialLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    attachments[1].finalLayout = VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL;
+    const VkAttachmentReference color_reference{0U, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+    const VkAttachmentReference depth_reference{1U, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL};
+    VkSubpassDescription subpass{};
+    subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+    subpass.colorAttachmentCount = 1U;
+    subpass.pColorAttachments = &color_reference;
+    subpass.pDepthStencilAttachment = &depth_reference;
+    VkRenderPassCreateInfo pass{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+    pass.attachmentCount = 2U;
+    pass.pAttachments = attachments;
+    pass.subpassCount = 1U;
+    pass.pSubpasses = &subpass;
+    if (!check(vk_.vkCreateRenderPass(device_, &pass, nullptr, &target_pass_), "render pass"))
+      return fail(problem, "no render pass");
+
+    VkDescriptorSetLayoutBinding binding{};
+    binding.binding = 0U;
+    binding.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+    binding.descriptorCount = 1U;
+    binding.stageFlags = VK_SHADER_STAGE_FRAGMENT_BIT;
+    VkDescriptorSetLayoutCreateInfo set_layout{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_LAYOUT_CREATE_INFO};
+    set_layout.bindingCount = 1U;
+    set_layout.pBindings = &binding;
+    check(vk_.vkCreateDescriptorSetLayout(device_, &set_layout, nullptr, &set_layout_), "descriptor set layout");
+    const VkPushConstantRange push{VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0U,
+                                   sizeof(GeometryConstants)};
+    VkPipelineLayoutCreateInfo layout{VK_STRUCTURE_TYPE_PIPELINE_LAYOUT_CREATE_INFO};
+    layout.setLayoutCount = 1U;
+    layout.pSetLayouts = &set_layout_;
+    layout.pushConstantRangeCount = 1U;
+    layout.pPushConstantRanges = &push;
+    if (!check(vk_.vkCreatePipelineLayout(device_, &layout, nullptr, &layout_), "pipeline layout"))
+      return fail(problem, "no pipeline layout");
+
+    geometry_vertex_ = make_module(shaders::geometry_vert, sizeof(shaders::geometry_vert));
+    geometry_fragment_ = make_module(shaders::geometry_frag, sizeof(shaders::geometry_frag));
+    window_vertex_ = make_module(shaders::window_vert, sizeof(shaders::window_vert));
+    picture_fragment_ = make_module(shaders::picture_frag, sizeof(shaders::picture_frag));
+    overlay_fragment_ = make_module(shaders::overlay_frag, sizeof(shaders::overlay_frag));
+
+    for (std::size_t index = 0; index < samplers_.size(); ++index) {
+      VkSamplerCreateInfo info{VK_STRUCTURE_TYPE_SAMPLER_CREATE_INFO};
+      info.minFilter = (index & 8U) != 0U ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+      info.magFilter = (index & 4U) != 0U ? VK_FILTER_LINEAR : VK_FILTER_NEAREST;
+      info.mipmapMode = VK_SAMPLER_MIPMAP_MODE_NEAREST;
+      info.addressModeV = (index & 2U) != 0U ? VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE : VK_SAMPLER_ADDRESS_MODE_REPEAT;
+      info.addressModeU = (index & 1U) != 0U ? VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE : VK_SAMPLER_ADDRESS_MODE_REPEAT;
+      info.addressModeW = VK_SAMPLER_ADDRESS_MODE_CLAMP_TO_EDGE;
+      info.maxLod = 0.25F;
+      check(vk_.vkCreateSampler(device_, &info, nullptr, &samplers_[index]), "sampler");
+    }
+
+    std::vector<char> cached;
+    if (!pipeline_cache_path_.empty()) {
+      std::ifstream file(pipeline_cache_path_, std::ios::binary);
+      cached.assign(std::istreambuf_iterator<char>(file), std::istreambuf_iterator<char>());
+    }
+    VkPipelineCacheCreateInfo cache{VK_STRUCTURE_TYPE_PIPELINE_CACHE_CREATE_INFO};
+    cache.initialDataSize = cached.size();
+    cache.pInitialData = cached.empty() ? nullptr : cached.data();
+    if (vk_.vkCreatePipelineCache(device_, &cache, nullptr, &pipeline_cache_) != VK_SUCCESS) {
+      cache.initialDataSize = 0U;  // the driver didn't take the old one
+      cache.pInitialData = nullptr;
+      vk_.vkCreatePipelineCache(device_, &cache, nullptr, &pipeline_cache_);
+    }
+    last_cache_save_ = std::chrono::steady_clock::now();
+    // The pipelines earlier runs made, made again (from the cache, quickly) on another core before
+    // the game needs them: making one the first time a draw needs it holds up the frame.
+    std::vector<std::uint64_t> keys;
+    if (!pipeline_cache_path_.empty()) {
+      std::ifstream file(pipeline_cache_path_ + ".keys");
+      std::string line;
+      while (std::getline(file, line))
+        if (!line.empty()) keys.push_back(std::strtoull(line.c_str(), nullptr, 16));
+    }
+    if (!keys.empty())
+      warm_up_ = std::thread([this, keys] {
+        for (const auto key : keys) {
+          if (stop_warm_up_) return;
+          {
+            std::lock_guard lock(pipelines_mutex_);
+            if (pipelines_.count(key) != 0U) continue;
+          }
+          const auto state = pipeline_from_key(key);
+          if (!state) continue;
+          const auto pipeline = make_pipeline(geometry_vertex_, geometry_fragment_, target_pass_, &*state, true);
+          if (pipeline == VK_NULL_HANDLE) continue;
+          std::lock_guard lock(pipelines_mutex_);
+          if (!pipelines_.emplace(key, pipeline).second) vk_.vkDestroyPipeline(device_, pipeline, nullptr);
+        }
+      });
+
+    for (auto& frame : frames_) {
+      VkCommandPoolCreateInfo pool{VK_STRUCTURE_TYPE_COMMAND_POOL_CREATE_INFO};
+      pool.flags = VK_COMMAND_POOL_CREATE_TRANSIENT_BIT;
+      pool.queueFamilyIndex = queue_family_;
+      if (!check(vk_.vkCreateCommandPool(device_, &pool, nullptr, &frame.command_pool), "command pool"))
+        return fail(problem, "no command pool");
+      VkCommandBufferAllocateInfo buffers{VK_STRUCTURE_TYPE_COMMAND_BUFFER_ALLOCATE_INFO};
+      buffers.commandPool = frame.command_pool;
+      buffers.level = VK_COMMAND_BUFFER_LEVEL_PRIMARY;
+      buffers.commandBufferCount = 2U;
+      VkCommandBuffer made[2]{};
+      check(vk_.vkAllocateCommandBuffers(device_, &buffers, made), "command buffers");
+      frame.upload = made[0];
+      frame.draw = made[1];
+      VkFenceCreateInfo fence{VK_STRUCTURE_TYPE_FENCE_CREATE_INFO};
+      fence.flags = VK_FENCE_CREATE_SIGNALED_BIT;
+      check(vk_.vkCreateFence(device_, &fence, nullptr, &frame.done), "fence");
+      VkSemaphoreCreateInfo semaphore{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+      check(vk_.vkCreateSemaphore(device_, &semaphore, nullptr, &frame.acquired), "semaphore");
+    }
+
+    const std::uint8_t white[4] = {255U, 255U, 255U, 255U};
+    auto dummy = create_image(1U, 1U, white);
+    dummy_.reset(static_cast<VulkanImage*>(dummy.release()));
+    if (dummy_->image == VK_NULL_HANDLE) return fail(problem, "can't make images");
+    if (offscreen_) {
+      window_format_ = VK_FORMAT_R8G8B8A8_UNORM;
+      if (!create_window_pipelines()) return fail(problem, "no window pipelines");
+    } else if (!create_swapchain()) {
+      return fail(problem, "no swapchain");
+    }
+    // Make sure the first frame runs: it's where a driver that can't really draw shows it.
+    present(nullptr, nullptr, nullptr);
+    return true;
+  }
+
+  // Window drawing: its passes (the first of a frame clears, later ones keep what's there) and
+  // pipelines, for the window's format.
+  bool create_window_pipelines() {
+    destroy_window_pipelines();
+    for (int load = 0; load < 2; ++load) {
+      VkAttachmentDescription attachment{};
+      attachment.format = window_format_;
+      attachment.samples = VK_SAMPLE_COUNT_1_BIT;
+      attachment.loadOp = load != 0 ? VK_ATTACHMENT_LOAD_OP_LOAD : VK_ATTACHMENT_LOAD_OP_CLEAR;
+      attachment.storeOp = VK_ATTACHMENT_STORE_OP_STORE;
+      attachment.stencilLoadOp = VK_ATTACHMENT_LOAD_OP_DONT_CARE;
+      attachment.stencilStoreOp = VK_ATTACHMENT_STORE_OP_DONT_CARE;
+      attachment.initialLayout =
+          load != 0 ? VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL : VK_IMAGE_LAYOUT_UNDEFINED;
+      attachment.finalLayout = VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL;
+      const VkAttachmentReference reference{0U, VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL};
+      VkSubpassDescription subpass{};
+      subpass.pipelineBindPoint = VK_PIPELINE_BIND_POINT_GRAPHICS;
+      subpass.colorAttachmentCount = 1U;
+      subpass.pColorAttachments = &reference;
+      // The swapchain image is ready when acquiring it signals; drawing waits for that.
+      VkSubpassDependency dependency{};
+      dependency.srcSubpass = VK_SUBPASS_EXTERNAL;
+      dependency.dstSubpass = 0U;
+      dependency.srcStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+      dependency.dstStageMask = VK_PIPELINE_STAGE_COLOR_ATTACHMENT_OUTPUT_BIT;
+      dependency.dstAccessMask = VK_ACCESS_COLOR_ATTACHMENT_READ_BIT | VK_ACCESS_COLOR_ATTACHMENT_WRITE_BIT;
+      VkRenderPassCreateInfo pass{VK_STRUCTURE_TYPE_RENDER_PASS_CREATE_INFO};
+      pass.attachmentCount = 1U;
+      pass.pAttachments = &attachment;
+      pass.subpassCount = 1U;
+      pass.pSubpasses = &subpass;
+      pass.dependencyCount = 1U;
+      pass.pDependencies = &dependency;
+      if (!check(vk_.vkCreateRenderPass(device_, &pass, nullptr, &window_passes_[load]), "window pass")) return false;
+    }
+    picture_pipeline_ = make_pipeline(window_vertex_, picture_fragment_, window_passes_[0], nullptr);
+    Pipeline overlay;
+    overlay.blend = true;
+    overlay_pipeline_ = make_pipeline(window_vertex_, overlay_fragment_, window_passes_[0], &overlay);
+    return picture_pipeline_ != VK_NULL_HANDLE && overlay_pipeline_ != VK_NULL_HANDLE;
+  }
+
+  void destroy_window_pipelines() {
+    for (auto& pipeline : {picture_pipeline_, overlay_pipeline_})
+      if (pipeline != VK_NULL_HANDLE) vk_.vkDestroyPipeline(device_, pipeline, nullptr);
+    picture_pipeline_ = overlay_pipeline_ = VK_NULL_HANDLE;
+    for (auto& pass : window_passes_) {
+      if (pass != VK_NULL_HANDLE) vk_.vkDestroyRenderPass(device_, pass, nullptr);
+      pass = VK_NULL_HANDLE;
+    }
+  }
+
+  // A pipeline: the geometry's (`state` its fixed-function state), or the window's (no state:
+  // drawn whole; the overlay's: blended over).
+  VkPipeline make_pipeline(VkShaderModule vertex, VkShaderModule fragment, VkRenderPass pass, const Pipeline* state,
+                           bool geometry = false) {
+    VkPipelineShaderStageCreateInfo stages[2]{};
+    stages[0].sType = VK_STRUCTURE_TYPE_PIPELINE_SHADER_STAGE_CREATE_INFO;
+    stages[0].stage = VK_SHADER_STAGE_VERTEX_BIT;
+    stages[0].module = vertex;
+    stages[0].pName = "main";
+    stages[1] = stages[0];
+    stages[1].stage = VK_SHADER_STAGE_FRAGMENT_BIT;
+    stages[1].module = fragment;
+    const VkVertexInputBindingDescription binding{0U, sizeof(GeometryVertex), VK_VERTEX_INPUT_RATE_VERTEX};
+    const VkVertexInputAttributeDescription attributes[] = {
+        {0U, 0U, VK_FORMAT_R32G32B32A32_SFLOAT, static_cast<std::uint32_t>(offsetof(GeometryVertex, position))},
+        {1U, 0U, VK_FORMAT_R32G32B32A32_SFLOAT, static_cast<std::uint32_t>(offsetof(GeometryVertex, color))},
+        {2U, 0U, VK_FORMAT_R32G32B32_SFLOAT, static_cast<std::uint32_t>(offsetof(GeometryVertex, texture))}};
+    VkPipelineVertexInputStateCreateInfo input{VK_STRUCTURE_TYPE_PIPELINE_VERTEX_INPUT_STATE_CREATE_INFO};
+    if (geometry) {
+      input.vertexBindingDescriptionCount = 1U;
+      input.pVertexBindingDescriptions = &binding;
+      input.vertexAttributeDescriptionCount = 3U;
+      input.pVertexAttributeDescriptions = attributes;
+    }
+    constexpr VkPrimitiveTopology topologies[] = {
+        VK_PRIMITIVE_TOPOLOGY_POINT_LIST, VK_PRIMITIVE_TOPOLOGY_LINE_LIST, VK_PRIMITIVE_TOPOLOGY_LINE_STRIP,
+        VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST, VK_PRIMITIVE_TOPOLOGY_TRIANGLE_STRIP};
+    VkPipelineInputAssemblyStateCreateInfo assembly{VK_STRUCTURE_TYPE_PIPELINE_INPUT_ASSEMBLY_STATE_CREATE_INFO};
+    assembly.topology = geometry ? topologies[std::min<std::uint8_t>(state->primitive, 4U)]
+                                 : VK_PRIMITIVE_TOPOLOGY_TRIANGLE_LIST;
+    VkPipelineViewportStateCreateInfo viewport{VK_STRUCTURE_TYPE_PIPELINE_VIEWPORT_STATE_CREATE_INFO};
+    viewport.viewportCount = 1U;
+    viewport.scissorCount = 1U;
+    VkPipelineRasterizationStateCreateInfo raster{VK_STRUCTURE_TYPE_PIPELINE_RASTERIZATION_STATE_CREATE_INFO};
+    raster.polygonMode = VK_POLYGON_MODE_FILL;
+    raster.cullMode = geometry && state->cull ? VK_CULL_MODE_BACK_BIT : VK_CULL_MODE_NONE;
+    // Vulkan's rows go down where OpenGL's go up: the same triangle turns the other way, so the GE's
+    // clockwise front is Vulkan's clockwise (OpenGL's counter-clockwise; gpu_gl.cpp).
+    raster.frontFace = geometry && !state->front_clockwise ? VK_FRONT_FACE_COUNTER_CLOCKWISE : VK_FRONT_FACE_CLOCKWISE;
+    raster.lineWidth = 1.0F;
+    VkPipelineMultisampleStateCreateInfo multisample{VK_STRUCTURE_TYPE_PIPELINE_MULTISAMPLE_STATE_CREATE_INFO};
+    multisample.rasterizationSamples = VK_SAMPLE_COUNT_1_BIT;
+    VkPipelineDepthStencilStateCreateInfo depth{VK_STRUCTURE_TYPE_PIPELINE_DEPTH_STENCIL_STATE_CREATE_INFO};
+    VkPipelineColorBlendAttachmentState blend{};
+    blend.colorWriteMask = VK_COLOR_COMPONENT_R_BIT | VK_COLOR_COMPONENT_G_BIT | VK_COLOR_COMPONENT_B_BIT |
+                           VK_COLOR_COMPONENT_A_BIT;
+    if (geometry) {
+      depth.depthTestEnable = state->depth ? VK_TRUE : VK_FALSE;
+      depth.depthWriteEnable = state->depth && state->depth_write ? VK_TRUE : VK_FALSE;
+      depth.depthCompareOp = compare_op(state->depth_function);
+      depth.stencilTestEnable = state->stencil ? VK_TRUE : VK_FALSE;
+      depth.front.failOp = stencil_op(state->stencil_fail);
+      depth.front.passOp = stencil_op(state->stencil_pass);
+      depth.front.depthFailOp = stencil_op(state->stencil_depth_fail);
+      depth.front.compareOp = compare_op(state->stencil_function);
+      depth.front.compareMask = 0xffU;
+      depth.front.writeMask = 0xffU;
+      depth.back = depth.front;
+      blend.colorWriteMask = static_cast<VkColorComponentFlags>(state->color_mask & 0xfU);
+      if (state->blend) {
+        blend.blendEnable = VK_TRUE;
+        blend.srcColorBlendFactor = blend.srcAlphaBlendFactor = blend_factor(state->blend_source);
+        blend.dstColorBlendFactor = blend.dstAlphaBlendFactor = blend_factor(state->blend_destination);
+        blend.colorBlendOp = blend.alphaBlendOp = blend_op(state->blend_operation);
+      }
+    } else if (state != nullptr && state->blend) {
+      blend.blendEnable = VK_TRUE;
+      blend.srcColorBlendFactor = VK_BLEND_FACTOR_SRC_ALPHA;
+      blend.dstColorBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+      blend.colorBlendOp = VK_BLEND_OP_ADD;
+      blend.srcAlphaBlendFactor = VK_BLEND_FACTOR_ONE;
+      blend.dstAlphaBlendFactor = VK_BLEND_FACTOR_ONE_MINUS_SRC_ALPHA;
+      blend.alphaBlendOp = VK_BLEND_OP_ADD;
+    }
+    VkPipelineColorBlendStateCreateInfo blending{VK_STRUCTURE_TYPE_PIPELINE_COLOR_BLEND_STATE_CREATE_INFO};
+    blending.attachmentCount = 1U;
+    blending.pAttachments = &blend;
+    const VkDynamicState geometry_dynamic[] = {VK_DYNAMIC_STATE_VIEWPORT, VK_DYNAMIC_STATE_SCISSOR,
+                                               VK_DYNAMIC_STATE_BLEND_CONSTANTS, VK_DYNAMIC_STATE_STENCIL_COMPARE_MASK,
+                                               VK_DYNAMIC_STATE_STENCIL_WRITE_MASK, VK_DYNAMIC_STATE_STENCIL_REFERENCE};
+    VkPipelineDynamicStateCreateInfo dynamic{VK_STRUCTURE_TYPE_PIPELINE_DYNAMIC_STATE_CREATE_INFO};
+    dynamic.dynamicStateCount = geometry ? 6U : 2U;
+    dynamic.pDynamicStates = geometry_dynamic;
+    VkGraphicsPipelineCreateInfo info{VK_STRUCTURE_TYPE_GRAPHICS_PIPELINE_CREATE_INFO};
+    info.stageCount = 2U;
+    info.pStages = stages;
+    info.pVertexInputState = &input;
+    info.pInputAssemblyState = &assembly;
+    info.pViewportState = &viewport;
+    info.pRasterizationState = &raster;
+    info.pMultisampleState = &multisample;
+    info.pDepthStencilState = geometry ? &depth : nullptr;
+    info.pColorBlendState = &blending;
+    info.pDynamicState = &dynamic;
+    info.layout = layout_;
+    info.renderPass = pass;
+    VkPipeline pipeline{};
+    if (!check(vk_.vkCreateGraphicsPipelines(device_, pipeline_cache_, 1U, &info, nullptr, &pipeline), "pipeline"))
+      return VK_NULL_HANDLE;
+    ++pipelines_unsaved_;
+    return pipeline;
+  }
+
+  VkPipeline geometry_pipeline(const Pipeline& state) {
+    const auto key = pipeline_key(state);
+    {
+      std::lock_guard lock(pipelines_mutex_);
+      if (const auto found = pipelines_.find(key); found != pipelines_.end()) return found->second;
+    }
+    const auto started = std::chrono::steady_clock::now();
+    const auto pipeline = make_pipeline(geometry_vertex_, geometry_fragment_, target_pass_, &state, true);
+    ++stats_.pipelines;
+    stats_.pipeline_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count();
+    std::lock_guard lock(pipelines_mutex_);
+    const auto [found, made] = pipelines_.emplace(key, pipeline);
+    if (!made) vk_.vkDestroyPipeline(device_, pipeline, nullptr);  // the warm-up made it meanwhile
+    return found->second;
+  }
+
+  void save_pipeline_cache() {
+    pipelines_unsaved_ = 0U;
+    last_cache_save_ = std::chrono::steady_clock::now();
+    if (pipeline_cache_path_.empty() || pipeline_cache_ == VK_NULL_HANDLE) return;
+    std::size_t size{};
+    if (vk_.vkGetPipelineCacheData(device_, pipeline_cache_, &size, nullptr) != VK_SUCCESS || size == 0U) return;
+    std::vector<char> data(size);
+    if (vk_.vkGetPipelineCacheData(device_, pipeline_cache_, &size, data.data()) != VK_SUCCESS) return;
+    const auto partial = pipeline_cache_path_ + ".new";
+    {
+      std::ofstream file(partial, std::ios::binary | std::ios::trunc);
+      file.write(data.data(), static_cast<std::streamsize>(size));
+      if (!file) return;
+    }
+    std::error_code error;
+    std::filesystem::rename(partial, pipeline_cache_path_, error);
+    // Which pipelines, for making them ahead next time.
+    std::ostringstream keys;
+    {
+      std::lock_guard lock(pipelines_mutex_);
+      for (const auto& [key, pipeline] : pipelines_)
+        if (pipeline != VK_NULL_HANDLE) keys << std::hex << key << '\n';
+    }
+    {
+      std::ofstream file(pipeline_cache_path_ + ".keys.new", std::ios::trunc);
+      file << keys.str();
+      if (!file) return;
+    }
+    std::filesystem::rename(pipeline_cache_path_ + ".keys.new", pipeline_cache_path_ + ".keys", error);
+  }
+
+  // Memory --------------------------------------------------------------------------------
+
+  std::optional<std::uint32_t> memory_type(std::uint32_t allowed, VkMemoryPropertyFlags wanted) const {
+    for (std::uint32_t index = 0; index < memory_properties_.memoryTypeCount; ++index)
+      if ((allowed & (1U << index)) != 0U &&
+          (memory_properties_.memoryTypes[index].propertyFlags & wanted) == wanted)
+        return index;
+    return std::nullopt;
+  }
+
+  Allocation allocate(const VkMemoryRequirements& requirements) {
+    auto type = memory_type(requirements.memoryTypeBits, VK_MEMORY_PROPERTY_DEVICE_LOCAL_BIT);
+    if (!type) type = memory_type(requirements.memoryTypeBits, 0U);
+    if (!type) return {};
+    constexpr VkDeviceSize block_size = 32U << 20U;
+    if (requirements.size <= block_size / 2U) {
+      for (std::size_t index = 0; index < blocks_.size(); ++index) {
+        auto& block = blocks_[index];
+        if (block.type != *type) continue;
+        for (auto range = block.free.begin(); range != block.free.end(); ++range) {
+          const auto start = (range->first + requirements.alignment - 1U) / requirements.alignment * requirements.alignment;
+          const auto end = range->first + range->second;
+          if (start + requirements.size > end) continue;
+          const auto range_start = range->first;
+          block.free.erase(range);
+          if (start > range_start) block.free.emplace(range_start, start - range_start);
+          if (start + requirements.size < end) block.free.emplace(start + requirements.size, end - start - requirements.size);
+          return {block.memory, start, requirements.size, index};
+        }
+      }
+      VkMemoryAllocateInfo info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+      info.allocationSize = block_size;
+      info.memoryTypeIndex = *type;
+      VkDeviceMemory memory{};
+      if (vk_.vkAllocateMemory(device_, &info, nullptr, &memory) == VK_SUCCESS) {
+        Block block;
+        block.memory = memory;
+        block.size = block_size;
+        block.type = *type;
+        block.free.emplace(requirements.size, block_size - requirements.size);
+        blocks_.push_back(std::move(block));
+        return {memory, 0U, requirements.size, blocks_.size() - 1U};
+      }
+    }
+    VkMemoryAllocateInfo info{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    info.allocationSize = requirements.size;
+    info.memoryTypeIndex = *type;
+    VkDeviceMemory memory{};
+    if (!check(vk_.vkAllocateMemory(device_, &info, nullptr, &memory), "memory")) return {};
+    return {memory, 0U, requirements.size, no_block};
+  }
+
+  void free(const Allocation& allocation) {
+    if (allocation.memory == VK_NULL_HANDLE) return;
+    if (allocation.block == no_block) {
+      vk_.vkFreeMemory(device_, allocation.memory, nullptr);
+      return;
+    }
+    auto& free_ranges = blocks_[allocation.block].free;
+    auto offset = allocation.offset;
+    auto size = allocation.size;
+    // Joined with the free ranges either side.
+    auto next = free_ranges.lower_bound(offset);
+    if (next != free_ranges.begin()) {
+      auto previous = std::prev(next);
+      if (previous->first + previous->second == offset) {
+        offset = previous->first;
+        size += previous->second;
+        free_ranges.erase(previous);
+      }
+    }
+    if (next != free_ranges.end() && offset + size == next->first) {
+      size += next->second;
+      free_ranges.erase(next);
+    }
+    free_ranges.emplace(offset, size);
+  }
+
+  Buffer make_buffer(VkDeviceSize size, VkBufferUsageFlags usage) {
+    Buffer result;
+    VkBufferCreateInfo info{VK_STRUCTURE_TYPE_BUFFER_CREATE_INFO};
+    info.size = size;
+    info.usage = usage;
+    info.sharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    if (!check(vk_.vkCreateBuffer(device_, &info, nullptr, &result.buffer), "buffer")) return {};
+    VkMemoryRequirements requirements{};
+    vk_.vkGetBufferMemoryRequirements(device_, result.buffer, &requirements);
+    auto type = memory_type(requirements.memoryTypeBits,
+                            VK_MEMORY_PROPERTY_HOST_VISIBLE_BIT | VK_MEMORY_PROPERTY_HOST_COHERENT_BIT);
+    VkMemoryAllocateInfo allocation{VK_STRUCTURE_TYPE_MEMORY_ALLOCATE_INFO};
+    allocation.allocationSize = requirements.size;
+    allocation.memoryTypeIndex = type.value_or(0U);
+    if (!type || !check(vk_.vkAllocateMemory(device_, &allocation, nullptr, &result.memory), "buffer memory")) {
+      vk_.vkDestroyBuffer(device_, result.buffer, nullptr);
+      return {};
+    }
+    vk_.vkBindBufferMemory(device_, result.buffer, result.memory, 0U);
+    void* mapped{};
+    vk_.vkMapMemory(device_, result.memory, 0U, VK_WHOLE_SIZE, 0U, &mapped);
+    result.mapped = static_cast<std::uint8_t*>(mapped);
+    result.size = size;
+    return result;
+  }
+
+  void destroy_buffer(Buffer& buffer) {
+    if (buffer.buffer != VK_NULL_HANDLE) vk_.vkDestroyBuffer(device_, buffer.buffer, nullptr);
+    if (buffer.memory != VK_NULL_HANDLE) vk_.vkFreeMemory(device_, buffer.memory, nullptr);
+    buffer = {};
+  }
+
+  // Images --------------------------------------------------------------------------------
+
+  VkImageView make_view(VkImage image, VkFormat format, VkImageAspectFlags aspect) {
+    VkImageViewCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_VIEW_CREATE_INFO};
+    info.image = image;
+    info.viewType = VK_IMAGE_VIEW_TYPE_2D;
+    info.format = format;
+    info.subresourceRange = {aspect, 0U, 1U, 0U, 1U};
+    VkImageView view{};
+    check(vk_.vkCreateImageView(device_, &info, nullptr, &view), "image view");
+    return view;
+  }
+
+  bool make_image(VulkanImage& image, VkImageUsageFlags usage) {
+    VkImageCreateInfo info{VK_STRUCTURE_TYPE_IMAGE_CREATE_INFO};
+    info.imageType = VK_IMAGE_TYPE_2D;
+    info.format = VK_FORMAT_R8G8B8A8_UNORM;
+    info.extent = {std::max(image.width, 1U), std::max(image.height, 1U), 1U};
+    info.mipLevels = 1U;
+    info.arrayLayers = 1U;
+    info.samples = VK_SAMPLE_COUNT_1_BIT;
+    info.tiling = VK_IMAGE_TILING_OPTIMAL;
+    info.usage = usage;
+    info.initialLayout = VK_IMAGE_LAYOUT_UNDEFINED;
+    if (!check(vk_.vkCreateImage(device_, &info, nullptr, &image.image), "image")) {
+      image.image = VK_NULL_HANDLE;
+      return false;
+    }
+    VkMemoryRequirements requirements{};
+    vk_.vkGetImageMemoryRequirements(device_, image.image, &requirements);
+    image.memory = allocate(requirements);
+    if (image.memory.memory == VK_NULL_HANDLE) {
+      vk_.vkDestroyImage(device_, image.image, nullptr);
+      image.image = VK_NULL_HANDLE;
+      return false;
+    }
+    vk_.vkBindImageMemory(device_, image.image, image.memory.memory, image.memory.offset);
+    image.view = make_view(image.image, VK_FORMAT_R8G8B8A8_UNORM, VK_IMAGE_ASPECT_COLOR_BIT);
+    image.layout = VK_IMAGE_LAYOUT_UNDEFINED;
+    image.drawn_in = 0U;
+    return true;
+  }
+
+  // New contents for an image, copied in by the frame's uploads (which run before its drawing).
+  void upload(VulkanImage& image, const std::uint8_t* rgba) {
+    begin_frame();
+    auto& current = frame();
+    const auto bytes = static_cast<VkDeviceSize>(image.width) * image.height * 4U;
+    if (current.staging_used + bytes > current.staging.size) {
+      if (current.staging.buffer != VK_NULL_HANDLE) {
+        auto old = current.staging;
+        current.retired.emplace_back([this, old]() mutable { destroy_buffer(old); });
+      }
+      current.staging = make_buffer(std::max<VkDeviceSize>({bytes, current.staging.size * 2U, 8U << 20U}),
+                                    VK_BUFFER_USAGE_TRANSFER_SRC_BIT);
+      current.staging_used = 0U;
+      if (current.staging.mapped == nullptr) return;
+    }
+    const auto offset = current.staging_used;
+    ++stats_.uploads;
+    stats_.upload_bytes += bytes;
+    if (rgba != nullptr) std::memcpy(current.staging.mapped + offset, rgba, static_cast<std::size_t>(bytes));
+    else std::memset(current.staging.mapped + offset, 0, static_cast<std::size_t>(bytes));
+    current.staging_used = (offset + bytes + 15U) / 16U * 16U;
+    change_layout(current.upload, image.image, VK_IMAGE_ASPECT_COLOR_BIT, image.layout,
+                  VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL);
+    VkBufferImageCopy region{};
+    region.bufferOffset = offset;
+    region.imageSubresource = {VK_IMAGE_ASPECT_COLOR_BIT, 0U, 0U, 1U};
+    region.imageExtent = {image.width, image.height, 1U};
+    vk_.vkCmdCopyBufferToImage(current.upload, current.staging.buffer, image.image,
+                               VK_IMAGE_LAYOUT_TRANSFER_DST_OPTIMAL, 1U, &region);
+    change_layout(current.upload, image.image, VK_IMAGE_ASPECT_COLOR_BIT, image.layout,
+                  VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+  }
+
+  // A barrier taking an image from the layout it's in to another (and noting it).
+  void change_layout(VkCommandBuffer command, VkImage image, VkImageAspectFlags aspect, VkImageLayout& layout,
+                     VkImageLayout to) {
+    if (image == VK_NULL_HANDLE) return;
+    const auto from_use = layout_use(layout);
+    const auto to_use = layout_use(to);
+    VkImageMemoryBarrier barrier{VK_STRUCTURE_TYPE_IMAGE_MEMORY_BARRIER};
+    barrier.srcAccessMask = from_use.access;
+    barrier.dstAccessMask = to_use.access;
+    barrier.oldLayout = layout;
+    barrier.newLayout = to;
+    barrier.srcQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.dstQueueFamilyIndex = VK_QUEUE_FAMILY_IGNORED;
+    barrier.image = image;
+    barrier.subresourceRange = {aspect, 0U, 1U, 0U, 1U};
+    // (Into a present, the next use is the presentation engine's, ordered by the semaphore.)
+    vk_.vkCmdPipelineBarrier(command, from_use.stages, to_use.stages, 0U, 0U, nullptr, 0U, nullptr, 1U, &barrier);
+    layout = to;
+  }
+
+  // Frames ----------------------------------------------------------------------------------
+
+  void run_retired(Frame& frame) {
+    auto retired = std::move(frame.retired);
+    frame.retired.clear();
+    for (auto& release : retired) release();
+  }
+
+  void begin_frame() {
+    if (recording_) return;
+    auto& current = frame();
+    const auto waiting = std::chrono::steady_clock::now();
+    vk_.vkWaitForFences(device_, 1U, &current.done, VK_TRUE, UINT64_MAX);
+    frame_started_ = std::chrono::steady_clock::now();
+    stats_.wait_ms += std::chrono::duration<double, std::milli>(frame_started_ - waiting).count();
+    run_retired(current);
+    vk_.vkResetCommandPool(device_, current.command_pool, 0U);
+    for (auto pool : current.descriptor_pools) vk_.vkResetDescriptorPool(device_, pool, 0U);
+    current.pools_used = 0U;
+    current.sets.clear();
+    current.staging_used = 0U;
+    current.vertices_used = 0U;
+    VkCommandBufferBeginInfo begin{VK_STRUCTURE_TYPE_COMMAND_BUFFER_BEGIN_INFO};
+    begin.flags = VK_COMMAND_BUFFER_USAGE_ONE_TIME_SUBMIT_BIT;
+    vk_.vkBeginCommandBuffer(current.upload, &begin);
+    vk_.vkBeginCommandBuffer(current.draw, &begin);
+    recording_ = true;
+    ++frame_number_;
+    pass_target_ = nullptr;
+    window_pass_ = false;
+    bound_pipeline_ = VK_NULL_HANDLE;
+    bound_set_ = VK_NULL_HANDLE;
+    bound_vertices_ = VK_NULL_HANDLE;
+    std::fill(std::begin(blend_color_), std::end(blend_color_), -1.0F);
+    std::fill(std::begin(stencil_), std::end(stencil_), 0x100U);
+  }
+
+  // Ends the render pass open. A target that draws sample is made ready for that straight away,
+  // so a draw sampling it later doesn't have to break another target's pass to.
+  void end_pass() {
+    if (pass_target_ != nullptr || window_pass_) vk_.vkCmdEndRenderPass(frame().draw);
+    if (pass_target_ != nullptr && pass_target_->image.sampled)
+      change_layout(frame().draw, pass_target_->image.image, VK_IMAGE_ASPECT_COLOR_BIT, pass_target_->image.layout,
+                    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    pass_target_ = nullptr;
+    window_pass_ = false;
+  }
+
+  void begin_target_pass(VulkanTarget& target) {
+    if (pass_target_ == &target) return;
+    end_pass();
+    auto command = frame().draw;
+    if (target.image.layout != VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL)
+      change_layout(command, target.image.image, VK_IMAGE_ASPECT_COLOR_BIT, target.image.layout,
+                    VK_IMAGE_LAYOUT_COLOR_ATTACHMENT_OPTIMAL);
+    if (target.depth_layout != VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL)
+      change_layout(command, target.depth, VK_IMAGE_ASPECT_DEPTH_BIT | VK_IMAGE_ASPECT_STENCIL_BIT,
+                    target.depth_layout, VK_IMAGE_LAYOUT_DEPTH_STENCIL_ATTACHMENT_OPTIMAL);
+    ++stats_.passes;
+    VkRenderPassBeginInfo begin{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    begin.renderPass = target_pass_;
+    begin.framebuffer = target.framebuffer;
+    begin.renderArea.extent = {target.image.width, target.image.height};
+    vk_.vkCmdBeginRenderPass(command, &begin, VK_SUBPASS_CONTENTS_INLINE);
+    const VkViewport viewport{0.0F, 0.0F, static_cast<float>(target.image.width),
+                              static_cast<float>(target.image.height), 0.0F, 1.0F};
+    vk_.vkCmdSetViewport(command, 0U, 1U, &viewport);
+    pass_target_ = &target;
+  }
+
+  void bind_texture(VkCommandBuffer command, VulkanImage& image, std::uint8_t sampler) {
+    auto& current = frame();
+    std::uint64_t handle{};
+    std::memcpy(&handle, &image.view, std::min(sizeof(handle), sizeof(image.view)));
+    const auto key = handle * 16U + (sampler & 0xfU);
+    auto found = current.sets.find(key);
+    if (found == current.sets.end()) {
+      VkDescriptorSet set{};
+      while (set == VK_NULL_HANDLE) {
+        if (current.pools_used == current.descriptor_pools.size()) {
+          const VkDescriptorPoolSize size{VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER, 1024U};
+          VkDescriptorPoolCreateInfo info{VK_STRUCTURE_TYPE_DESCRIPTOR_POOL_CREATE_INFO};
+          info.maxSets = 1024U;
+          info.poolSizeCount = 1U;
+          info.pPoolSizes = &size;
+          VkDescriptorPool pool{};
+          if (!check(vk_.vkCreateDescriptorPool(device_, &info, nullptr, &pool), "descriptor pool")) return;
+          current.descriptor_pools.push_back(pool);
+        }
+        VkDescriptorSetAllocateInfo allocation{VK_STRUCTURE_TYPE_DESCRIPTOR_SET_ALLOCATE_INFO};
+        allocation.descriptorPool = current.descriptor_pools[current.pools_used];
+        allocation.descriptorSetCount = 1U;
+        allocation.pSetLayouts = &set_layout_;
+        if (vk_.vkAllocateDescriptorSets(device_, &allocation, &set) != VK_SUCCESS) {
+          set = VK_NULL_HANDLE;
+          ++current.pools_used;  // full: the next one
+        }
+      }
+      const VkDescriptorImageInfo info{samplers_[sampler & 0xfU], image.view, VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL};
+      VkWriteDescriptorSet write{VK_STRUCTURE_TYPE_WRITE_DESCRIPTOR_SET};
+      write.dstSet = set;
+      write.descriptorCount = 1U;
+      write.descriptorType = VK_DESCRIPTOR_TYPE_COMBINED_IMAGE_SAMPLER;
+      write.pImageInfo = &info;
+      vk_.vkUpdateDescriptorSets(device_, 1U, &write, 0U, nullptr);
+      found = current.sets.emplace(key, set).first;
+    }
+    if (found->second != bound_set_) {
+      vk_.vkCmdBindDescriptorSets(command, VK_PIPELINE_BIND_POINT_GRAPHICS, layout_, 0U, 1U, &found->second, 0U,
+                                  nullptr);
+      bound_set_ = found->second;
+    }
+  }
+
+  // The window ------------------------------------------------------------------------------
+
+  void destroy_offscreen() {
+    if (offscreen_framebuffer_ != VK_NULL_HANDLE) vk_.vkDestroyFramebuffer(device_, offscreen_framebuffer_, nullptr);
+    offscreen_framebuffer_ = VK_NULL_HANDLE;
+    if (offscreen_image_.view != VK_NULL_HANDLE) vk_.vkDestroyImageView(device_, offscreen_image_.view, nullptr);
+    if (offscreen_image_.image != VK_NULL_HANDLE) vk_.vkDestroyImage(device_, offscreen_image_.image, nullptr);
+    free(offscreen_image_.memory);
+    offscreen_image_.image = VK_NULL_HANDLE;
+    offscreen_image_.view = VK_NULL_HANDLE;
+    offscreen_image_.memory = {};
+  }
+
+  void destroy_swapchain() {
+    for (auto framebuffer : swapchain_framebuffers_) vk_.vkDestroyFramebuffer(device_, framebuffer, nullptr);
+    for (auto view : swapchain_views_) vk_.vkDestroyImageView(device_, view, nullptr);
+    for (auto semaphore : rendered_) vk_.vkDestroySemaphore(device_, semaphore, nullptr);
+    swapchain_framebuffers_.clear();
+    swapchain_views_.clear();
+    swapchain_images_.clear();
+    rendered_.clear();
+    if (swapchain_ != VK_NULL_HANDLE) vk_.vkDestroySwapchainKHR(device_, swapchain_, nullptr);
+    swapchain_ = VK_NULL_HANDLE;
+  }
+
+  bool create_swapchain() {
+    vk_.vkDeviceWaitIdle(device_);
+    SDL_Vulkan_GetDrawableSize(window_, &made_for_[0], &made_for_[1]);
+    if (surface_lost_) {
+      destroy_swapchain();
+      vk_.vkDestroySurfaceKHR(instance_, surface_, nullptr);
+      surface_ = VK_NULL_HANDLE;
+      if (SDL_Vulkan_CreateSurface(window_, instance_, &surface_) == SDL_FALSE) return false;
+      surface_lost_ = false;
+    }
+    VkSurfaceCapabilitiesKHR capabilities{};
+    if (vk_.vkGetPhysicalDeviceSurfaceCapabilitiesKHR(physical_device_, surface_, &capabilities) != VK_SUCCESS)
+      return false;
+    VkExtent2D extent = capabilities.currentExtent;
+    if (extent.width == 0xffffffffU) {
+      int width{}, height{};
+      SDL_Vulkan_GetDrawableSize(window_, &width, &height);
+      extent.width = std::clamp(static_cast<std::uint32_t>(std::max(width, 1)), capabilities.minImageExtent.width,
+                                capabilities.maxImageExtent.width);
+      extent.height = std::clamp(static_cast<std::uint32_t>(std::max(height, 1)), capabilities.minImageExtent.height,
+                                 capabilities.maxImageExtent.height);
+    }
+    if (extent.width == 0U || extent.height == 0U) return false;  // minimized
+    // Turned as the screen is (Android): the swapchain keeps the screen's own orientation, and the
+    // window's picture is drawn turned in it. Android gives the window's size as the window is
+    // (landscape on a phone whose screen is portrait): the swapchain's is the other way round.
+    // (Which way the window is, SDL knows, should a device give it the other way.)
+    auto transform = capabilities.currentTransform;
+    if (transform != VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR && transform != VK_SURFACE_TRANSFORM_ROTATE_180_BIT_KHR &&
+        transform != VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR)
+      transform = (capabilities.supportedTransforms & VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR) != 0U
+                      ? VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR
+                      : capabilities.currentTransform;
+    const bool turned = transform == VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR ||
+                        transform == VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR;
+    VkExtent2D logical = extent;  // as the window is
+    if (turned) {
+      if (made_for_[0] > 0 && made_for_[1] > 0 && (made_for_[0] > made_for_[1]) != (extent.width > extent.height))
+        std::swap(logical.width, logical.height);
+      extent = {logical.height, logical.width};
+    }
+    std::uint32_t format_count{};
+    vk_.vkGetPhysicalDeviceSurfaceFormatsKHR(physical_device_, surface_, &format_count, nullptr);
+    std::vector<VkSurfaceFormatKHR> formats(format_count);
+    vk_.vkGetPhysicalDeviceSurfaceFormatsKHR(physical_device_, surface_, &format_count, formats.data());
+    VkSurfaceFormatKHR format{VK_FORMAT_R8G8B8A8_UNORM, VK_COLOR_SPACE_SRGB_NONLINEAR_KHR};
+    if (!formats.empty() && !(formats.size() == 1U && formats[0].format == VK_FORMAT_UNDEFINED)) {
+      format = formats[0];
+      for (const auto& candidate : formats)
+        if ((candidate.format == VK_FORMAT_R8G8B8A8_UNORM || candidate.format == VK_FORMAT_B8G8R8A8_UNORM) &&
+            candidate.colorSpace == VK_COLOR_SPACE_SRGB_NONLINEAR_KHR) {
+          format = candidate;
+          break;
+        }
+    }
+    auto image_count = std::max(capabilities.minImageCount + 1U, 2U);
+    if (capabilities.maxImageCount != 0U) image_count = std::min(image_count, capabilities.maxImageCount);
+    VkSwapchainCreateInfoKHR info{VK_STRUCTURE_TYPE_SWAPCHAIN_CREATE_INFO_KHR};
+    info.surface = surface_;
+    info.minImageCount = image_count;
+    info.imageFormat = format.format;
+    info.imageColorSpace = format.colorSpace;
+    info.imageExtent = extent;
+    info.imageArrayLayers = 1U;
+    info.imageUsage = VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT |
+                      (capabilities.supportedUsageFlags & VK_IMAGE_USAGE_TRANSFER_SRC_BIT);
+    swapchain_readable_ = (info.imageUsage & VK_IMAGE_USAGE_TRANSFER_SRC_BIT) != 0U;
+    info.imageSharingMode = VK_SHARING_MODE_EXCLUSIVE;
+    info.preTransform = transform;
+    info.compositeAlpha = VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR;
+    for (auto alpha : {VK_COMPOSITE_ALPHA_OPAQUE_BIT_KHR, VK_COMPOSITE_ALPHA_INHERIT_BIT_KHR,
+                       VK_COMPOSITE_ALPHA_PRE_MULTIPLIED_BIT_KHR, VK_COMPOSITE_ALPHA_POST_MULTIPLIED_BIT_KHR})
+      if ((capabilities.supportedCompositeAlpha & alpha) != 0U) {
+        info.compositeAlpha = alpha;
+        break;
+      }
+    info.presentMode = VK_PRESENT_MODE_FIFO_KHR;  // with the screen's refresh, as OpenGL's swap interval 1
+    info.clipped = VK_TRUE;
+    info.oldSwapchain = swapchain_;
+    VkSwapchainKHR swapchain{};
+    const auto result = vk_.vkCreateSwapchainKHR(device_, &info, nullptr, &swapchain);
+    destroy_swapchain();
+    if (result != VK_SUCCESS) {
+      if (result == VK_ERROR_SURFACE_LOST_KHR || result == VK_ERROR_NATIVE_WINDOW_IN_USE_KHR) surface_lost_ = true;
+      std::fprintf(stderr, "refract: Vulkan swapchain failed (%s)\n", result_name(result));
+      return false;
+    }
+    swapchain_ = swapchain;
+    swapchain_extent_ = extent;
+    window_extent_ = extent;
+    transform_ = transform;
+    std::fprintf(stderr, "[refract:vulkan] swapchain %ux%u (surface %ux%u, turned %d), window %dx%d\n", extent.width,
+                 extent.height, capabilities.currentExtent.width, capabilities.currentExtent.height,
+                 transform == VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR    ? 90
+                 : transform == VK_SURFACE_TRANSFORM_ROTATE_180_BIT_KHR ? 180
+                 : transform == VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR ? 270
+                                                                         : 0,
+                 made_for_[0], made_for_[1]);
+    // The window as SDL has it, should the swapchain's size not match it: then Android scales the
+    // picture onto the window, and drawing it scaled to the swapchain undoes that.
+    logical_extent_ = made_for_[0] > 0 && made_for_[1] > 0
+                          ? VkExtent2D{static_cast<std::uint32_t>(made_for_[0]), static_cast<std::uint32_t>(made_for_[1])}
+                          : logical;
+    if (format.format != window_format_ || window_passes_[0] == VK_NULL_HANDLE) {
+      window_format_ = format.format;
+      if (!create_window_pipelines()) return false;
+    }
+    std::uint32_t count{};
+    vk_.vkGetSwapchainImagesKHR(device_, swapchain_, &count, nullptr);
+    swapchain_images_.resize(count);
+    vk_.vkGetSwapchainImagesKHR(device_, swapchain_, &count, swapchain_images_.data());
+    for (auto image : swapchain_images_) {
+      swapchain_views_.push_back(make_view(image, window_format_, VK_IMAGE_ASPECT_COLOR_BIT));
+      VkFramebufferCreateInfo framebuffer{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+      framebuffer.renderPass = window_passes_[0];
+      framebuffer.attachmentCount = 1U;
+      framebuffer.pAttachments = &swapchain_views_.back();
+      framebuffer.width = extent.width;
+      framebuffer.height = extent.height;
+      framebuffer.layers = 1U;
+      VkFramebuffer made{};
+      check(vk_.vkCreateFramebuffer(device_, &framebuffer, nullptr, &made), "window framebuffer");
+      swapchain_framebuffers_.push_back(made);
+      VkSemaphoreCreateInfo semaphore{VK_STRUCTURE_TYPE_SEMAPHORE_CREATE_INFO};
+      VkSemaphore rendered{};
+      vk_.vkCreateSemaphore(device_, &semaphore, nullptr, &rendered);
+      rendered_.push_back(rendered);
+    }
+    swapchain_dirty_ = false;
+    return true;
+  }
+
+  // The offscreen window's image. REFRACT_VULKAN_TEST_ROTATION=90, 180 or 270 draws it turned as an
+  // Android screen would be, to test that (screenshots are turned back).
+  bool ensure_offscreen() {
+    int width{}, height{};
+    SDL_GetWindowSize(window_, &width, &height);
+    logical_extent_ = {static_cast<std::uint32_t>(std::max(width, 1)), static_cast<std::uint32_t>(std::max(height, 1))};
+    const auto* rotation = std::getenv("REFRACT_VULKAN_TEST_ROTATION");
+    const auto degrees = rotation != nullptr ? std::atoi(rotation) : 0;
+    transform_ = degrees == 90    ? VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR
+                 : degrees == 180 ? VK_SURFACE_TRANSFORM_ROTATE_180_BIT_KHR
+                 : degrees == 270 ? VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR
+                                  : VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR;
+    const bool turned = degrees == 90 || degrees == 270;
+    auto w = turned ? logical_extent_.height : logical_extent_.width;
+    auto h = turned ? logical_extent_.width : logical_extent_.height;
+    // REFRACT_VULKAN_TEST_IMAGE=WxH: an image of another size, as a phone's swapchain may be.
+    if (const auto* size = std::getenv("REFRACT_VULKAN_TEST_IMAGE")) std::sscanf(size, "%ux%u", &w, &h);
+    window_extent_ = {w, h};
+    if (offscreen_image_.image != VK_NULL_HANDLE && offscreen_image_.width == w && offscreen_image_.height == h)
+      return true;
+    vk_.vkDeviceWaitIdle(device_);
+    destroy_offscreen();
+    offscreen_image_.width = w;
+    offscreen_image_.height = h;
+    if (!make_image(offscreen_image_, VK_IMAGE_USAGE_COLOR_ATTACHMENT_BIT | VK_IMAGE_USAGE_TRANSFER_SRC_BIT))
+      return false;
+    VkFramebufferCreateInfo framebuffer{VK_STRUCTURE_TYPE_FRAMEBUFFER_CREATE_INFO};
+    framebuffer.renderPass = window_passes_[0];
+    framebuffer.attachmentCount = 1U;
+    framebuffer.pAttachments = &offscreen_image_.view;
+    framebuffer.width = w;
+    framebuffer.height = h;
+    framebuffer.layers = 1U;
+    return check(vk_.vkCreateFramebuffer(device_, &framebuffer, nullptr, &offscreen_framebuffer_), "offscreen");
+  }
+
+  // Starts drawing into the window: the frame's first time clears it (and takes the swapchain's
+  // next image), later times carry on with what's there.
+  void begin_window_pass() {
+    begin_frame();
+    if (window_pass_) return;
+    end_pass();
+    VkFramebuffer framebuffer{};
+    VkExtent2D extent{};
+    if (offscreen_) {
+      if (!ensure_offscreen()) return;
+      framebuffer = offscreen_framebuffer_;
+      extent = {offscreen_image_.width, offscreen_image_.height};
+    } else {
+      if (!window_begun_ && !acquire()) {
+        window_begun_ = true;  // nowhere to draw this frame (minimized, or the surface went)
+        return;
+      }
+      if (!acquired_) return;
+      framebuffer = swapchain_framebuffers_[image_index_];
+      extent = swapchain_extent_;
+    }
+    VkRenderPassBeginInfo begin{VK_STRUCTURE_TYPE_RENDER_PASS_BEGIN_INFO};
+    begin.renderPass = window_passes_[window_begun_ ? 1 : 0];
+    begin.framebuffer = framebuffer;
+    begin.renderArea.extent = extent;
+    const VkClearValue clear{{{0.02F, 0.02F, 0.025F, 1.0F}}};
+    begin.clearValueCount = 1U;
+    begin.pClearValues = &clear;
+    vk_.vkCmdBeginRenderPass(frame().draw, &begin, VK_SUBPASS_CONTENTS_INLINE);
+    window_pass_ = true;
+    window_begun_ = true;
+    bound_pipeline_ = VK_NULL_HANDLE;
+  }
+
+  bool acquire() {
+    for (int attempt = 0; attempt < 2; ++attempt) {
+      int width{}, height{};
+      SDL_Vulkan_GetDrawableSize(window_, &width, &height);
+      if (swapchain_ == VK_NULL_HANDLE || swapchain_dirty_ || surface_lost_ || width != made_for_[0] ||
+          height != made_for_[1]) {
+        if (!create_swapchain()) return false;
+      }
+      const auto result = vk_.vkAcquireNextImageKHR(device_, swapchain_, UINT64_MAX, frame().acquired,
+                                                    VK_NULL_HANDLE, &image_index_);
+      if (result == VK_SUCCESS || result == VK_SUBOPTIMAL_KHR) {
+        if (result == VK_SUBOPTIMAL_KHR) swapchain_dirty_ = true;  // made again after this frame
+        acquired_ = true;
+        return true;
+      }
+      if (result == VK_ERROR_SURFACE_LOST_KHR) surface_lost_ = true;
+      else if (result == VK_ERROR_OUT_OF_DATE_KHR) swapchain_dirty_ = true;
+      else return false;
+    }
+    return false;
+  }
+
+  // A captured picture, from the swapchain's orientation (and size) back to the window's.
+  void turn_back(std::vector<std::uint8_t>& pixels, VkExtent2D extent) const {
+    const auto width = logical_extent_.width, height = logical_extent_.height;
+    const bool turned = transform_ == VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR ||
+                        transform_ == VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR;
+    const auto turned_width = turned ? height : width, turned_height = turned ? width : height;
+    if (transform_ == VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR && extent.width == width && extent.height == height) return;
+    std::vector<std::uint8_t> turned_pixels(static_cast<std::size_t>(width) * height * 4U);
+    for (std::uint32_t y = 0; y < height; ++y)
+      for (std::uint32_t x = 0; x < width; ++x) {
+        std::uint32_t px = x, py = y;  // where the window's (x, y) is in the swapchain's image
+        if (transform_ == VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR) px = height - 1U - y, py = x;
+        else if (transform_ == VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR) px = y, py = width - 1U - x;
+        else if (transform_ == VK_SURFACE_TRANSFORM_ROTATE_180_BIT_KHR) px = width - 1U - x, py = height - 1U - y;
+        px = static_cast<std::uint32_t>(static_cast<std::uint64_t>(px) * extent.width / turned_width);
+        py = static_cast<std::uint32_t>(static_cast<std::uint64_t>(py) * extent.height / turned_height);
+        if (px >= extent.width || py >= extent.height) continue;
+        std::memcpy(&turned_pixels[(static_cast<std::size_t>(y) * width + x) * 4U],
+                    &pixels[(static_cast<std::size_t>(py) * extent.width + px) * 4U], 4U);
+      }
+    pixels.swap(turned_pixels);
+  }
+
+  // The window rectangle in the swapchain's own orientation, and how the picture turns in it.
+  void window_place(const Rect& where, VkRect2D& placed, float rotation[4]) const {
+    const auto width = static_cast<int>(logical_extent_.width);
+    const auto height = static_cast<int>(logical_extent_.height);
+    placed = {{where.x, where.y}, {static_cast<std::uint32_t>(where.width), static_cast<std::uint32_t>(where.height)}};
+    float turn[4] = {1.0F, 0.0F, 0.0F, 1.0F};
+    if (transform_ == VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR) {
+      placed = {{height - where.y - where.height, where.x},
+                {static_cast<std::uint32_t>(where.height), static_cast<std::uint32_t>(where.width)}};
+      turn[0] = 0.0F, turn[1] = -1.0F, turn[2] = 1.0F, turn[3] = 0.0F;
+    } else if (transform_ == VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR) {
+      placed = {{where.y, width - where.x - where.width},
+                {static_cast<std::uint32_t>(where.height), static_cast<std::uint32_t>(where.width)}};
+      turn[0] = 0.0F, turn[1] = 1.0F, turn[2] = -1.0F, turn[3] = 0.0F;
+    } else if (transform_ == VK_SURFACE_TRANSFORM_ROTATE_180_BIT_KHR) {
+      placed.offset = {width - where.x - where.width, height - where.y - where.height};
+      turn[0] = -1.0F, turn[3] = -1.0F;
+    }
+    std::copy(std::begin(turn), std::end(turn), rotation);
+    // Scaled to the image, where it isn't the window's size (turned).
+    const bool turned = transform_ == VK_SURFACE_TRANSFORM_ROTATE_90_BIT_KHR ||
+                        transform_ == VK_SURFACE_TRANSFORM_ROTATE_270_BIT_KHR;
+    const auto turned_width = static_cast<float>(turned ? height : width);
+    const auto turned_height = static_cast<float>(turned ? width : height);
+    if (turned_width > 0.0F && turned_height > 0.0F && window_extent_.width > 0U &&
+        (static_cast<float>(window_extent_.width) != turned_width ||
+         static_cast<float>(window_extent_.height) != turned_height)) {
+      const auto x_scale = static_cast<float>(window_extent_.width) / turned_width;
+      const auto y_scale = static_cast<float>(window_extent_.height) / turned_height;
+      const auto left = std::lround(static_cast<float>(placed.offset.x) * x_scale);
+      const auto top = std::lround(static_cast<float>(placed.offset.y) * y_scale);
+      const auto right = std::lround(static_cast<float>(placed.offset.x + static_cast<int>(placed.extent.width)) * x_scale);
+      const auto bottom = std::lround(static_cast<float>(placed.offset.y + static_cast<int>(placed.extent.height)) * y_scale);
+      placed = {{static_cast<std::int32_t>(left), static_cast<std::int32_t>(top)},
+                {static_cast<std::uint32_t>(std::max(right - left, 1L)), static_cast<std::uint32_t>(std::max(bottom - top, 1L))}};
+    }
+  }
+
+  void draw_window(const Rect& where, VulkanImage& image, float u_scale, float v_scale, VkPipeline pipeline) {
+    if (image.image == VK_NULL_HANDLE || where.width <= 0 || where.height <= 0) return;
+    begin_frame();
+    if (image.target && image.layout != VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL) {
+      end_pass();
+      change_layout(frame().draw, image.image, VK_IMAGE_ASPECT_COLOR_BIT, image.layout,
+                    VK_IMAGE_LAYOUT_SHADER_READ_ONLY_OPTIMAL);
+    }
+    image.drawn_in = frame_number_;
+    begin_window_pass();
+    if (!window_pass_) return;
+    auto command = frame().draw;
+    if (bound_pipeline_ != pipeline) {
+      vk_.vkCmdBindPipeline(command, VK_PIPELINE_BIND_POINT_GRAPHICS, pipeline);
+      bound_pipeline_ = pipeline;
+      // Its blend constants and stencil values aren't dynamic: the geometry's must be set again.
+      std::fill(std::begin(blend_color_), std::end(blend_color_), -1.0F);
+      std::fill(std::begin(stencil_), std::end(stencil_), 0x100U);
+    }
+    WindowConstants constants{{u_scale, v_scale, 0.0F, 0.0F}, {}};
+    VkRect2D placed{};
+    window_place(where, placed, constants.rotation);
+    const VkViewport viewport{static_cast<float>(placed.offset.x), static_cast<float>(placed.offset.y),
+                              static_cast<float>(placed.extent.width), static_cast<float>(placed.extent.height),
+                              0.0F, 1.0F};
+    vk_.vkCmdSetViewport(command, 0U, 1U, &viewport);
+    VkRect2D scissor = placed;
+    if (scissor.offset.x < 0) scissor.extent.width -= static_cast<std::uint32_t>(std::min<int>(-scissor.offset.x, scissor.extent.width)), scissor.offset.x = 0;
+    if (scissor.offset.y < 0) scissor.extent.height -= static_cast<std::uint32_t>(std::min<int>(-scissor.offset.y, scissor.extent.height)), scissor.offset.y = 0;
+    vk_.vkCmdSetScissor(command, 0U, 1U, &scissor);
+    bind_texture(command, image, 0xfU);  // linear, clamped
+    vk_.vkCmdPushConstants(command, layout_, VK_SHADER_STAGE_VERTEX_BIT | VK_SHADER_STAGE_FRAGMENT_BIT, 0U,
+                           sizeof(constants), &constants);
+    vk_.vkCmdDraw(command, 3U, 1U, 0U, 0U);
+  }
+
+  SDL_Window* window_{};
+  std::string pipeline_cache_path_;
+  void* library_{};
+  bool offscreen_{};
+  Functions vk_;
+  VkInstance instance_{};
+  VkSurfaceKHR surface_{};
+  VkPhysicalDevice physical_device_{};
+  VkPhysicalDeviceMemoryProperties memory_properties_{};
+  std::string device_name_;
+  std::uint32_t queue_family_{};
+  std::uint32_t max_image_size_{4096U};
+  VkFormat depth_format_{VK_FORMAT_UNDEFINED};
+  VkDevice device_{};
+  VkQueue queue_{};
+  std::vector<Block> blocks_;
+  VkRenderPass target_pass_{};
+  VkDescriptorSetLayout set_layout_{};
+  VkPipelineLayout layout_{};
+  std::vector<VkShaderModule> modules_;
+  VkShaderModule geometry_vertex_{};
+  VkShaderModule geometry_fragment_{};
+  VkShaderModule window_vertex_{};
+  VkShaderModule picture_fragment_{};
+  VkShaderModule overlay_fragment_{};
+  std::array<VkSampler, 16U> samplers_{};
+  VkPipelineCache pipeline_cache_{};
+  std::unordered_map<std::uint64_t, VkPipeline> pipelines_;
+  std::mutex pipelines_mutex_;  // the warm-up thread makes pipelines too
+  std::atomic<std::size_t> pipelines_unsaved_{};
+  std::thread warm_up_;
+  std::atomic_bool stop_warm_up_{};
+  std::chrono::steady_clock::time_point last_cache_save_;
+  std::array<Frame, 2U> frames_{};
+  std::size_t frame_index_{};
+  std::uint64_t frame_number_{1U};
+  bool recording_{};
+  std::unique_ptr<VulkanImage> dummy_;  // the texture of draws without one
+  std::uint32_t base_vertex_{};
+  // What the drawing command buffer has bound and open.
+  VulkanTarget* pass_target_{};
+  bool window_pass_{};
+  bool window_begun_{};  // the window was cleared this frame
+  VkPipeline bound_pipeline_{};
+  VkDescriptorSet bound_set_{};
+  VkBuffer bound_vertices_{};
+  float blend_color_[4]{};
+  std::uint32_t stencil_[3]{};  // reference, compare mask, write mask
+  // The window: the swapchain (or, offscreen, an image), its passes and pipelines.
+  VkFormat window_format_{VK_FORMAT_UNDEFINED};
+  std::array<VkRenderPass, 2U> window_passes_{};  // clearing, keeping
+  VkPipeline picture_pipeline_{};
+  VkPipeline overlay_pipeline_{};
+  VkSwapchainKHR swapchain_{};
+  VkExtent2D swapchain_extent_{};
+  VkExtent2D logical_extent_{};  // as the window is (turned back)
+  VkExtent2D window_extent_{};   // the image the window is drawn into (swapchain's, or offscreen)
+  VkSurfaceTransformFlagBitsKHR transform_{VK_SURFACE_TRANSFORM_IDENTITY_BIT_KHR};
+  std::vector<VkImage> swapchain_images_;
+  std::vector<VkImageView> swapchain_views_;
+  std::vector<VkFramebuffer> swapchain_framebuffers_;
+  std::vector<VkSemaphore> rendered_;  // per swapchain image
+  std::uint32_t image_index_{};
+  bool acquired_{};
+  bool swapchain_dirty_{};
+  bool swapchain_readable_{};  // its images can be copied (for screenshots)
+  bool surface_lost_{};
+  int made_for_[2]{};  // the window size the swapchain was made for
+  bool shutting_down_{};
+  // REFRACT_VULKAN_STATS=1 prints what the frames cost, every 300.
+  struct Stats {
+    std::uint64_t frames{}, draws{}, passes{}, sample_breaks{}, uploads{}, upload_bytes{}, new_versions{},
+        pipelines{};
+    double pipeline_ms{}, wait_ms{}, record_ms{};
+  } stats_;
+  bool print_stats_{std::getenv("REFRACT_VULKAN_STATS") != nullptr};
+  std::chrono::steady_clock::time_point frame_started_;
+  VulkanImage offscreen_image_{*this};
+  VkFramebuffer offscreen_framebuffer_{};
+};
+
+VulkanImage::~VulkanImage() {
+  if (image != VK_NULL_HANDLE) backend.retire_image(image, view, memory);
+}
+
+VulkanTarget::~VulkanTarget() {
+  backend.forget_target(*this);
+  backend.retire_framebuffer(framebuffer);
+  if (depth != VK_NULL_HANDLE) backend.retire_image(depth, depth_view, depth_memory);
+}
+
+}  // namespace
+
+bool vulkan_built() { return true; }
+
+std::unique_ptr<Backend> create_vulkan_backend(SDL_Window* window, const std::string& pipeline_cache,
+                                               std::string& problem) {
+  auto backend = std::make_unique<VulkanBackend>(window, pipeline_cache);
+  if (!backend->initialize(problem)) return nullptr;
+  return backend;
+}
+
+}  // namespace refract::host::gpu
+
+#else
+
+namespace refract::host::gpu {
+
+bool vulkan_built() { return false; }
+
+std::unique_ptr<Backend> create_vulkan_backend(SDL_Window*, const std::string&, std::string& problem) {
+  problem = "this build has no Vulkan";
+  return nullptr;
+}
+
+}  // namespace refract::host::gpu
+
+#endif
