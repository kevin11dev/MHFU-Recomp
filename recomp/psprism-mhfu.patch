--- /dev/null
+++ b/refract/src/host/launcher_screen.hpp
@@ -0,0 +1,817 @@
+#pragma once
+
+// The launcher (refract/frontend.hpp): a menu over the game's art, and pages for the settings and
+// the controls, before the game starts. Drawn in software into a canvas the size of the window
+// (laid out on a 960x544 grid, scaled to fit and centred; the background fills the rest) and
+// shown with the renderer's overlay. Redrawn only when something changes.
+//
+// Included by sdl_gles.cpp inside namespace refract::frontend, after the host.
+
+namespace launcher {
+
+using font::UiFace;
+
+// Colours as the canvas stores them: 0xAABBGGRR.
+constexpr std::uint32_t rgba(std::uint32_t r, std::uint32_t g, std::uint32_t b, std::uint32_t a = 255U) {
+  return a << 24U | b << 16U | g << 8U | r;
+}
+constexpr std::uint32_t gold = rgba(234, 180, 78);
+constexpr std::uint32_t gold_dim = rgba(176, 136, 66);
+constexpr std::uint32_t parchment = rgba(236, 224, 198);
+constexpr std::uint32_t muted = rgba(150, 139, 117);
+constexpr std::uint32_t ink = rgba(24, 14, 6);
+constexpr std::uint32_t ember = rgba(222, 82, 34);
+constexpr std::uint32_t panel_fill = rgba(16, 12, 9, 230);
+constexpr std::uint32_t frame_outer = rgba(158, 118, 52);
+constexpr std::uint32_t frame_inner = rgba(88, 64, 30);
+
+constexpr float grid_width = 960.0F;
+constexpr float grid_height = 544.0F;
+
+// The canvas, in pixels, and where the 960x544 grid lands on it.
+struct Canvas {
+  int width{};
+  int height{};
+  float scale{1.0F};  // pixels per grid unit
+  float left{};
+  float top{};
+  std::vector<std::uint8_t> pixels;
+
+  void resize(int new_width, int new_height) {
+    width = std::max(new_width, 1);
+    height = std::max(new_height, 1);
+    pixels.assign(static_cast<std::size_t>(width) * static_cast<std::size_t>(height) * 4U, 0U);
+    scale = std::min(static_cast<float>(width) / grid_width, static_cast<float>(height) / grid_height);
+    left = (static_cast<float>(width) - grid_width * scale) * 0.5F;
+    top = (static_cast<float>(height) - grid_height * scale) * 0.5F;
+  }
+  float x(float grid) const { return left + grid * scale; }
+  float y(float grid) const { return top + grid * scale; }
+  std::uint8_t* at(int column, int row) {
+    return &pixels[(static_cast<std::size_t>(row) * static_cast<std::size_t>(width) + static_cast<std::size_t>(column)) * 4U];
+  }
+};
+
+// Blends a colour over a pixel, `coverage` (0 to 255) of the way.
+inline void blend(std::uint8_t* pixel, std::uint32_t abgr, std::uint32_t coverage) {
+  const auto alpha = ((abgr >> 24U) & 0xffU) * coverage / 255U;
+  if (alpha == 0U) return;
+  for (int channel = 0; channel < 3; ++channel) {
+    const auto source = (abgr >> (channel * 8)) & 0xffU;
+    pixel[channel] = static_cast<std::uint8_t>((source * alpha + pixel[channel] * (255U - alpha)) / 255U);
+  }
+  pixel[3] = static_cast<std::uint8_t>(alpha + pixel[3] * (255U - alpha) / 255U);
+}
+
+// A rectangle in pixels, clipped to the canvas.
+inline void fill_pixels(Canvas& canvas, int left, int top, int right, int bottom, std::uint32_t abgr) {
+  left = std::max(left, 0);
+  top = std::max(top, 0);
+  right = std::min(right, canvas.width);
+  bottom = std::min(bottom, canvas.height);
+  for (int row = top; row < bottom; ++row)
+    for (int column = left; column < right; ++column) blend(canvas.at(column, row), abgr, 255U);
+}
+
+// A rectangle on the grid.
+inline void fill(Canvas& canvas, float left, float top, float right, float bottom, std::uint32_t abgr) {
+  fill_pixels(canvas, static_cast<int>(std::lround(canvas.x(left))), static_cast<int>(std::lround(canvas.y(top))),
+              static_cast<int>(std::lround(canvas.x(right))), static_cast<int>(std::lround(canvas.y(bottom))), abgr);
+}
+
+// Shades the whole canvas with `rgb`, from `alpha_from` at pixel `start` to `alpha_to` at `end`
+// (and beyond), across x or down y.
+inline void shade(Canvas& canvas, bool across, float start, float end, std::uint32_t rgb, float alpha_from,
+                  float alpha_to) {
+  const int count = across ? canvas.width : canvas.height;
+  for (int at = 0; at < count; ++at) {
+    const auto t = std::clamp((static_cast<float>(at) - start) / std::max(end - start, 1.0F), 0.0F, 1.0F);
+    const auto alpha = static_cast<std::uint32_t>(std::lround(alpha_from + (alpha_to - alpha_from) * t));
+    if (alpha == 0U) continue;
+    const auto colour = (rgb & 0xffffffU) | alpha << 24U;
+    if (across)
+      for (int row = 0; row < canvas.height; ++row) blend(canvas.at(at, row), colour, 255U);
+    else
+      for (int column = 0; column < canvas.width; ++column) blend(canvas.at(column, at), colour, 255U);
+  }
+}
+
+// A shape given by its signed distance (in pixels, negative inside) at a pixel's centre,
+// anti-aliased, within the pixel box [left, right) x [top, bottom).
+template <typename Distance>
+void shape(Canvas& canvas, float left, float top, float right, float bottom, std::uint32_t abgr, Distance distance) {
+  const int x0 = std::max(static_cast<int>(std::floor(left)) - 1, 0);
+  const int y0 = std::max(static_cast<int>(std::floor(top)) - 1, 0);
+  const int x1 = std::min(static_cast<int>(std::ceil(right)) + 1, canvas.width);
+  const int y1 = std::min(static_cast<int>(std::ceil(bottom)) + 1, canvas.height);
+  for (int row = y0; row < y1; ++row)
+    for (int column = x0; column < x1; ++column) {
+      const auto d = distance(static_cast<float>(column) + 0.5F, static_cast<float>(row) + 0.5F);
+      const auto coverage = std::clamp(0.5F - d, 0.0F, 1.0F);
+      if (coverage > 0.0F) blend(canvas.at(column, row), abgr, static_cast<std::uint32_t>(coverage * 255.0F));
+    }
+}
+
+inline float segment_distance(float px, float py, float ax, float ay, float bx, float by) {
+  const auto dx = bx - ax, dy = by - ay;
+  const auto t = std::clamp(((px - ax) * dx + (py - ay) * dy) / std::max(dx * dx + dy * dy, 1e-6F), 0.0F, 1.0F);
+  return std::hypot(px - ax - t * dx, py - ay - t * dy);
+}
+
+// A diamond (the gold markers), on the grid.
+inline void diamond(Canvas& canvas, float cx, float cy, float radius, std::uint32_t abgr) {
+  const auto x = canvas.x(cx), y = canvas.y(cy), r = radius * canvas.scale;
+  shape(canvas, x - r, y - r, x + r, y + r, abgr,
+        [&](float px, float py) { return (std::abs(px - x) + std::abs(py - y) - r) * 0.7071F; });
+}
+
+// A filled triangle pointing up, down, left or right (dx, dy), on the grid.
+inline void arrow(Canvas& canvas, float cx, float cy, float size, int dx, int dy, std::uint32_t abgr) {
+  const auto x = canvas.x(cx), y = canvas.y(cy), s = size * canvas.scale;
+  // Tip at (dx, dy) * s, base corners across it.
+  const float tip_x = x + static_cast<float>(dx) * s, tip_y = y + static_cast<float>(dy) * s;
+  const float base_x = x - static_cast<float>(dx) * s * 0.6F, base_y = y - static_cast<float>(dy) * s * 0.6F;
+  const float side_x = static_cast<float>(-dy) * s, side_y = static_cast<float>(dx) * s;
+  const std::array<std::pair<float, float>, 3> corners{{{tip_x, tip_y}, {base_x + side_x, base_y + side_y}, {base_x - side_x, base_y - side_y}}};
+  shape(canvas, x - s * 1.2F, y - s * 1.2F, x + s * 1.2F, y + s * 1.2F, abgr, [&](float px, float py) {
+    float inside = -1e9F;
+    for (std::size_t i = 0; i < 3; ++i) {
+      const auto [ax, ay] = corners[i];
+      const auto [bx, by] = corners[(i + 1U) % 3U];
+      // Distance to the edge's line, positive outside (corners go round one way).
+      const auto ex = bx - ax, ey = by - ay, length = std::max(std::hypot(ex, ey), 1e-6F);
+      const auto side = ((px - ax) * ey - (py - ay) * ex) / length;
+      inside = std::max(inside, side);
+    }
+    return inside;
+  });
+}
+
+// The PSP's face button symbols, outlined in their colours, centred on (cx, cy) on the grid.
+enum class Symbol { cross, circle, square, triangle };
+inline void psp_symbol(Canvas& canvas, Symbol symbol, float cx, float cy, float size) {
+  const auto x = canvas.x(cx), y = canvas.y(cy), r = size * 0.5F * canvas.scale;
+  const auto thickness = std::max(1.5F, size * 0.14F * canvas.scale);
+  const auto box = [&](auto&& distance, std::uint32_t colour) { shape(canvas, x - r - 2, y - r - 2, x + r + 2, y + r + 2, colour, distance); };
+  switch (symbol) {
+    case Symbol::cross:
+      box([&](float px, float py) {
+            const auto k = r * 0.8F;
+            return std::min(segment_distance(px, py, x - k, y - k, x + k, y + k),
+                            segment_distance(px, py, x - k, y + k, x + k, y - k)) - thickness * 0.5F;
+          },
+          rgba(122, 156, 236));
+      break;
+    case Symbol::circle:
+      box([&](float px, float py) { return std::abs(std::hypot(px - x, py - y) - r * 0.85F) - thickness * 0.5F; },
+          rgba(232, 92, 92));
+      break;
+    case Symbol::square:
+      box([&](float px, float py) {
+            return std::abs(std::max(std::abs(px - x), std::abs(py - y)) - r * 0.75F) - thickness * 0.5F;
+          },
+          rgba(226, 134, 204));
+      break;
+    case Symbol::triangle: {
+      const float top_x = x, top_y = y - r * 0.9F, left_x = x - r * 0.95F, left_y = y + r * 0.7F, right_x = x + r * 0.95F;
+      box([&](float px, float py) {
+            return std::min({segment_distance(px, py, top_x, top_y, left_x, left_y),
+                             segment_distance(px, py, left_x, left_y, right_x, left_y),
+                             segment_distance(px, py, right_x, left_y, top_x, top_y)}) - thickness * 0.5F;
+          },
+          rgba(86, 204, 146));
+      break;
+    }
+  }
+}
+
+inline std::optional<Symbol> symbol_named(std::string_view name) {
+  if (name == "Cross") return Symbol::cross;
+  if (name == "Circle") return Symbol::circle;
+  if (name == "Square") return Symbol::square;
+  if (name == "Triangle") return Symbol::triangle;
+  return std::nullopt;
+}
+
+// Text on the grid: x and the baseline in grid units, the size in grid units too. Returns the
+// width in grid units.
+inline float text(Canvas& canvas, float x, float baseline, float size, std::string_view words, std::uint32_t abgr,
+                  UiFace face = UiFace::regular) {
+  return static_cast<float>(font::draw_ui_text(canvas.pixels.data(), canvas.width, canvas.height,
+                                               static_cast<int>(std::lround(canvas.x(x))),
+                                               static_cast<int>(std::lround(canvas.y(baseline))), size * canvas.scale,
+                                               words, abgr, face)) /
+         canvas.scale;
+}
+
+inline float measure(const Canvas& canvas, float size, std::string_view words, UiFace face = UiFace::regular) {
+  return static_cast<float>(font::measure_ui_text(size * canvas.scale, words, face)) / canvas.scale;
+}
+
+// Text with an outline `width` grid units wide around it.
+inline void outlined_text(Canvas& canvas, float x, float baseline, float size, std::string_view words,
+                          std::uint32_t abgr, std::uint32_t outline, float width, UiFace face = UiFace::display) {
+  const auto px = canvas.x(x), py = canvas.y(baseline), w = width * canvas.scale;
+  for (int ring = 1; ring <= 2; ++ring)
+    for (int step = 0; step < 16; ++step) {
+      const auto angle = static_cast<float>(step) * 0.3927F;
+      const auto radius = w * static_cast<float>(ring) * 0.5F;
+      font::draw_ui_text(canvas.pixels.data(), canvas.width, canvas.height,
+                         static_cast<int>(std::lround(px + std::cos(angle) * radius)),
+                         static_cast<int>(std::lround(py + std::sin(angle) * radius)), size * canvas.scale, words, outline,
+                         face);
+    }
+  font::draw_ui_text(canvas.pixels.data(), canvas.width, canvas.height, static_cast<int>(std::lround(px)),
+                     static_cast<int>(std::lround(py)), size * canvas.scale, words, abgr, face);
+}
+
+// ASCII letters in capitals (for the options' labels).
+inline std::string capitals(std::string words) {
+  for (auto& c : words)
+    if (c >= 'a' && c <= 'z') c = static_cast<char>(c - 'a' + 'A');
+  return words;
+}
+
+// Words split into lines no wider than `width` grid units.
+inline std::vector<std::string> wrap(const Canvas& canvas, float size, const std::string& words, float width) {
+  std::vector<std::string> lines;
+  std::string line;
+  std::size_t at = 0;
+  while (at < words.size()) {
+    const auto space = words.find(' ', at);
+    const auto word = words.substr(at, space == std::string::npos ? std::string::npos : space - at);
+    at = space == std::string::npos ? words.size() : space + 1U;
+    const auto candidate = line.empty() ? word : line + ' ' + word;
+    if (!line.empty() && measure(canvas, size, candidate) > width) {
+      lines.push_back(line);
+      line = word;
+    } else {
+      line = candidate;
+    }
+  }
+  if (!line.empty()) lines.push_back(line);
+  return lines;
+}
+
+// Words cut short with an ellipsis to fit in `width` grid units, if they don't already.
+inline std::string shorten(const Canvas& canvas, float size, std::string words, float width) {
+  if (measure(canvas, size, words) <= width) return words;
+  while (!words.empty()) {
+    do words.pop_back();  // a whole character of UTF-8
+    while (!words.empty() && (static_cast<unsigned char>(words.back()) & 0xC0U) == 0x80U);
+    if (!words.empty() && static_cast<unsigned char>(words.back()) >= 0xC0U) words.pop_back();
+    while (!words.empty() && words.back() == ' ') words.pop_back();
+    if (measure(canvas, size, words + "…") <= width) break;
+  }
+  return words + "…";
+}
+
+// An image premultiplied by its alpha, in floats, for sampling.
+struct Picture {
+  int width{};
+  int height{};
+  std::vector<float> rgba;
+
+  bool empty() const { return width == 0 || height == 0; }
+};
+
+// `image` made a picture, its colours multiplied by `brightness`, blurred by `blur` pixels.
+inline Picture picture(const Image& image, float brightness = 1.0F, int blur = 0) {
+  Picture result;
+  if (image.width <= 0 || image.height <= 0 ||
+      image.rgba.size() < static_cast<std::size_t>(image.width) * static_cast<std::size_t>(image.height) * 4U)
+    return result;
+  result.width = image.width;
+  result.height = image.height;
+  result.rgba.resize(static_cast<std::size_t>(image.width) * static_cast<std::size_t>(image.height) * 4U);
+  for (std::size_t i = 0; i < result.rgba.size(); i += 4U) {
+    const auto alpha = static_cast<float>(image.rgba[i + 3U]) / 255.0F;
+    for (std::size_t channel = 0; channel < 3U; ++channel)
+      result.rgba[i + channel] = static_cast<float>(image.rgba[i + channel]) / 255.0F * alpha * brightness;
+    result.rgba[i + 3U] = alpha;
+  }
+  // Box blur, across then down, a few times over (close to a Gaussian).
+  for (int pass = 0; pass < (blur > 0 ? 3 : 0); ++pass)
+    for (int direction = 0; direction < 2; ++direction) {
+      const auto source = result.rgba;
+      const int length = direction == 0 ? result.width : result.height;
+      const int lines = direction == 0 ? result.height : result.width;
+      for (int line = 0; line < lines; ++line)
+        for (int at = 0; at < length; ++at) {
+          std::array<float, 4> sum{};
+          for (int k = -blur; k <= blur; ++k) {
+            const int i = std::clamp(at + k, 0, length - 1);
+            const auto index = static_cast<std::size_t>(direction == 0 ? line * result.width + i : i * result.width + line) * 4U;
+            for (std::size_t channel = 0; channel < 4U; ++channel) sum[channel] += source[index + channel];
+          }
+          const auto index = static_cast<std::size_t>(direction == 0 ? line * result.width + at : at * result.width + line) * 4U;
+          for (std::size_t channel = 0; channel < 4U; ++channel)
+            result.rgba[index + channel] = sum[channel] / static_cast<float>(2 * blur + 1);
+        }
+    }
+  return result;
+}
+
+// The texels a sample at `at` (in texels) takes, and how much of each: Catmull-Rom, widened by
+// `scale` (texels a pixel) when shrinking, so a picture drawn smaller than it is doesn't shimmer.
+struct Taps {
+  int first{};
+  std::vector<float> weights;
+};
+inline Taps taps(float at, float scale) {
+  const auto width = std::max(scale, 1.0F);
+  Taps result{static_cast<int>(std::floor(at - 2.0F * width)) + 1, {}};
+  float total = 0.0F;
+  for (int texel = result.first; static_cast<float>(texel) < at + 2.0F * width; ++texel) {
+    const auto d = std::abs(static_cast<float>(texel) - at) / width;
+    const auto weight = d < 1.0F ? (1.5F * d - 2.5F) * d * d + 1.0F : ((-0.5F * d + 2.5F) * d - 4.0F) * d + 2.0F;
+    result.weights.push_back(weight);
+    total += weight;
+  }
+  for (auto& weight : result.weights) weight /= total;
+  return result;
+}
+
+// Draws `source` into the pixel box [left, right) x [top, bottom) (which may run off the
+// canvas), smoothly scaled, over what's there.
+inline void draw_picture(Canvas& canvas, const Picture& source, float left, float top, float right, float bottom,
+                         float opacity = 1.0F) {
+  if (source.empty() || right <= left || bottom <= top) return;
+  const auto scale_x = static_cast<float>(source.width) / (right - left);
+  const auto scale_y = static_cast<float>(source.height) / (bottom - top);
+  const int x0 = std::max(static_cast<int>(std::floor(left)), 0), x1 = std::min(static_cast<int>(std::ceil(right)), canvas.width);
+  const int y0 = std::max(static_cast<int>(std::floor(top)), 0), y1 = std::min(static_cast<int>(std::ceil(bottom)), canvas.height);
+  const auto texel = [&](int column, int row, std::size_t channel) {
+    column = std::clamp(column, 0, source.width - 1);
+    row = std::clamp(row, 0, source.height - 1);
+    return source.rgba[(static_cast<std::size_t>(row) * static_cast<std::size_t>(source.width) + static_cast<std::size_t>(column)) * 4U + channel];
+  };
+  std::vector<Taps> columns;
+  for (int column = x0; column < x1; ++column)
+    columns.push_back(taps((static_cast<float>(column) + 0.5F - left) * scale_x - 0.5F, scale_x));
+  for (int row = y0; row < y1; ++row) {
+    const auto across = taps((static_cast<float>(row) + 0.5F - top) * scale_y - 0.5F, scale_y);
+    for (int column = x0; column < x1; ++column) {
+      const auto& down = columns[static_cast<std::size_t>(column - x0)];
+      std::array<float, 4> sum{};
+      for (std::size_t j = 0; j < across.weights.size(); ++j)
+        for (std::size_t i = 0; i < down.weights.size(); ++i) {
+          const auto weight = down.weights[i] * across.weights[j];
+          for (std::size_t channel = 0; channel < 4U; ++channel)
+            sum[channel] += weight * texel(down.first + static_cast<int>(i), across.first + static_cast<int>(j), channel);
+        }
+      const auto alpha = std::clamp(sum[3] * opacity, 0.0F, 1.0F);
+      if (alpha <= 0.0F) continue;
+      auto* pixel = canvas.at(column, row);
+      for (std::size_t channel = 0; channel < 3U; ++channel) {
+        const auto colour = std::clamp(sum[channel] * opacity, 0.0F, 1.0F) * 255.0F;
+        pixel[channel] = static_cast<std::uint8_t>(std::lround(colour + static_cast<float>(pixel[channel]) * (1.0F - alpha)));
+      }
+      pixel[3] = static_cast<std::uint8_t>(std::lround(alpha * 255.0F + static_cast<float>(pixel[3]) * (1.0F - alpha)));
+    }
+  }
+}
+
+// Draws `source` covering the whole canvas (cropping what doesn't fit its shape).
+inline void cover(Canvas& canvas, const Picture& source) {
+  if (source.empty()) return;
+  const auto scale = std::max(static_cast<float>(canvas.width) / static_cast<float>(source.width),
+                              static_cast<float>(canvas.height) / static_cast<float>(source.height));
+  const auto width = static_cast<float>(source.width) * scale, height = static_cast<float>(source.height) * scale;
+  const auto left = (static_cast<float>(canvas.width) - width) * 0.5F, top = (static_cast<float>(canvas.height) - height) * 0.5F;
+  draw_picture(canvas, source, left, top, left + width, top + height);
+}
+
+// What a press or click does.
+enum class Action { none, play, quit };
+
+// The launcher's pages and what's chosen on them.
+class Screen {
+ public:
+  Screen(const Launcher& launcher, std::vector<Choice>& choices)
+      : launcher_(launcher),
+        choices_(choices),
+        logo_(picture(launcher.logo)),
+        menu_background_(picture(launcher.background, 0.62F)),
+        page_background_(picture(launcher.background, 0.34F, 2)) {
+    for (std::size_t index = 0; index < choices_.size(); ++index) {
+      if (index == 0U || choices_[index].section != choices_[index - 1U].section)
+        if (!choices_[index].section.empty()) lines_.push_back({true, index});
+      lines_.push_back({false, index});
+    }
+  }
+
+  Canvas canvas;
+  bool dirty{true};
+
+  void resize(int width, int height) {
+    if (width == canvas.width && height == canvas.height) return;
+    canvas.resize(width, height);
+    menu_base_.clear();
+    page_base_.clear();
+    dirty = true;
+  }
+
+  void draw() {
+    hits_.clear();
+    if (page_ == Page::menu) {
+      if (menu_base_.empty()) menu_base_ = draw_menu_base();
+      canvas.pixels = menu_base_;
+      draw_menu();
+    } else {
+      if (page_base_.empty()) page_base_ = draw_page_base();
+      canvas.pixels = page_base_;
+      if (page_ == Page::settings)
+        draw_settings();
+      else
+        draw_controls();
+    }
+    dirty = false;
+  }
+
+  // Up, down, left, right (dx, dy), confirm or back, from the keyboard or a pad.
+  Action move(int dx, int dy) {
+    dirty = true;
+    switch (page_) {
+      case Page::menu:
+        if (dy != 0) item_ = (item_ + (dy > 0 ? 1 : menu_items - 1)) % menu_items;
+        break;
+      case Page::settings:
+        if (choices_.empty()) break;
+        if (dy != 0) choice_ = (choice_ + (dy > 0 ? 1U : choices_.size() - 1U)) % choices_.size();
+        if (dx != 0) step(choice_, dx);
+        keep_in_view_ = true;
+        break;
+      case Page::controls:
+        break;
+    }
+    return Action::none;
+  }
+
+  Action confirm() {
+    dirty = true;
+    switch (page_) {
+      case Page::menu:
+        return activate(item_);
+      case Page::settings:
+        if (choice_ < choices_.size()) step(choice_, 1);
+        return Action::none;
+      case Page::controls:
+        page_ = Page::menu;
+        return Action::none;
+    }
+    return Action::none;
+  }
+
+  Action back() {
+    dirty = true;
+    if (page_ == Page::menu)
+      item_ = quit_item;
+    else
+      page_ = Page::menu;
+    return Action::none;
+  }
+
+  void wheel(int amount) {
+    if (page_ != Page::settings) return;
+    scroll_ -= static_cast<float>(amount) * 40.0F;
+    keep_in_view_ = false;
+    dirty = true;
+  }
+
+  // The pointer at a pixel of the canvas, and whether it clicked: hovering chooses a menu item or
+  // a setting, and a click does what's under it (the most particular thing: an option of a row).
+  Action pointer(float x, float y, bool click) {
+    const auto gx = (x - canvas.left) / canvas.scale, gy = (y - canvas.top) / canvas.scale;
+    const Hit* under = nullptr;
+    for (const auto& hit : hits_) {
+      if (gx < hit.left || gx >= hit.right || gy < hit.top || gy >= hit.bottom) continue;
+      under = &hit;
+      if (hit.kind == Hit::item && item_ != hit.index) {
+        item_ = hit.index;
+        dirty = true;
+      }
+      if (hit.kind == Hit::row && choice_ != static_cast<std::size_t>(hit.index)) {
+        choice_ = static_cast<std::size_t>(hit.index);
+        keep_in_view_ = false;
+        dirty = true;
+      }
+    }
+    if (!click || under == nullptr) return Action::none;
+    dirty = true;
+    switch (under->kind) {
+      case Hit::item: return activate(under->index);
+      case Hit::option: choices_[static_cast<std::size_t>(under->index)].selected = static_cast<std::size_t>(under->value); break;
+      case Hit::step: step(static_cast<std::size_t>(under->index), under->value); break;
+      case Hit::back: page_ = Page::menu; break;
+      case Hit::row: break;
+    }
+    return Action::none;
+  }
+
+ private:
+  enum class Page { menu, settings, controls };
+  static constexpr int menu_items = 4;  // play, settings, controls, quit
+  static constexpr int quit_item = 3;
+
+  // Somewhere the pointer can go, on the grid, and what it's for.
+  struct Hit {
+    enum Kind { item, row, option, step, back } kind;
+    float left, top, right, bottom;
+    int index;
+    int value;  // an option's number, or which way to step
+  };
+
+  // A line of the settings page: a section's heading, or a choice.
+  struct Line {
+    bool heading;
+    std::size_t choice;
+  };
+
+  // The panel the settings and controls are on.
+  static constexpr float panel_left = 70.0F, panel_top = 30.0F, panel_right = 890.0F, panel_bottom = 504.0F;
+  static constexpr float list_top = 112.0F, list_bottom = 414.0F;
+  static constexpr float row_height = 34.0F, heading_height = 30.0F;
+
+  Action activate(int item) {
+    dirty = true;
+    switch (item) {
+      case 0: return Action::play;
+      case 1: page_ = Page::settings; keep_in_view_ = true; return Action::none;
+      case 2: page_ = Page::controls; return Action::none;
+      default: return Action::quit;
+    }
+  }
+
+  void step(std::size_t index, int by) {
+    if (index >= choices_.size() || choices_[index].values.empty()) return;
+    const auto count = static_cast<int>(choices_[index].values.size());
+    choices_[index].selected = static_cast<std::size_t>((static_cast<int>(choices_[index].selected) + by % count + count) % count);
+  }
+
+  // The hint line at the bottom: symbols and what they do, in the middle or at the right.
+  struct Hint {
+    enum Icon { up_down, left_right, confirm, back, start } icon;
+    const char* label;
+  };
+  static constexpr float hint_size = 14.0F, hint_gap = 26.0F, hint_cap_size = 9.0F, margin = 16.0F;
+  float hint_icon_width(const Hint& hint) const {
+    return hint.icon == Hint::start ? measure(canvas, hint_cap_size, "START", UiFace::bold) + 10.0F : 16.0F;
+  }
+  float hints_width(const std::vector<Hint>& list) const {
+    float width = 0.0F;
+    for (const auto& hint : list) width += hint_icon_width(hint) + 6.0F + measure(canvas, hint_size, hint.label) + hint_gap;
+    return width - hint_gap;
+  }
+  void hints(const std::vector<Hint>& list, bool right = false) {
+    constexpr float baseline = 531.0F;
+    const auto width = hints_width(list);
+    float x = right ? grid_width - margin - width : (grid_width - width) * 0.5F;
+    for (const auto& hint : list) {
+      const auto icon = hint_icon_width(hint);
+      const auto cx = x + icon * 0.5F, cy = baseline - 5.0F;
+      switch (hint.icon) {
+        case Hint::up_down:
+          arrow(canvas, cx, cy - 4.0F, 3.5F, 0, -1, muted);
+          arrow(canvas, cx, cy + 4.0F, 3.5F, 0, 1, muted);
+          break;
+        case Hint::left_right:
+          arrow(canvas, cx - 4.0F, cy, 3.5F, -1, 0, muted);
+          arrow(canvas, cx + 4.0F, cy, 3.5F, 1, 0, muted);
+          break;
+        case Hint::confirm: psp_symbol(canvas, Symbol::cross, cx, cy, 13.0F); break;
+        case Hint::back: psp_symbol(canvas, Symbol::circle, cx, cy, 13.0F); break;
+        case Hint::start: {
+          // A key cap with START on it.
+          const auto left = x, right = x + icon, top = cy - 8.0F, bottom = cy + 7.0F;
+          fill(canvas, left, top, right, top + 1.0F, muted);
+          fill(canvas, left, bottom - 1.0F, right, bottom, muted);
+          fill(canvas, left, top, left + 1.0F, bottom, muted);
+          fill(canvas, right - 1.0F, top, right, bottom, muted);
+          text(canvas, left + 5.0F, cy + 3.5F, hint_cap_size, "START", muted, UiFace::bold);
+          break;
+        }
+      }
+      x += icon + 6.0F;
+      x += text(canvas, x, baseline, hint_size, hint.label, muted) + hint_gap;
+    }
+  }
+
+  // The menu's hints, at the bottom right, with the build and the disc at the bottom left.
+  const std::vector<Hint> menu_hints_{{Hint::up_down, "Choose"}, {Hint::confirm, "Select"}};
+
+  std::vector<std::uint8_t> draw_menu_base() {
+    canvas.pixels.assign(canvas.pixels.size(), 0U);
+    fill_pixels(canvas, 0, 0, canvas.width, canvas.height, rgba(14, 11, 8));
+    cover(canvas, menu_background_);
+    // Darker towards the menu on the right and along the bottom.
+    shade(canvas, true, canvas.x(430.0F), canvas.x(grid_width), rgba(10, 6, 2), 0.0F, 160.0F);
+    shade(canvas, false, canvas.y(380.0F), canvas.y(grid_height), rgba(8, 5, 2), 0.0F, 180.0F);
+    shade(canvas, false, 0.0F, canvas.y(90.0F), rgba(8, 5, 2), 90.0F, 0.0F);
+    // The logo, or the title, with the caption under it; a logo with no caption gets the room
+    // the caption would have had, and sits in the middle of it.
+    const bool captioned = !launcher_.caption.empty();
+    const float logo_left = captioned ? 50.0F : 40.0F, logo_right = captioned ? 450.0F : 470.0F;
+    const float logo_top = captioned ? 104.0F : 60.0F, logo_bottom = captioned ? 318.0F : 490.0F;
+    float caption_top = 250.0F;
+    if (!logo_.empty()) {
+      const auto fit = std::min((logo_right - logo_left) / static_cast<float>(logo_.width),
+                                (logo_bottom - logo_top) / static_cast<float>(logo_.height));
+      const auto width = static_cast<float>(logo_.width) * fit, height = static_cast<float>(logo_.height) * fit;
+      const auto left = logo_left + (logo_right - logo_left - width) * 0.5F;
+      const auto top = captioned ? logo_top : logo_top + (logo_bottom - logo_top - height) * 0.5F;
+      draw_picture(canvas, logo_, canvas.x(left), canvas.y(top), canvas.x(left + width), canvas.y(top + height));
+      caption_top = top + height;
+    } else {
+      const auto width = measure(canvas, 40.0F, launcher_.title, UiFace::display);
+      outlined_text(canvas, (logo_left + logo_right - width) * 0.5F, 220.0F, 40.0F, launcher_.title, parchment, ink, 3.0F);
+    }
+    if (captioned) {
+      const auto width = measure(canvas, 40.0F, launcher_.caption, UiFace::display);
+      const auto x = (logo_left + logo_right - width) * 0.5F, baseline = caption_top + 40.0F;
+      outlined_text(canvas, x, baseline, 40.0F, launcher_.caption, ember, ink, 7.0F);
+      outlined_text(canvas, x, baseline, 40.0F, launcher_.caption, ember, gold, 2.4F);
