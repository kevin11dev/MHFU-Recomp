+        if (WSASendTo(socket,
+            (LPWSABUF) buffers,
+            (DWORD) bufferCount,
+            &sentLength,
+            0,
+            address != NULL ? (struct sockaddr *) &sin : NULL,
+#ifdef ENET_IPV4_ONLY
+            address != NULL ? sizeof(struct sockaddr_in) : 0,
+#else
+            address != NULL ? sizeof(struct sockaddr_in6) : 0,
+#endif
+            NULL,
+            NULL) == SOCKET_ERROR
