diff --git a/refract/src/host/frame_pacer.hpp b/refract/src/host/frame_pacer.hpp
new file mode 100644
index 0000000..bbbe9df
--- /dev/null
+++ b/refract/src/host/frame_pacer.hpp
@@ -0,0 +1,63 @@
+#pragma once
+
+// Timing for smooth motion (frame interpolation): how far between the game's last two frames
+// the picture shown at a given time is.
+//
+// The game's frames come a few milliseconds early or late. Moving through each pair of frames
+// from its arrival time would judder, so each frame gets a start on an even timeline that
+// follows the game's pace (its average interval, drifting towards the arrival times), and
+// the timeline starts over at a hitch. The picture runs one game frame behind the game.
+
+#include <algorithm>
+#include <chrono>
+
+namespace refract::host {
+
+class FramePacer {
+public:
+  using Clock = std::chrono::steady_clock;
+
+  // A new frame came at `time`. Returns whether there is a pair to move between: the frame
+  // before it came a plausible game frame earlier.
+  bool frame(Clock::time_point time) {
+    const bool had_frame = has_frame_;
+    const auto interval = time - last_;
+    last_ = time;
+    has_frame_ = true;
+    if (!had_frame || interval < std::chrono::milliseconds(5) ||
+        interval > std::chrono::milliseconds(100)) {
+      interval_ = {};
+      start_ = time;
+      return false;
+    }
+    if (interval_ == Clock::duration{}) {
+      interval_ = interval;
+      start_ = time;
+      return true;
+    }
+    interval_ += (interval - interval_) / 10;
+    start_ += interval_;
+    const auto early = time - start_;
+    if (early > interval_ / 2 || -early > interval_ / 2)
+      start_ = time;
+    else
+      start_ += early / 8;
+    return true;
+  }
+
+  // How far from the previous frame to the current one the picture at `now` is, 0 to 1.
+  float progress(Clock::time_point now) const {
+    if (interval_ == Clock::duration{}) return 1.0F;
+    return std::clamp(std::chrono::duration<float>(now - start_).count() /
+                          std::chrono::duration<float>(interval_).count(),
+                      0.0F, 1.0F);
+  }
+
+private:
+  Clock::time_point last_;
+  bool has_frame_{};
+  Clock::duration interval_{};
+  Clock::time_point start_;
+};
+
+}  // namespace refract::host
diff --git a/refract/src/host/gpu.hpp b/refract/src/host/gpu.hpp
new file mode 100644
index 0000000..7cfadba
--- /dev/null
+++ b/refract/src/host/gpu.hpp
@@ -0,0 +1,139 @@
+// The graphics API under the SDL host's renderer (sdl_gles.cpp): OpenGL ES 3 (gpu_gl.cpp) or
+// Vulkan (gpu_vulkan.cpp). The renderer decides what to draw where, from the GE's geometry
+// batches; a backend only keeps images and render targets and draws into them.
+//
+// Render targets and images are stored top row first, as PSP memory is; sizes are in the
+// backend's pixels (a render target drawn at a higher resolution is that many times larger).
+#pragma once
+
+#include "host.hpp"
+
+#include <SDL.h>
+
+#include <cstdint>
+#include <memory>
+#include <string>
+#include <vector>
+
+namespace refract::host::gpu {
+
+// A texture: one of the game's, uploaded, an overlay canvas, or a render target's colour.
+class Image {
+public:
+  virtual ~Image() = default;
+};
+
+// A render target: a colour image with depth and stencil, cleared when made.
+class Target {
+public:
+  virtual ~Target() = default;
+  virtual Image& color() = 0;
+};
+
+enum class Blend : std::uint8_t {
+  zero,
+  one,
+  source_color,
+  one_minus_source_color,
+  destination_color,
+  one_minus_destination_color,
+  source_alpha,
+  one_minus_source_alpha,
+  destination_alpha,
+  one_minus_destination_alpha,
+  constant_color,
+};
+
+// What a Vulkan pipeline bakes in. Comparison functions are the GE's (0 never, 1 always, 2 equal,
+// 3 not equal, 4 less, 5 less or equal, 6 greater, 7 greater or equal), stencil operations too
+// (0 keep, 1 zero, 2 replace, 3 invert, 4 increment, 5 decrement), and blend operations (0 add,
+// 1 subtract, 2 reverse subtract, 3 min, 4 max).
+struct Pipeline {
+  std::uint8_t primitive{3};  // 0 points, 1 lines, 2 line strip, 3 triangles, 4 triangle strip
+  bool cull{};
+  bool front_clockwise{true};  // the GE's sense
+  std::uint8_t color_mask{0x0fU};  // red 1, green 2, blue 4, alpha 8
+  bool blend{};
+  Blend blend_source{Blend::one};
+  Blend blend_destination{Blend::zero};
+  std::uint8_t blend_operation{};
+  bool depth{};  // depth test (with depth_function) or depth writes
+  std::uint8_t depth_function{1};
+  bool depth_write{};
+  bool stencil{};
+  std::uint8_t stencil_function{1};
+  std::uint8_t stencil_fail{};
+  std::uint8_t stencil_depth_fail{};
+  std::uint8_t stencil_pass{};
+};
+
+// One draw into a render target: its state, the shader's values and its vertices (from the last
+// set_vertices).
+struct Draw {
+  Pipeline pipeline;
+  float blend_color[4]{};
+  std::uint8_t stencil_reference{};
+  std::uint8_t stencil_read_mask{0xffU};
+  std::uint8_t stencil_write_mask{0xffU};
+  std::int32_t scissor[4]{};  // x, y (from the top), width and height, in the target's pixels
+  // The geometry shader's values (sdl_gles.cpp describes them).
+  float texture_transform[4]{1.0F, 1.0F, 0.0F, 0.0F};
+  float target_scale[4]{1.0F, 1.0F, 0.0F, 0.0F};
+  std::uint32_t color_test[4]{};
+  std::uint32_t alpha_test[4]{};
+  std::uint32_t texture_state[4]{};
+  std::uint32_t misc[4]{};
+  Image* texture{};
+  std::uint8_t sampler{};  // min linear 8, mag linear 4, clamp t 2, clamp s 1
+  std::uint32_t first_vertex{};
+  std::uint32_t vertex_count{};
+};
+
+// A rectangle of the window, in pixels from its top left.
+struct Rect {
+  int x{};
+  int y{};
+  int width{};
+  int height{};
+};
+
+class Backend {
+public:
+  virtual ~Backend() = default;
+  virtual const char* name() const = 0;
+  virtual std::uint32_t max_texture_size() const = 0;
+
+  virtual std::unique_ptr<Image> create_image(std::uint32_t width, std::uint32_t height,
+                                              const std::uint8_t* rgba) = 0;
+  // New contents for an image, of its size.
+  virtual void update_image(Image& image, const std::uint8_t* rgba) = 0;
+  virtual std::unique_ptr<Target> create_target(std::uint32_t width, std::uint32_t height) = 0;
+  // Copies a target's colour, depth and stencil into another of the same size.
+  virtual void copy_target(Target& from, Target& to) = 0;
+
+  // The vertices of the draws that follow, until the next call.
+  virtual void set_vertices(const GeometryVertex* vertices, std::size_t count) = 0;
+  virtual void draw(Target& target, const Draw& draw) = 0;
+
+  // The window: its size in pixels, the game's picture and canvases drawn over it, and showing
+  // it. The first of these each frame clears the window.
+  virtual void drawable_size(int& width, int& height) = 0;
+  virtual void draw_picture(const Rect& where, Image& image, float u_scale, float v_scale) = 0;
+  virtual void draw_overlay(const Rect& where, Image& image) = 0;
+  // Shows the frame; with `capture`, also gives back what it shows (RGBA, top row first).
+  virtual void present(std::vector<std::uint8_t>* capture, int* width, int* height) = 0;
+};
+
+// The OpenGL ES 3 backend, drawing into the window's context.
+std::unique_ptr<Backend> create_gl_backend(SDL_Window* window);
+
+// The Vulkan backend, for a window made with SDL_WINDOW_VULKAN (or, offscreen, without a window
+// surface), keeping its compiled pipelines in `pipeline_cache` (a file; none if empty). Returns
+// null with the reason in `problem` if Vulkan isn't usable.
+std::unique_ptr<Backend> create_vulkan_backend(SDL_Window* window, const std::string& pipeline_cache,
+                                               std::string& problem);
+
+// Whether this build has the Vulkan backend.
+bool vulkan_built();
+
+}  // namespace refract::host::gpu
diff --git a/refract/src/host/gpu_gl.cpp b/refract/src/host/gpu_gl.cpp
new file mode 100644
index 0000000..6f5b6e4
--- /dev/null
+++ b/refract/src/host/gpu_gl.cpp
@@ -0,0 +1,540 @@
+// The OpenGL ES 3.0 backend (gpu.hpp).
+//
+// Render targets are stored top row first (like PSP memory and the D3D/Metal backends), so PSP
+// texture coordinates sample them directly; the vertex shader flips Y to match.
+#include "gpu.hpp"
+
+#include <GLES3/gl3.h>
+
+#include <algorithm>
+#include <array>
+#include <cstddef>
+#include <cstdio>
+#include <cstring>
+
+namespace refract::host::gpu {
+namespace {
+
+GLenum comparison_function(std::uint32_t function) {
+  constexpr GLenum functions[] = {GL_NEVER, GL_ALWAYS, GL_EQUAL,   GL_NOTEQUAL,
+                                  GL_LESS,  GL_LEQUAL, GL_GREATER, GL_GEQUAL};
+  return functions[std::min(function, 7U)];
+}
+
+GLenum stencil_operation(std::uint32_t operation) {
+  switch (operation) {
+    case 1U: return GL_ZERO;
+    case 2U: return GL_REPLACE;
+    case 3U: return GL_INVERT;
+    case 4U: return GL_INCR;
+    case 5U: return GL_DECR;
+    default: return GL_KEEP;
+  }
+}
+
+GLenum blend_factor(Blend factor) {
+  switch (factor) {
+    case Blend::zero: return GL_ZERO;
+    case Blend::one: return GL_ONE;
+    case Blend::source_color: return GL_SRC_COLOR;
+    case Blend::one_minus_source_color: return GL_ONE_MINUS_SRC_COLOR;
+    case Blend::destination_color: return GL_DST_COLOR;
+    case Blend::one_minus_destination_color: return GL_ONE_MINUS_DST_COLOR;
+    case Blend::source_alpha: return GL_SRC_ALPHA;
+    case Blend::one_minus_source_alpha: return GL_ONE_MINUS_SRC_ALPHA;
+    case Blend::destination_alpha: return GL_DST_ALPHA;
+    case Blend::one_minus_destination_alpha: return GL_ONE_MINUS_DST_ALPHA;
+    case Blend::constant_color: return GL_CONSTANT_COLOR;
+  }
+  return GL_ONE;
+}
+
+GLenum blend_operation(std::uint32_t operation) {
+  switch (operation) {
+    case 1U: return GL_FUNC_SUBTRACT;
+    case 2U: return GL_FUNC_REVERSE_SUBTRACT;
+    case 3U: return GL_MIN;
+    case 4U: return GL_MAX;
+    default: return GL_FUNC_ADD;
+  }
+}
+
+const char* geometry_vertex_source = R"GLSL(#version 300 es
+layout(location = 0) in vec4 a_position;
+layout(location = 1) in vec4 a_color;
+layout(location = 2) in vec3 a_texcoord;
+uniform vec4 u_texture_transform;
+// x, y: the draw's clip space to the target's; z: x's offset (in w), for widescreen's shift
+uniform vec3 u_target_scale;
+out vec4 v_color;
+out vec3 v_texcoord;
+void main() {
+  vec4 position = a_position;
+  position.x = a_position.x * u_target_scale.x + a_position.w * u_target_scale.z;
+  position.y = a_position.y * u_target_scale.y + a_position.w * (1.0 - u_target_scale.y);
+  // Render targets are stored top row first, and the GE's depth range is [0, w].
+  position.y = -position.y;
+  position.z = position.z * 2.0 - position.w;
+  gl_Position = position;
+  v_color = a_color;
+  v_texcoord = a_texcoord;
+  v_texcoord.xy = a_texcoord.xy * u_texture_transform.xy + u_texture_transform.zw * a_texcoord.z;
+}
+)GLSL";
+
+const char* geometry_fragment_source = R"GLSL(#version 300 es
+precision highp float;
+precision highp int;
+in vec4 v_color;
+in vec3 v_texcoord;
+uniform sampler2D u_texture;
+// x: color test, y: color function, z: color reference, w: color mask
+uniform uvec4 u_color_test;
+// x: alpha test, y: alpha function, z: alpha reference, w: alpha mask
+uniform uvec4 u_alpha_test;
+// x: texture function, y: texture alpha used, z: color doubling, w: environment color
+uniform uvec4 u_texture_state;
+// x: stencil alpha operation, y: stencil reference, z: has texture
+uniform uvec4 u_misc;
+out vec4 o_color;
+
+bool psp_compare(uint value, uint reference, uint function) {
+  if (function == 0u) return false;
+  if (function == 1u) return true;
+  if (function == 2u) return value == reference;
+  if (function == 3u) return value != reference;
+  if (function == 4u) return value < reference;
+  if (function == 5u) return value <= reference;
+  if (function == 6u) return value > reference;
+  return value >= reference;
+}
+
+void main() {
+  vec4 color = v_color;
+  if (u_misc.z != 0u) {
+    float q = v_texcoord.z >= 0.0 ? max(v_texcoord.z, 0.000001) : min(v_texcoord.z, -0.000001);
+    vec4 texture_color = texture(u_texture, v_texcoord.xy / q);
+    bool use_alpha = u_texture_state.y != 0u;
+    float alpha = use_alpha ? texture_color.a * color.a : color.a;
+    uint function = u_texture_state.x & 7u;
+    if (function == 1u) {
+      color = vec4(mix(color.rgb, texture_color.rgb, use_alpha ? texture_color.a : 1.0), color.a);
+    } else if (function == 2u) {
+      uint e = u_texture_state.w;
+      vec3 environment = vec3(float(e & 0xffu), float((e >> 8) & 0xffu), float((e >> 16) & 0xffu)) / 255.0;
+      color = vec4(mix(color.rgb, environment, texture_color.rgb), alpha);
+    } else if (function == 3u) {
+      color = vec4(texture_color.rgb, use_alpha ? texture_color.a : color.a);
+    } else if (function == 4u) {
+      color = vec4(texture_color.rgb + color.rgb, alpha);
+    } else {
+      color = vec4(texture_color.rgb * color.rgb, alpha);
+    }
+    if (u_texture_state.z != 0u) color.rgb *= 2.0;
+  }
+  uvec3 rgb = uvec3(round(clamp(color.rgb, 0.0, 1.0) * 255.0));
+  uint packed_rgb = rgb.r | (rgb.g << 8) | (rgb.b << 16);
+  uint masked_rgb = packed_rgb & u_color_test.w & 0x00ffffffu;
+  uint masked_reference = u_color_test.z & u_color_test.w & 0x00ffffffu;
+  bool color_passes = u_color_test.y == 1u ||
+                      (u_color_test.y == 2u && masked_rgb == masked_reference) ||
+                      (u_color_test.y == 3u && masked_rgb != masked_reference);
+  if (u_color_test.x != 0u && !color_passes) discard;
+  uint alpha_value = uint(round(clamp(color.a, 0.0, 1.0) * 255.0)) & u_alpha_test.w;
+  if (u_alpha_test.x != 0u &&
+      !psp_compare(alpha_value, u_alpha_test.z & u_alpha_test.w, u_alpha_test.y))
+    discard;
+  if (u_misc.x == 1u) color.a = 0.0;
+  else if (u_misc.x == 2u) color.a = float(u_misc.y) / 255.0;
+  o_color = color;
+}
+)GLSL";
+
+const char* display_vertex_source = R"GLSL(#version 300 es
+uniform vec4 u_texture_transform;
+out vec2 v_uv;
+void main() {
+  const vec2 positions[3] = vec2[3](vec2(-1.0, -1.0), vec2(-1.0, 3.0), vec2(3.0, -1.0));
+  const vec2 texcoords[3] = vec2[3](vec2(0.0, 1.0), vec2(0.0, -1.0), vec2(2.0, 1.0));
+  gl_Position = vec4(positions[gl_VertexID], 0.0, 1.0);
+  v_uv = texcoords[gl_VertexID] * u_texture_transform.xy;
+}
+)GLSL";
+
+const char* display_fragment_source = R"GLSL(#version 300 es
+precision mediump float;
+in vec2 v_uv;
+uniform sampler2D u_texture;
+out vec4 o_color;
+void main() { o_color = vec4(texture(u_texture, v_uv).rgb, 1.0); }
+)GLSL";
+
+const char* overlay_fragment_source = R"GLSL(#version 300 es
+precision mediump float;
+in vec2 v_uv;
+uniform sampler2D u_texture;
+out vec4 o_color;
+void main() { o_color = texture(u_texture, v_uv); }
+)GLSL";
+
+GLuint compile_shader(GLenum type, const char* source) {
+  const auto shader = glCreateShader(type);
+  glShaderSource(shader, 1, &source, nullptr);
+  glCompileShader(shader);
+  GLint ok{};
+  glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+  if (ok == GL_FALSE) {
+    char log[2048]{};
+    glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+    std::fprintf(stderr, "refract: shader compile failed: %s\n", log);
+  }
+  return shader;
+}
+
+GLuint link_program(const char* vertex, const char* fragment) {
+  const auto program = glCreateProgram();
+  const auto vs = compile_shader(GL_VERTEX_SHADER, vertex);
+  const auto fs = compile_shader(GL_FRAGMENT_SHADER, fragment);
+  glAttachShader(program, vs);
+  glAttachShader(program, fs);
+  glLinkProgram(program);
+  GLint ok{};
+  glGetProgramiv(program, GL_LINK_STATUS, &ok);
+  if (ok == GL_FALSE) {
+    char log[2048]{};
+    glGetProgramInfoLog(program, sizeof(log), nullptr, log);
+    std::fprintf(stderr, "refract: shader link failed: %s\n", log);
+  }
+  glDeleteShader(vs);
+  glDeleteShader(fs);
+  return program;
+}
+
+class GlImage final : public Image {
+public:
+  GlImage(std::uint32_t width, std::uint32_t height, const std::uint8_t* rgba) : width(width), height(height) {
+    glGenTextures(1, &texture);
+    glBindTexture(GL_TEXTURE_2D, texture);
+    glTexImage2D(GL_TEXTURE_2D, 0, GL_RGBA8, static_cast<GLsizei>(width), static_cast<GLsizei>(height), 0,
+                 GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+  }
+  ~GlImage() override { glDeleteTextures(1, &texture); }
+  GLuint texture{};
+  std::uint32_t width{};
+  std::uint32_t height{};
+};
+
+class GlTarget final : public Target {
+public:
+  GlTarget(std::uint32_t width, std::uint32_t height) : image(width, height, nullptr) {
+    glGenRenderbuffers(1, &depth);
+    glBindRenderbuffer(GL_RENDERBUFFER, depth);
+    glRenderbufferStorage(GL_RENDERBUFFER, GL_DEPTH24_STENCIL8, static_cast<GLsizei>(width),
+                          static_cast<GLsizei>(height));
+    glGenFramebuffers(1, &framebuffer);
+    glBindFramebuffer(GL_FRAMEBUFFER, framebuffer);
+    glFramebufferTexture2D(GL_FRAMEBUFFER, GL_COLOR_ATTACHMENT0, GL_TEXTURE_2D, image.texture, 0);
+    glFramebufferRenderbuffer(GL_FRAMEBUFFER, GL_DEPTH_STENCIL_ATTACHMENT, GL_RENDERBUFFER, depth);
+    glDisable(GL_SCISSOR_TEST);
+    glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+    glDepthMask(GL_TRUE);
+    glStencilMask(0xffU);
+    glClearColor(0.0F, 0.0F, 0.0F, 0.0F);
+    glClearDepthf(1.0F);
+    glClearStencil(0);
+    glClear(GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT);
+  }
+  ~GlTarget() override {
+    glDeleteFramebuffers(1, &framebuffer);
+    glDeleteRenderbuffers(1, &depth);
+  }
+  Image& color() override { return image; }
+  GlImage image;
+  GLuint framebuffer{};
+  GLuint depth{};
+};
+
+class GlBackend final : public Backend {
+public:
+  explicit GlBackend(SDL_Window* window) : window_(window) {
+    geometry_program_ = link_program(geometry_vertex_source, geometry_fragment_source);
+    display_program_ = link_program(display_vertex_source, display_fragment_source);
+    glUseProgram(geometry_program_);
+    glUniform1i(glGetUniformLocation(geometry_program_, "u_texture"), 0);
+    texture_transform_location_ = glGetUniformLocation(geometry_program_, "u_texture_transform");
+    target_scale_location_ = glGetUniformLocation(geometry_program_, "u_target_scale");
+    color_test_location_ = glGetUniformLocation(geometry_program_, "u_color_test");
+    alpha_test_location_ = glGetUniformLocation(geometry_program_, "u_alpha_test");
+    texture_state_location_ = glGetUniformLocation(geometry_program_, "u_texture_state");
+    misc_location_ = glGetUniformLocation(geometry_program_, "u_misc");
+    glUseProgram(display_program_);
+    glUniform1i(glGetUniformLocation(display_program_, "u_texture"), 0);
+    display_transform_location_ = glGetUniformLocation(display_program_, "u_texture_transform");
+    overlay_program_ = link_program(display_vertex_source, overlay_fragment_source);
+    glUseProgram(overlay_program_);
+    glUniform1i(glGetUniformLocation(overlay_program_, "u_texture"), 0);
+    glUniform4f(glGetUniformLocation(overlay_program_, "u_texture_transform"), 1.0F, 1.0F, 0.0F, 0.0F);
+
+    glGenVertexArrays(1, &vertex_array_);
+    glGenBuffers(1, &vertex_buffer_);
+    glBindVertexArray(vertex_array_);
+    glBindBuffer(GL_ARRAY_BUFFER, vertex_buffer_);
+    constexpr auto stride = static_cast<GLsizei>(sizeof(GeometryVertex));
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 4, GL_FLOAT, GL_FALSE, stride,
+                          reinterpret_cast<const void*>(offsetof(GeometryVertex, position)));
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, stride,
+                          reinterpret_cast<const void*>(offsetof(GeometryVertex, color)));
+    glEnableVertexAttribArray(2);
+    glVertexAttribPointer(2, 3, GL_FLOAT, GL_FALSE, stride,
+                          reinterpret_cast<const void*>(offsetof(GeometryVertex, texture)));
+    glGenVertexArrays(1, &empty_vertex_array_);
+
+    glGenSamplers(static_cast<GLsizei>(samplers_.size()), samplers_.data());
+    for (std::size_t index = 0; index < samplers_.size(); ++index) {
+      const auto sampler = samplers_[index];
+      glSamplerParameteri(sampler, GL_TEXTURE_MIN_FILTER, (index & 8U) != 0U ? GL_LINEAR : GL_NEAREST);
+      glSamplerParameteri(sampler, GL_TEXTURE_MAG_FILTER, (index & 4U) != 0U ? GL_LINEAR : GL_NEAREST);
+      glSamplerParameteri(sampler, GL_TEXTURE_WRAP_T, (index & 2U) != 0U ? GL_CLAMP_TO_EDGE : GL_REPEAT);
+      glSamplerParameteri(sampler, GL_TEXTURE_WRAP_S, (index & 1U) != 0U ? GL_CLAMP_TO_EDGE : GL_REPEAT);
+    }
+    GLint maximum_size{};
+    glGetIntegerv(GL_MAX_TEXTURE_SIZE, &maximum_size);
+    max_texture_size_ = static_cast<std::uint32_t>(std::max(maximum_size, 1));
+    if (glGetError() != GL_NO_ERROR) std::fprintf(stderr, "refract: renderer setup reported a GL error\n");
+  }
+
+  const char* name() const override { return "OpenGL ES"; }
+  std::uint32_t max_texture_size() const override { return max_texture_size_; }
+
+  std::unique_ptr<Image> create_image(std::uint32_t width, std::uint32_t height,
+                                      const std::uint8_t* rgba) override {
+    return std::make_unique<GlImage>(width, height, rgba);
+  }
+
+  void update_image(Image& image, const std::uint8_t* rgba) override {
+    auto& texture = static_cast<GlImage&>(image);
+    glBindTexture(GL_TEXTURE_2D, texture.texture);
+    glTexSubImage2D(GL_TEXTURE_2D, 0, 0, 0, static_cast<GLsizei>(texture.width),
+                    static_cast<GLsizei>(texture.height), GL_RGBA, GL_UNSIGNED_BYTE, rgba);
+  }
+
+  std::unique_ptr<Target> create_target(std::uint32_t width, std::uint32_t height) override {
+    auto target = std::make_unique<GlTarget>(width, height);
+    framebuffer_ = 0U;  // its framebuffer is bound, without the viewport for drawing
+    window_drawing_ = false;
+    return target;
+  }
+
+  void copy_target(Target& from, Target& to) override {
+    auto& source = static_cast<GlTarget&>(from);
+    auto& destination = static_cast<GlTarget&>(to);
+    const auto width = static_cast<GLint>(source.image.width);
+    const auto height = static_cast<GLint>(source.image.height);
+    glDisable(GL_SCISSOR_TEST);
+    glBindFramebuffer(GL_READ_FRAMEBUFFER, source.framebuffer);
+    glBindFramebuffer(GL_DRAW_FRAMEBUFFER, destination.framebuffer);
+    glBlitFramebuffer(0, 0, width, height, 0, 0, width, height,
+                      GL_COLOR_BUFFER_BIT | GL_DEPTH_BUFFER_BIT | GL_STENCIL_BUFFER_BIT, GL_NEAREST);
+    glBindFramebuffer(GL_FRAMEBUFFER, 0U);
+    framebuffer_ = 0U;
+    window_drawing_ = false;
+  }
+
+  void set_vertices(const GeometryVertex* vertices, std::size_t count) override {
+    glBindVertexArray(vertex_array_);
+    glBindBuffer(GL_ARRAY_BUFFER, vertex_buffer_);
+    const auto bytes = static_cast<GLsizeiptr>(count * sizeof(GeometryVertex));
+    if (bytes > vertex_buffer_capacity_) vertex_buffer_capacity_ = std::max<GLsizeiptr>(bytes, 4 << 20);
+    glBufferData(GL_ARRAY_BUFFER, vertex_buffer_capacity_, nullptr, GL_STREAM_DRAW);
+    glBufferSubData(GL_ARRAY_BUFFER, 0, bytes, vertices);
+  }
+
+  void draw(Target& target_base, const Draw& draw) override {
+    auto& target = static_cast<GlTarget&>(target_base);
+    if (window_drawing_ || framebuffer_ != target.framebuffer) {
+      glBindFramebuffer(GL_FRAMEBUFFER, target.framebuffer);
+      glViewport(0, 0, static_cast<GLsizei>(target.image.width), static_cast<GLsizei>(target.image.height));
+      framebuffer_ = target.framebuffer;
+    }
+    if (window_drawing_ || program_ != geometry_program_) {
+      glUseProgram(geometry_program_);
+      glBindVertexArray(vertex_array_);
+      glActiveTexture(GL_TEXTURE0);
+      program_ = geometry_program_;
+    }
+    window_drawing_ = false;
+    glEnable(GL_SCISSOR_TEST);
+    glScissor(draw.scissor[0], draw.scissor[1], draw.scissor[2], draw.scissor[3]);
+    apply(draw);
+    glUniform4fv(texture_transform_location_, 1, draw.texture_transform);
+    glUniform3fv(target_scale_location_, 1, draw.target_scale);
+    glUniform4uiv(color_test_location_, 1, draw.color_test);
+    glUniform4uiv(alpha_test_location_, 1, draw.alpha_test);
+    glUniform4uiv(texture_state_location_, 1, draw.texture_state);
+    glUniform4uiv(misc_location_, 1, draw.misc);
+    if (draw.texture != nullptr) {
+      glBindTexture(GL_TEXTURE_2D, static_cast<GlImage*>(draw.texture)->texture);
+      glBindSampler(0, samplers_[draw.sampler & 0xfU]);
+    } else {
+      glBindTexture(GL_TEXTURE_2D, 0U);
+    }
+    constexpr GLenum modes[] = {GL_POINTS, GL_LINES, GL_LINE_STRIP, GL_TRIANGLES, GL_TRIANGLE_STRIP};
+    glDrawArrays(modes[std::min<std::uint8_t>(draw.pipeline.primitive, 4U)], static_cast<GLint>(draw.first_vertex),
+                 static_cast<GLsizei>(draw.vertex_count));
+  }
+
+  void drawable_size(int& width, int& height) override { SDL_GL_GetDrawableSize(window_, &width, &height); }
+
+  void draw_picture(const Rect& where, Image& image, float u_scale, float v_scale) override {
+    begin_window();
+    viewport(where);
+    glUseProgram(display_program_);
+    program_ = display_program_;
+    glUniform4f(display_transform_location_, u_scale, v_scale, 0.0F, 0.0F);
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, static_cast<GlImage&>(image).texture);
+    glBindSampler(0, samplers_[0xfU]);  // linear, clamped
+    glBindVertexArray(empty_vertex_array_);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindSampler(0, 0U);
+  }
+
+  void draw_overlay(const Rect& where, Image& image) override {
+    begin_window();
+    viewport(where);
+    glEnable(GL_BLEND);
+    glBlendEquation(GL_FUNC_ADD);
+    glBlendFuncSeparate(GL_SRC_ALPHA, GL_ONE_MINUS_SRC_ALPHA, GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+    glUseProgram(overlay_program_);
+    program_ = overlay_program_;
+    glActiveTexture(GL_TEXTURE0);
+    glBindTexture(GL_TEXTURE_2D, static_cast<GlImage&>(image).texture);
+    glBindSampler(0, samplers_[0xfU]);  // linear, clamped
+    glBindVertexArray(empty_vertex_array_);
+    glDrawArrays(GL_TRIANGLES, 0, 3);
+    glBindSampler(0, 0U);
+    glDisable(GL_BLEND);
+  }
+
+  void present(std::vector<std::uint8_t>* capture, int* width, int* height) override {
+    begin_window();
+    if (capture != nullptr) {
+      int w{}, h{};
+      drawable_size(w, h);
+      std::vector<std::uint8_t> pixels(static_cast<std::size_t>(w) * h * 4U);
+      glReadPixels(0, 0, w, h, GL_RGBA, GL_UNSIGNED_BYTE, pixels.data());
+      capture->resize(pixels.size());
+      const auto row = static_cast<std::size_t>(w) * 4U;
+      for (int y = 0; y < h; ++y)  // OpenGL's rows start at the bottom
+        std::memcpy(capture->data() + static_cast<std::size_t>(y) * row,
+                    pixels.data() + static_cast<std::size_t>(h - 1 - y) * row, row);
+      if (width != nullptr) *width = w;
+      if (height != nullptr) *height = h;
+    }
+    SDL_GL_SwapWindow(window_);
+    window_cleared_ = false;
+    window_drawing_ = false;
+  }
+
+private:
+  void apply(const Draw& draw) {
+    const auto& state = draw.pipeline;
+    if (state.cull) {
+      glEnable(GL_CULL_FACE);
+      glCullFace(GL_BACK);
+      // Coordinates match D3D's top-left origin, where clockwise in D3D terms is
+      // counter-clockwise in OpenGL's.
+      glFrontFace(state.front_clockwise ? GL_CCW : GL_CW);
+    } else {
+      glDisable(GL_CULL_FACE);
+    }
+    const auto mask = state.color_mask;
+    glColorMask((mask & 1U) != 0U, (mask & 2U) != 0U, (mask & 4U) != 0U, (mask & 8U) != 0U);
+    if (state.blend) {
+      glEnable(GL_BLEND);
+      glBlendFunc(blend_factor(state.blend_source), blend_factor(state.blend_destination));
+      glBlendEquation(blend_operation(state.blend_operation));
+      glBlendColor(draw.blend_color[0], draw.blend_color[1], draw.blend_color[2], draw.blend_color[3]);
+    } else {
+      glDisable(GL_BLEND);
+    }
+    if (state.depth) {
+      glEnable(GL_DEPTH_TEST);
+      glDepthFunc(comparison_function(state.depth_function));
+      glDepthMask(state.depth_write ? GL_TRUE : GL_FALSE);
+    } else {
+      glDisable(GL_DEPTH_TEST);
+      glDepthMask(GL_FALSE);
+    }
+    if (state.stencil) {
+      glEnable(GL_STENCIL_TEST);
+      glStencilFunc(comparison_function(state.stencil_function), draw.stencil_reference, draw.stencil_read_mask);
+      glStencilOp(stencil_operation(state.stencil_fail), stencil_operation(state.stencil_depth_fail),
+                  stencil_operation(state.stencil_pass));
+      glStencilMask(draw.stencil_write_mask);
+    } else {
+      glDisable(GL_STENCIL_TEST);
+    }
+  }
+
+  // The first window drawing of a frame clears it; window drawing has none of the game's state.
+  void begin_window() {
+    if (!window_drawing_) {
+      glBindFramebuffer(GL_FRAMEBUFFER, 0U);
+      framebuffer_ = 0U;
+      glBindSampler(0, 0U);
+      glDisable(GL_SCISSOR_TEST);
+      glDisable(GL_BLEND);
+      glDisable(GL_DEPTH_TEST);
+      glDisable(GL_STENCIL_TEST);
+      glDisable(GL_CULL_FACE);
+      glColorMask(GL_TRUE, GL_TRUE, GL_TRUE, GL_TRUE);
+      window_drawing_ = true;
+    }
+    if (!window_cleared_) {
+      int width{}, height{};
+      drawable_size(width, height);
+      glViewport(0, 0, width, height);
+      glClearColor(0.02F, 0.02F, 0.025F, 1.0F);
+      glClear(GL_COLOR_BUFFER_BIT);
+      window_cleared_ = true;
+    }
+  }
+
+  // A rectangle from the window's top left, in OpenGL's terms (from its bottom left).
+  void viewport(const Rect& where) {
+    int width{}, height{};
+    drawable_size(width, height);
+    glViewport(where.x, height - where.y - where.height, where.width, where.height);
+  }
+
+  SDL_Window* window_{};
+  GLuint geometry_program_{};
+  GLuint display_program_{};
+  GLuint overlay_program_{};
+  GLint texture_transform_location_{-1};
+  GLint target_scale_location_{-1};
+  GLint color_test_location_{-1};
+  GLint alpha_test_location_{-1};
+  GLint texture_state_location_{-1};
+  GLint misc_location_{-1};
+  GLint display_transform_location_{-1};
+  GLuint vertex_array_{};
+  GLuint empty_vertex_array_{};
+  GLuint vertex_buffer_{};
+  GLsizeiptr vertex_buffer_capacity_{};
+  std::array<GLuint, 16U> samplers_{};
+  std::uint32_t max_texture_size_{4096U};
+  GLuint framebuffer_{};  // bound for drawing
+  GLuint program_{};
+  bool window_drawing_{};
+  bool window_cleared_{};
+};
+
+}  // namespace
+
+std::unique_ptr<Backend> create_gl_backend(SDL_Window* window) { return std::make_unique<GlBackend>(window); }
+
+}  // namespace refract::host::gpu
