+// The launcher and display settings (refract/frontend.hpp) -----------------------
+
+namespace refract::frontend {
+namespace {
+
+#include "launcher_screen.hpp"
+
+}  // namespace
+
+void set_fps_counter(bool shown) { host::fps_counter_shown.store(shown); }
+
+void set_widescreen(bool enabled) { host::widescreen.store(enabled); }
+
+void set_graphics_api(GraphicsApi api) {
+  host::requested_graphics.store(api);
+  // Already drawing with the other: start over in a new window, if this one can.
+  if (host::window == nullptr || api == host::graphics_in_use) return;
+  if (api == GraphicsApi::vulkan && (!host::gpu::vulkan_built() || host::vulkan_unusable)) return;
+  host::close_window();
+  host::open_window_or_fall_back();
+}
+
+GraphicsApi graphics_api() { return host::graphics_in_use; }
+
+bool vulkan_built() { return host::gpu::vulkan_built(); }
+
+void set_pipeline_cache(const std::string& path) { host::pipeline_cache_path = path; }
+
+void set_frame_interpolation(std::uint32_t pictures_per_second) {
+  if (pictures_per_second != 0U) host::interpolation_rate.store(pictures_per_second);
+  host::smooth_motion.store(pictures_per_second != 0U);
+}
+
+void set_display_settings(std::uint32_t scale, int window_width, int window_height,
+                          bool fullscreen) {
+  host::initialize_frontend();
+  // REFRACT_RENDER_SCALE, if set, wins (for testing).
+  if (std::getenv("REFRACT_RENDER_SCALE") == nullptr)
+    host::render_scale.store(std::clamp<std::uint32_t>(scale, 1U, 8U));
+  if (host::window == nullptr) return;
+  SDL_SetWindowFullscreen(host::window,
+                          fullscreen ? static_cast<Uint32>(SDL_WINDOW_FULLSCREEN_DESKTOP) : 0U);
+  // REFRACT_WINDOW_SIZE (for testing) keeps the window at its size.
+  if (fullscreen || std::getenv("REFRACT_WINDOW_SIZE") != nullptr) return;
+  // Shrink to the screen if needed, keeping the shape (offscreen runs have no real screen).
+  SDL_Rect usable{};
+  if (std::strcmp(SDL_GetCurrentVideoDriver(), "offscreen") != 0 &&
+      SDL_GetDisplayUsableBounds(SDL_GetWindowDisplayIndex(host::window), &usable) == 0 &&
+      usable.w > 0 && usable.h > 0) {
+    const auto fit = std::min({1.0, static_cast<double>(usable.w) / window_width,
+                               static_cast<double>(usable.h) / window_height});
+    window_width = static_cast<int>(window_width * fit);
+    window_height = static_cast<int>(window_height * fit);
+  }
+  SDL_SetWindowSize(host::window, window_width, window_height);
+  SDL_SetWindowPosition(host::window, SDL_WINDOWPOS_CENTERED, SDL_WINDOWPOS_CENTERED);
+}
+
+Image load_image(const std::string& path) {
+  Image image;
+  int channels{};
+  auto* pixels = stbi_load(path.c_str(), &image.width, &image.height, &channels, 4);
+  if (pixels == nullptr) return {};
+  image.rgba.assign(pixels, pixels + static_cast<std::size_t>(image.width) * static_cast<std::size_t>(image.height) * 4U);
+  stbi_image_free(pixels);
+  return image;
+}
+
+bool run_launcher(const Launcher& description, std::vector<Choice>& choices) {
+  using namespace host;
+  initialize_frontend();
+  if (window == nullptr || renderer == nullptr) return true;  // nowhere to show it: just play
+  launcher::Screen screen(description, choices);
+  const auto script = parse_input_script("REFRACT_SETTINGS_SCRIPT", nullptr);
+  std::uint32_t previous_pad{~0U};
+  for (std::uint64_t frame{};; ++frame) {
+    int width{}, height{}, window_width{}, window_height{};
+    backend->drawable_size(width, height);
+    SDL_GetWindowSize(window, &window_width, &window_height);
+    screen.resize(width, height);
+    // The mouse is in window coordinates, the canvas in pixels (which differ on high-DPI screens).
+    const auto pixels_x = static_cast<float>(width) / static_cast<float>(std::max(window_width, 1));
+    const auto pixels_y = static_cast<float>(height) / static_cast<float>(std::max(window_height, 1));
+    auto action = launcher::Action::none;
+    SDL_Event event;
+    while (action == launcher::Action::none && SDL_PollEvent(&event) != 0) {
+      switch (event.type) {
+        case SDL_QUIT: return false;
+        case SDL_KEYDOWN:
+          switch (event.key.keysym.sym) {
+            case SDLK_UP: case SDLK_w: action = screen.move(0, -1); break;
+            case SDLK_DOWN: case SDLK_s: action = screen.move(0, 1); break;
+            case SDLK_LEFT: case SDLK_a: action = screen.move(-1, 0); break;
+            case SDLK_RIGHT: case SDLK_d: action = screen.move(1, 0); break;
+            case SDLK_RETURN: case SDLK_KP_ENTER: case SDLK_SPACE: case SDLK_k: action = screen.confirm(); break;
+            case SDLK_ESCAPE: case SDLK_BACKSPACE: case SDLK_l: action = screen.back(); break;
+            default: break;
+          }
+          break;
+        case SDL_MOUSEWHEEL: screen.wheel(event.wheel.y); break;
+        case SDL_MOUSEMOTION:
+          action = screen.pointer(static_cast<float>(event.motion.x) * pixels_x, static_cast<float>(event.motion.y) * pixels_y, false);
+          break;
+        case SDL_MOUSEBUTTONDOWN:
+          if (event.button.button == SDL_BUTTON_LEFT)
+            action = screen.pointer(static_cast<float>(event.button.x) * pixels_x, static_cast<float>(event.button.y) * pixels_y, true);
+          break;
+        case SDL_CONTROLLERDEVICEADDED:
+          if (game_controller == nullptr) game_controller = SDL_GameControllerOpen(event.cdevice.which);
+          break;
+        case SDL_WINDOWEVENT: screen.dirty = true; break;
+        default: break;
+      }
+    }
+    poll_controller();
+    std::uint32_t pad = controller_buttons.load(std::memory_order_relaxed);
+    for (const auto& step : script)
+      if (frame >= step.frame && frame < step.frame + step.length) pad |= step.buttons;
+    const auto pressed = pad & ~previous_pad;
+    previous_pad = pad;
+    if (action == launcher::Action::none) {
+      if ((pressed & psp_up) != 0U) action = screen.move(0, -1);
+      if ((pressed & psp_down) != 0U) action = screen.move(0, 1);
+      if ((pressed & psp_left) != 0U) action = screen.move(-1, 0);
+      if ((pressed & psp_right) != 0U) action = screen.move(1, 0);
+      if ((pressed & psp_cross) != 0U) action = screen.confirm();
+      if ((pressed & psp_circle) != 0U) action = screen.back();
+      if ((pressed & psp_start) != 0U) action = launcher::Action::play;
+    }
+    if (action != launcher::Action::none) {
+      // Buttons still held reach the game only once released.
+      suppressed_buttons.store(pad);
+      return action == launcher::Action::play;
+    }
+    const bool changed = screen.dirty;
+    if (changed) screen.draw();
+    renderer->draw(width, height);
+    renderer->draw_overlay(width, height, screen.canvas.pixels, screen.canvas.width, screen.canvas.height, changed, 0U,
+                           true);
+    present_window(frame, "settings");
+    SDL_Delay(15);
+  }
+}
+
+}  // namespace refract::frontend
