+        if (hostEntry == NULL || hostEntry->h_addrtype != AF_INET) {
+            return enet_address_set_host_ip_old(address, name);
+        }
+
+        address->host.s_addr = *(enet_uint32 *)hostEntry->h_addr_list[0];
+        address->sin6_scope_id = 0;
