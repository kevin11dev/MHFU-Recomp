diff --git a/refract/src/host/vulkan_shaders/compile.sh b/refract/src/host/vulkan_shaders/compile.sh
new file mode 100755
index 0000000..1641281
--- /dev/null
+++ b/refract/src/host/vulkan_shaders/compile.sh
@@ -0,0 +1,22 @@
+#!/bin/sh
+# Compiles the Vulkan backend's shaders to SPIR-V, into ../vulkan_shaders.hpp (committed, so
+# building needs no shader compiler). Needs glslc (the Android NDK has it, in shader-tools).
+set -eu
+cd "$(dirname "$0")"
+GLSLC=${GLSLC:-glslc}
+OUT=../vulkan_shaders.hpp
+{
+	echo "// Generated by vulkan_shaders/compile.sh from the shaders there. Do not edit."
+	echo "#pragma once"
+	echo "#include <cstdint>"
+	echo "namespace refract::host::gpu::shaders {"
+	for shader in geometry.vert geometry.frag window.vert picture.frag overlay.frag; do
+		name=$(echo "$shader" | tr . _)
+		"$GLSLC" -O --target-env=vulkan1.0 -mfmt=num -o - "$shader" > "$name.tmp"
+		echo "inline constexpr std::uint32_t $name[] = {"
+		cat "$name.tmp"
+		echo "};"
+		rm "$name.tmp"
+	done
+	echo "}  // namespace refract::host::gpu::shaders"
+} > "$OUT"
diff --git a/refract/src/host/vulkan_shaders/geometry.frag b/refract/src/host/vulkan_shaders/geometry.frag
new file mode 100644
index 0000000..2ff2808
--- /dev/null
+++ b/refract/src/host/vulkan_shaders/geometry.frag
@@ -0,0 +1,64 @@
+#version 450
+layout(location = 0) in vec4 v_color;
+layout(location = 1) in vec3 v_texcoord;
+layout(set = 0, binding = 0) uniform sampler2D u_texture;
+layout(push_constant) uniform Draw {
+  vec4 texture_transform;
+  vec4 target_scale;
+  uvec4 color_test;     // x: color test, y: color function, z: color reference, w: color mask
+  uvec4 alpha_test;     // x: alpha test, y: alpha function, z: alpha reference, w: alpha mask
+  uvec4 texture_state;  // x: texture function, y: texture alpha used, z: color doubling, w: environment color
+  uvec4 misc;           // x: stencil alpha operation, y: stencil reference, z: has texture
+} u;
+layout(location = 0) out vec4 o_color;
+
+bool psp_compare(uint value, uint reference, uint function) {
+  if (function == 0u) return false;
+  if (function == 1u) return true;
+  if (function == 2u) return value == reference;
+  if (function == 3u) return value != reference;
+  if (function == 4u) return value < reference;
+  if (function == 5u) return value <= reference;
+  if (function == 6u) return value > reference;
+  return value >= reference;
+}
+
+void main() {
+  vec4 color = v_color;
+  if (u.misc.z != 0u) {
+    float q = v_texcoord.z >= 0.0 ? max(v_texcoord.z, 0.000001) : min(v_texcoord.z, -0.000001);
+    vec4 texture_color = texture(u_texture, v_texcoord.xy / q);
+    bool use_alpha = u.texture_state.y != 0u;
+    float alpha = use_alpha ? texture_color.a * color.a : color.a;
+    uint function = u.texture_state.x & 7u;
+    if (function == 1u) {
+      color = vec4(mix(color.rgb, texture_color.rgb, use_alpha ? texture_color.a : 1.0), color.a);
+    } else if (function == 2u) {
+      uint e = u.texture_state.w;
+      vec3 environment = vec3(float(e & 0xffu), float((e >> 8) & 0xffu), float((e >> 16) & 0xffu)) / 255.0;
+      color = vec4(mix(color.rgb, environment, texture_color.rgb), alpha);
+    } else if (function == 3u) {
+      color = vec4(texture_color.rgb, use_alpha ? texture_color.a : color.a);
+    } else if (function == 4u) {
+      color = vec4(texture_color.rgb + color.rgb, alpha);
+    } else {
+      color = vec4(texture_color.rgb * color.rgb, alpha);
+    }
+    if (u.texture_state.z != 0u) color.rgb *= 2.0;
+  }
+  uvec3 rgb = uvec3(round(clamp(color.rgb, 0.0, 1.0) * 255.0));
+  uint packed_rgb = rgb.r | (rgb.g << 8) | (rgb.b << 16);
+  uint masked_rgb = packed_rgb & u.color_test.w & 0x00ffffffu;
+  uint masked_reference = u.color_test.z & u.color_test.w & 0x00ffffffu;
+  bool color_passes = u.color_test.y == 1u ||
+                      (u.color_test.y == 2u && masked_rgb == masked_reference) ||
+                      (u.color_test.y == 3u && masked_rgb != masked_reference);
+  if (u.color_test.x != 0u && !color_passes) discard;
+  uint alpha_value = uint(round(clamp(color.a, 0.0, 1.0) * 255.0)) & u.alpha_test.w;
+  if (u.alpha_test.x != 0u &&
+      !psp_compare(alpha_value, u.alpha_test.z & u.alpha_test.w, u.alpha_test.y))
+    discard;
+  if (u.misc.x == 1u) color.a = 0.0;
+  else if (u.misc.x == 2u) color.a = float(u.misc.y) / 255.0;
+  o_color = color;
+}
diff --git a/refract/src/host/vulkan_shaders/geometry.vert b/refract/src/host/vulkan_shaders/geometry.vert
new file mode 100644
index 0000000..b01b05a
--- /dev/null
+++ b/refract/src/host/vulkan_shaders/geometry.vert
@@ -0,0 +1,26 @@
+#version 450
+// The GE's geometry, as gpu_gl.cpp's shader draws it (the values are described there).
+layout(location = 0) in vec4 a_position;
+layout(location = 1) in vec4 a_color;
+layout(location = 2) in vec3 a_texcoord;
+layout(push_constant) uniform Draw {
+  vec4 texture_transform;
+  vec4 target_scale;
+  uvec4 color_test;
+  uvec4 alpha_test;
+  uvec4 texture_state;
+  uvec4 misc;
+} u;
+layout(location = 0) out vec4 v_color;
+layout(location = 1) out vec3 v_texcoord;
+void main() {
+  vec4 position = a_position;
+  position.x = a_position.x * u.target_scale.x + a_position.w * u.target_scale.z;
+  position.y = a_position.y * u.target_scale.y + a_position.w * (1.0 - u.target_scale.y);
+  // Render targets are stored top row first; Vulkan's depth range is the GE's, [0, w].
+  position.y = -position.y;
+  gl_Position = position;
+  gl_PointSize = 1.0;
+  v_color = a_color;
+  v_texcoord = vec3(a_texcoord.xy * u.texture_transform.xy + u.texture_transform.zw * a_texcoord.z, a_texcoord.z);
+}
