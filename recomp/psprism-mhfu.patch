+{
+	SceNetAdhocctlPacketBase base;
+	SceNetEtherAddr mac;
+} SceNetAdhocctlConnectBSSIDPacketS2C;
+
+// S2C Chat Packet
+typedef struct
+{
+	SceNetAdhocctlChatPacketC2S base;
