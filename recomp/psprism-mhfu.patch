diff --git a/refract/src/stubs/kernel/sceKernelCreateVTimer.cpp b/refract/src/stubs/kernel/sceKernelCreateVTimer.cpp
new file mode 100644
index 0000000..51757c6
--- /dev/null
+++ b/refract/src/stubs/kernel/sceKernelCreateVTimer.cpp
@@ -0,0 +1,108 @@
+#if !defined(__PSP__)
+std::shared_ptr<Implementation::VTimer> find_vtimer(Implementation& implementation, int uid) {
+  std::lock_guard lock(implementation.objects_mutex);
+  const auto found = implementation.vtimers.find(uid);
+  return found == implementation.vtimers.end() ? nullptr : found->second;
+}
+
+// Host thread for one virtual timer: sleeps until the timer's own clock reaches the
+// scheduled time, then runs the guest handler as handler(uid, &schedule, &actual,
+// common), with both times written as 64-bit values to a small guest buffer. The
+// handler returns the delay to its next call, or 0 to stop.
+void run_vtimer(Implementation& implementation, int uid,
+                std::shared_ptr<Implementation::VTimer> vtimer,
+                psprecomp::State callback_state) {
+  std::uint32_t clocks{};
+  {
+    std::lock_guard lock(implementation.objects_mutex);
+    clocks = implementation.allocate_heap(16U);
+  }
+  if (clocks == 0U)
+    return;
+  for (;;) {
+    std::uint32_t handler{}, common{};
+    std::uint64_t schedule{}, actual{};
+    {
+      std::unique_lock lock(vtimer->mutex);
+      for (;;) {
+        if (vtimer->cancelled ||
+            implementation.exit_requested.load(std::memory_order_relaxed))
+          return;
+        if (vtimer->running && vtimer->handler != 0U) {
+          const auto now = host::monotonic_microseconds();
+          const auto time = vtimer->time_locked(now);
+          if (time >= vtimer->schedule) {
+            actual = time;
+            break;
+          }
+          vtimer->changed.wait_for(
+              lock, std::chrono::microseconds(vtimer->schedule - time));
+        } else {
+          vtimer->changed.wait(lock);
+        }
+      }
+      handler = vtimer->handler;
+      common = vtimer->common;
+      schedule = vtimer->schedule;
+    }
+    std::uint32_t next_delay{};
+    {
+      GuestExecutionLock execution_lock(implementation);
+      if (!execution_lock.locked())
+        return;
+      auto active_state = callback_state;
+      auto* times = guest_pointer<std::uint64_t>(active_state, clocks);
+      if (times == nullptr)
+        return;
+      times[0] = schedule;
+      times[1] = actual;
+      if (!dispatch_guest_callback_arguments(
+              implementation, active_state, handler,
+              {static_cast<std::uint32_t>(uid), clocks, clocks + 8U, common,
+               0U, 0U, 0U, 0U},
+              &next_delay))
+        return;
+    }
+    std::lock_guard lock(vtimer->mutex);
+    ++vtimer->firings;
+    if (implementation.verbose && vtimer->firings <= 8U)
+      std::fprintf(stderr,
+                   "[psprism:vtimer] fire uid=%d handler=%08x schedule=%llu "
+                   "next=%u\n",
+                   uid, handler, static_cast<unsigned long long>(schedule),
+                   next_delay);
+    // Leave the handler alone if the guest replaced it from inside the callback.
+    if (vtimer->handler != handler || vtimer->schedule != schedule)
+      continue;
+    if (next_delay == 0U)
+      vtimer->handler = 0U;
+    else
+      vtimer->schedule = schedule + next_delay;
+  }
+}
+#endif
+
+void sceKernelCreateVTimer(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  auto vtimer = std::make_shared<Implementation::VTimer>();
+  if (const auto* name = guest_string(state, state.gpr[4]))
+    vtimer->name = name;
+  int uid{};
+  {
+    std::lock_guard lock(implementation.objects_mutex);
+    uid = implementation.allocate_uid();
+    implementation.vtimers.emplace(uid, vtimer);
+  }
+  vtimer->host_thread = std::jthread(
+      [&implementation, uid, vtimer, callback_state = state] {
+        run_vtimer(implementation, uid, vtimer, callback_state);
+      });
+  state.gpr[2] = static_cast<std::uint32_t>(uid);
+  if (implementation.verbose)
+    std::fprintf(stderr, "[psprism:vtimer] create uid=%d name=%s\n", uid,
+                 vtimer->name.c_str());
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
