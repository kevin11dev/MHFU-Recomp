+++ b/refract/src/stubs/font/sceFontOpen.cpp
@@ -0,0 +1,43 @@
+#include "font_state.hpp"
+
+// (library handle, font index, mode, u32* error) -> font handle
+void sceFontOpen(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  const auto library_handle = state.gpr[4];
+  const auto index = static_cast<int>(state.gpr[5]);
+  const auto error_address = state.gpr[7];
+  {
+    std::lock_guard lock(font_state::mutex);
+    const auto found = font_state::libraries.find(library_handle);
+    if (found == font_state::libraries.end()) {
+      font_state::write_error(state, error_address, font_state::error_invalid_library);
+      state.gpr[2] = 0U;
+      return;
+    }
+    if (index < 0 || index >= ::refract::font::font_count()) {
+      font_state::write_error(state, error_address, font_state::error_invalid_parameter);
+      state.gpr[2] = 0U;
+      return;
+    }
+    if (found->second.max_fonts != 0U && found->second.open_fonts >= found->second.max_fonts) {
+      font_state::write_error(state, error_address, font_state::error_too_many_open_fonts);
+      state.gpr[2] = 0U;
+      return;
+    }
+    ++found->second.open_fonts;
+  }
+  const auto handle = font_state::allocate_handle(implementation);
+  {
+    std::lock_guard lock(font_state::mutex);
+    font_state::fonts[handle] = {library_handle, index};
+  }
+  font_state::write_error(state, error_address, 0U);
+  state.gpr[2] = handle;
+  if (implementation.verbose)
+    std::fprintf(stderr, "[psprism:font] open %d (%s) as %08x\n", index,
+                 ::refract::font::font_style(index).file_name, handle);
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
