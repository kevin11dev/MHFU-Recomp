+constexpr OskWideKey osk_wide_keys[] = {{"Space", 0, 6}, {"Delete", 6, 4}, {"Done", 10, 3}};
+constexpr int osk_space = 0;
+constexpr int osk_delete = 1;
+constexpr int osk_done = 2;
