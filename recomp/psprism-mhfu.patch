+#pragma once
+
+// Host replacement for the PSP's system font library (sceLibFont). The firmware's PGF fonts
+// (jpn0, ltn0..ltn15, kr0) are stood in for by TrueType fonts rendered with stb_truetype,
+// keeping each font's family, style and size so games get comparable metrics.
+//
+// Font files are looked up in REFRACT_FONT_DIR, then next to the executable in
+// Resources/fonts, then in /usr/share/fonts/truetype/liberation.
+
+#include <cstdint>
+#include <string_view>
+#include <vector>
+
+namespace refract::font {
+
+// PSP structure layouts, written verbatim to guest memory.
+#pragma pack(push, 1)
+struct Style {
+  float h;
+  float v;
+  float h_resolution;
+  float v_resolution;
+  float weight;
+  std::uint16_t family;
+  std::uint16_t style;
+  std::uint16_t style_sub;
+  std::uint16_t language;
+  std::uint16_t region;
+  std::uint16_t country;
+  char name[64];
+  char file_name[64];
+  std::uint32_t attributes;
+  std::uint32_t expire;
+};
+
+// Metrics are 26.6 fixed point unless noted.
+struct FontInfo {
+  std::int32_t max_glyph_width_i;
+  std::int32_t max_glyph_height_i;
+  std::int32_t max_glyph_ascender_i;
+  std::int32_t max_glyph_descender_i;
+  std::int32_t max_glyph_left_x_i;
+  std::int32_t max_glyph_base_y_i;
+  std::int32_t min_glyph_center_x_i;
+  std::int32_t max_glyph_top_y_i;
+  std::int32_t max_glyph_advance_x_i;
+  std::int32_t max_glyph_advance_y_i;
+  float max_glyph_width_f;
+  float max_glyph_height_f;
+  float max_glyph_ascender_f;
+  float max_glyph_descender_f;
+  float max_glyph_left_x_f;
+  float max_glyph_base_y_f;
+  float min_glyph_center_x_f;
+  float max_glyph_top_y_f;
+  float max_glyph_advance_x_f;
+  float max_glyph_advance_y_f;
+  std::int16_t max_glyph_width;   // pixels
+  std::int16_t max_glyph_height;  // pixels
+  std::int32_t glyph_count;
+  std::int32_t shadow_map_length;
+  Style style;
+  std::uint8_t bits_per_pixel;
+  std::uint8_t padding[3];
+};
+
+struct CharInfo {
+  std::uint32_t bitmap_width;  // pixels
+  std::uint32_t bitmap_height;
+  std::int32_t bitmap_left;    // pixels from the pen position to the bitmap's left edge
+  std::int32_t bitmap_top;     // pixels from the baseline up to the bitmap's top edge
+  std::uint32_t width;
+  std::uint32_t height;
+  std::int32_t ascender;
+  std::int32_t descender;
+  std::int32_t bearing_h_x;
+  std::int32_t bearing_h_y;
+  std::int32_t bearing_v_x;
+  std::int32_t bearing_v_y;
+  std::int32_t advance_h;
+  std::int32_t advance_v;
+  std::int16_t shadow_flags;
+  std::int16_t shadow_id;
+};
+
+struct GlyphImage {
+  std::uint32_t pixel_format;  // 0: 4 bpp, 1: 4 bpp reversed nibbles, 2: 8 bpp, 3: 24, 4: 32
+  std::int32_t x_pos64;        // where the bitmap's top-left corner goes, 26.6
+  std::int32_t y_pos64;
+  std::uint16_t buffer_width;
+  std::uint16_t buffer_height;
+  std::uint16_t bytes_per_line;
+  std::uint16_t padding;
+  std::uint32_t buffer_address;
+};
+#pragma pack(pop)
+
+static_assert(sizeof(Style) == 0xA8);
+static_assert(sizeof(FontInfo) == 0x108);
+static_assert(sizeof(CharInfo) == 0x3C);
+static_assert(sizeof(GlyphImage) == 0x18);
+
+// A rendered glyph: 4-bit coverage (0-15), one byte per pixel, rows top to bottom.
+struct Glyph {
+  int width{};
+  int height{};
+  std::vector<std::uint8_t> pixels;
+};
+
+// The firmware's internal fonts, in the order sceFontOpen indexes them.
+int font_count();
+const Style& font_style(int index);
+
+// The best internal font for a requested style (sceFontFindOptimumFont), or -1.
+int find_optimum_font(const Style& requested, float library_h_resolution,
+                      float library_v_resolution);
+
+bool font_info(int index, FontInfo& info);
+
+// Metrics for a character, substituting alt_code when the font has no glyph for it.
+// Returns false when neither is available.
+bool char_info(int index, std::uint32_t code, std::uint32_t alt_code, CharInfo& info);
+
+// The glyph bitmap for a character (same substitution); null when there is none.
+const Glyph* glyph(int index, std::uint32_t code, std::uint32_t alt_code);
+
+// Text for the host's own screens (the on-screen keyboard, the launcher), drawn with Liberation
+// Sans, or for headings with Cinzel Bold (an engraved serif; Liberation Serif Bold without it).
+// Draws UTF-8 text into a top-row-first RGBA canvas with the baseline at y and returns how far
+// the pen moved, in pixels.
+enum class UiFace { regular, bold, display };
+int draw_ui_text(std::uint8_t* canvas, int canvas_width, int canvas_height, int x, int y,
+                 float pixel_height, std::string_view utf8, std::uint32_t abgr, UiFace face);
+int measure_ui_text(float pixel_height, std::string_view utf8, UiFace face);
+int draw_ui_text(std::uint8_t* canvas, int canvas_width, int canvas_height, int x, int y,
+                 float pixel_height, std::string_view utf8, std::uint32_t abgr, bool bold = false);
+int measure_ui_text(float pixel_height, std::string_view utf8, bool bold = false);
+
+}  // namespace refract::font
