@@ -0,0 +1,30 @@
+#include "font_state.hpp"
+
+// (library handle)
+void sceFontDoneLib(Implementation& implementation, psprecomp::State& state) {
+#if !defined(__PSP__)
+  const auto handle = state.gpr[4];
+  std::vector<std::uint32_t> released;
+  {
+    std::lock_guard lock(font_state::mutex);
+    if (font_state::libraries.erase(handle) == 0U) {
+      state.gpr[2] = font_state::error_invalid_library;
+      return;
+    }
+    for (auto it = font_state::fonts.begin(); it != font_state::fonts.end();) {
+      if (it->second.library == handle) {
+        released.push_back(it->first);
+        it = font_state::fonts.erase(it);
+      } else {
+        ++it;
+      }
+    }
+  }
+  released.push_back(handle);
+  for (const auto released_handle : released) font_state::free_handle(implementation, released_handle);
+  state.gpr[2] = 0U;
+#else
+  (void)implementation;
+  state.gpr[2] = unimplemented;
+#endif
+}
